+    def get_surface_array(self, replace_transparent_with_colour=None):
+        """Get a 3D array containing the surface pixel data.
+
+        Returns
+        -------
+        surface_array : numpy.ndarray
+            a 3D array containing the surface pixel data
+            using RGBA coding.
+
