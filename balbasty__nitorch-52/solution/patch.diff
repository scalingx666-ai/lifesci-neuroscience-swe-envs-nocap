+        plt.imshow(images[1].detach().cpu())
+        plt.axis('off')
+        plt.subplot(3, 3, 7)
+        plt.imshow(images[2].detach().cpu())
+        plt.axis('off')
+        plt.subplot(3, 3, 2)
+        plt.imshow(preds[0].detach().cpu())
+        plt.axis('off')
+        plt.subplot(3, 3, 5)
+        plt.imshow(preds[1].detach().cpu())
+        plt.axis('off')
+        plt.subplot(3, 3, 8)
+        plt.imshow(preds[2].detach().cpu())
+        plt.axis('off')
+        plt.subplot(3, 3, 3)
+        plt.imshow(refs[0].detach().cpu())
+        plt.axis('off')
