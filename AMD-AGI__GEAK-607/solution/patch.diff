+    _candidate(eval_dir, "h1", parity_kind="accuracy", pct_gpu_time=13.6954, isolated_speedup=1.5265,
+               e2e_delta_pct=12.79, ref_med=50.467, cand_med=56.921, e2e_throughput_tok_s=56.921,
