 from scipy.stats import zmap
 
 from . import utils
@@ -112,3 +113,109 @@ def get_mad_outliers(data, thresh=3.5):
     modified_z_score = 0.6745 * diff / med_abs_deviation
 
     return modified_z_score > thresh
