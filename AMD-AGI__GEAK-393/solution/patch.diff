diff --git a/perf_knowledge/expert_skills/skills/apply_flydsl_moe_to_vllm/flydsl_capture_precompile.py b/perf_knowledge/expert_skills/skills/apply_flydsl_moe_to_vllm/flydsl_capture_precompile.py
