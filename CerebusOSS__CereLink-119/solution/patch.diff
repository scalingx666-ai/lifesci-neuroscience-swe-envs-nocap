-    // Handle the cases where there are "NULL's" passed in
-    if (pnMode)         nMode =         *pnMode;
-    if (pdLearningRate) dLearningRate = *pdLearningRate;
-    if (pnRefChan1)     nRefChan1 =     *pnRefChan1;
-    if (pnRefChan2)     nRefChan2 =     *pnRefChan2;
