@@ -8,7 +8,9 @@
 #------------------------------------------------------------------------------
 
 import sys
+import os
 import os.path as op
+import subprocess
 from inspect import getargspec
 
 from ..ext.six import string_types, exec_
@@ -98,3 +100,16 @@ def _show_shortcuts(shortcuts, name=''):
     for name in sorted(shortcuts):
         print('{0:<40}: {1:s}'.format(name, _show_shortcut(shortcuts[name])))
     print()
+
+
+def _git_version():
+    filedir, _ = op.split(__file__)
+    try:
+        fnull = open(os.devnull, 'w')
+        version = ('-git-' + subprocess.check_output(
+                   ['git', '-C', filedir, 'describe', '--abbrev=8', '--dirty',
+                    '--always', '--tags'],
+                   stderr=fnull).strip().decode('ascii'))
+        return version
+    except (OSError, subprocess.CalledProcessError):
+        return ""
diff --git a/phy/utils/tests/test_misc.py b/phy/utils/tests/test_misc.py
new file mode 100644
index 000000000..6a4d6dda1
--- /dev/null
+++ b/phy/utils/tests/test_misc.py
@@ -0,0 +1,32 @@
+# -*- coding: utf-8 -*-
+
+"""Tests of misc utility functions."""
+
+#------------------------------------------------------------------------------
+# Imports
+#------------------------------------------------------------------------------
+
+import os
+import os.path as op
+import subprocess
+
+from .._misc import _git_version
+
+
+#------------------------------------------------------------------------------
+# Tests
+#------------------------------------------------------------------------------
+
+def test_git_version():
+    v = _git_version()
+
+    # If this test file is tracked by git, then _git_version() should succeed
+    filedir, _ = op.split(__file__)
+    try:
+        fnull = open(os.devnull, 'w')
+        subprocess.check_output(['git', '-C', filedir, 'status'],
+                                stderr=fnull)
+        assert v is not "", "git_version failed to return"
+        assert v[:6] == "-git-v", "Git version does not begin in -git-v"
+    except (OSError, subprocess.CalledProcessError):
+        assert v == ""
