+	// check if new data
+	if baseval == nil {
+		// newval will also be nil
+		basevalmod := db.initValueVersion(ctx.VersionID(), newval)
+		return basevalmod, nil, 0, nil
+	} else if ctx.VersionID() == currentmaster {
