+func (db *GBucket) sliceDataVersionPrefix(val []byte) []byte {
+	currpos := db.vsize
+	for ; currpos < int32(len(val)); currpos += db.vsize {
+		currval := dvid.VersionID(binary.LittleEndian.Uint32(val[currpos : currpos+db.vsize]))
