+// append version to supplied prefix
+func (db *GBucket) appendValueVersion(val []byte, version dvid.VersionID) []byte {
+	tempintbuffer := make([]byte, db.vsize)
+	newprefix := make([]byte, 0, len(val)+int(db.vsize))
