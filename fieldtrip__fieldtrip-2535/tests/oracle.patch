+  data.time{i} = linspace(start_time, end_time, nsamples);
+  data.trial{i} = randn(nchan,nsamples);
+end
+
+cfg = [];
+cfg.method = 'mtmfft';
+cfg.taper = 'hanning';
+cfg.foilim = [4 30];
+freq = ft_freqanalysis(cfg, data);
