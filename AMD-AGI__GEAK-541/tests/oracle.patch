+def _vllm_identity(tmp_path: Path, name: str, args: str) -> dict:
+    path = tmp_path / name
+    path.write_text(f"INFO non-default args: {{{args}}}\n", encoding="utf-8")
+    evidence, _ = rx._read_server_identity_evidence(path)
+    return evidence
