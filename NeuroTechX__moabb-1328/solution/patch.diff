+def test_metadata_has_the_device_of_each_session():
+    from moabb.datasets.compound_dataset import CompoundDataset
+
+    a, b = (
+        FakeDataset(["left_hand", "right_hand"], n_subjects=1, n_sessions=2, seed=s)
