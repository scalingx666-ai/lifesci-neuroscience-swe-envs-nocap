diff --git a/.codespellrc b/.codespellrc
new file mode 100644
index 000000000..f95ef2dc7
--- /dev/null
+++ b/.codespellrc
@@ -0,0 +1,4 @@
+[codespell]
+skip = .git,env,venv,ds*,asl*,qmr*,genetics*,fnirs*,eeg*,meg*,pet*,ieeg*,motion*,synthetic*
+builtin = clear,rare
+ignore-words-list = nd
diff --git a/.github/workflows/validation.yml b/.github/workflows/validation.yml
new file mode 100644
index 000000000..71c694e80
--- /dev/null
+++ b/.github/workflows/validation.yml
@@ -0,0 +1,20 @@
+---
+name: Validation
+
+on:
+  push:
+    branches: [master]
+  pull_request:
+    branches: [master]
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  # Check for common misspellings
+  codespell:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: codespell-project/actions-codespell@master
