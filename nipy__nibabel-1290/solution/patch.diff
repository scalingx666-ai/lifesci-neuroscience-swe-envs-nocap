-def run_mod_cmd(mod_name, pkg_path, cmd, script_dir=None, print_location=True):
-    """Run command in own process in anonymous path
-
-    Parameters
-    ----------
-    mod_name : str
-        Name of module to import - e.g. 'nibabel'
