+    x = affine.dat.dat.clone()
+    _, g = step.do_affine(x, grad=True, in_line_search=True)
+    fd = fd_grad(step.do_affine, x)
+    err = (fd - g).norm() / fd.norm()
+    assert err < 1e-4, err
