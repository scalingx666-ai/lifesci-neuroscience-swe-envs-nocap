diff --git a/src/Makefile.linux_ubuntu_26_64 b/src/Makefile.linux_ubuntu_26_64
new file mode 100644
index 0000000000..225dcf448b
--- /dev/null
+++ b/src/Makefile.linux_ubuntu_26_64
@@ -0,0 +1,168 @@
+# modern linux
+#   - works on Ubuntu 18.04 through 26.04
+#     (might also work under Fedora, needs verification)
+#     (if we want to call it linux_universal, that should match the file name)
+#   - works with either gcc or clang
+#   - works with x86-64 or ARM aarch64
+
+SYSTEM_NAME = linux_ubuntu_26_64
+SYSTEM_TYPE = Linux
+
+# CPROF = -pg -g
+USE_ZLIB = -DHAVE_ZLIB
+LZLIB    = -lz
+USE_GIFTI = -DHAVE_GIFTI
+LGIFTI    = -lexpat  #/usr/lib64/libexpat.
+
+# -----------------------------------
+#  # use shared libriaries (libmri.so)?
+MRI_SHARED = $(SYSTEM_TYPE)
+
+# use linux-style R_io.so building
+R_IO_MODIFY_LINUX = yes
+
+# -----------------------------------
+# default to having these off
+# D_USE_ACML = -DUSE_ACML
+# I_USE_ACML = -I/opt/acml3.1.0/gnu64/include
+# L_USE_ACML = /opt/acml3.1.0/gnu64/lib/libacml.a
+
+CCDEBS = -DAFNI_DEBUG -DIMSEQ_DEBUG -DDISPLAY_DEBUG -DTHD_DEBUG
+CEXTRA = -Wcomment -Wformat -DUSE_TRACING -DHAVE_XDBE -D_GNU_SOURCE \
+         -DREPLACE_XT $(CPROF)
+
+#use gcc by default unless user demands clang or gcc not found
+CEXE = /usr/bin/gcc
+CLANGEXE = /usr/bin/clang
+#run "useClang=1 make all" to give clang precedence over gcc
+ifeq "$(useClang)" "1"
+CEXE=$(CLANGEXE)
+endif
+#use clang if gcc does not exist
+ifeq (,$(wildcard $(CEXE)))
+CEXE=$(CLANGEXE)
+endif
+
+CC     = $(CEXE) -O2 -fPIC -DREAD_WRITE_64 -DLINUX2 $(CEXTRA)
+CCVOL  = $(CEXE) -O2 -fPIC -DREAD_WRITE_64 -DLINUX2 $(CEXTRA)
+CCFAST = $(CEXE) -O2 -fPIC -DREAD_WRITE_64 -DLINUX2 $(CEXTRA)
+CCOLD  = $(CC)
+
+
+# The following line includes compiling for the SSE operations.
+# However, I found that it actually makes things worse in some test code.
+# Your mileage may vary.
+
+# CCFAST = $(CEXE) -O3 -march=i686 -ffast-math -mmmx -msse -mfpmath=sse -DLINUX2 $(CEXTRA)
+
+OMPFLAG = -fopenmp -DUSE_OMP  # for OpenMP
+CCMIN  = $(CEXE) -fPIC $(CPROF)
+CCD    = $(CC) $(CCDEBS)
+IFLAGS = -I. -I/usr/X11R6/include $(I_USE_ACML)
+#-I/usr/src/linux-headers-3.0.0-17/include/linux -I/usr/src/linux-headers-3.0.0-17/include $(I_USE_ACML)
+LFLAGS = -L. -L/usr/X11R6/lib64 $(L_USE_ACML)
+
+# maybe 
+
+CCSVD  = $(CEXE) -O0 -fPIC
+
+PLUGIN_SUFFIX = so
+PLUGIN_LFLAGS = -shared -fPIC
+PLUGIN_CC     = $(CC)
+# PLFLAGS       = -rdynamic -L. -L/usr/X11R6/lib
+PLFLAGS       = -rdynamic -L. -L/usr/X11R6/lib64
+
+# possibly modify from above
+ifdef MRI_SHARED
+LFLAGS  = -L. -L/usr/lib64 $(L_USE_ACML) -Wl,-rpath='$$ORIGIN'
+PLFLAGS = -rdynamic $(LFLAGS)
+endif
+
+SHOWOFF = -DSHOWOFF=$(SYSTEM_NAME)
+
+AR     = /usr/bin/ar
+RANLIB = /usr/bin/ranlib
+TAR    = /bin/tar
+MKDIR  = /bin/mkdir
+GZIP   = /bin/gzip
+LD     = $(CEXE) $(CPROF)
+
+RM = /bin/rm -f
+MV = /bin/mv -f
+CP = /bin/cp -f
+
+LINT = /usr/bin/lint -a -b -u -v -x $(IFLAGS) $(CCDEFS)
+
+INSTALLDIR = ./$(SYSTEM_NAME)
+LIBDIR = $(INSTALLDIR)
+
+# INSTALL_PREREQ = suma
+INSTALL_PREREQ = suma_gts
+# uncomment if the Gnu Scientific Library is installed (libgsl, libgslcblas)
+ GSLPROGS = balloon
+EXPROGS = $(GSLPROGS)   # 3dQwarp gifti_tool $(GSLPROGS)
+
+# ---------------------------------------------------------------------------
+# include libraries with versions that change often
+# (official build only, so non-exact systems do not require specific files)
+
+ifeq ($(AFNI_WHOMADEIT), official)
+
+# copy libgsl.so.XX locally, similarly for cblas (trust symbolic links)
+EXTRA_INSTALL_FILES = /usr/lib/x86_64-linux-gnu/libgsl.so.27          \
+                      /usr/lib/x86_64-linux-gnu/libgslcblas.so.0
+
+EXTRA_INSTALL_COMMANDS = ( cd $(INSTALLDIR) ;                         \
+                           chmod 755 libgsl.so.27 ;                   \
+                           chmod 755 libgslcblas.so.0 ;               \
+                         )
+endif
+# end official build
+
+# ---------------------------------------------------------------------------
+# for dynamic linking
+
+# LLIBS  = -lmri -lf2c -lXm -lXpm -lXext -lXmu -lXt -lX11 $(LZLIB) $(LGIFTI) -lm  -ldl -lc
+
+# for static linking to Motif, dynamic to all else
+
+# separate X11 libs from non-X11 ones
+LLIBS  = -lmri -lf2c $(LZLIB) $(LGIFTI) -lm  -ldl -lc
+LLIBS_X11 = -lmri -lf2c -lXm -lXpm -lXext -lXmu -lXt -lSM -lICE -lX11 \
+            $(LZLIB) $(LGIFTI) -lm  -ldl -lc
+
+#LLIBS  = -lmri -lf2c /usr/X11R6/lib64/libXm.a -lXpm -lXext -lXmu -lXt -lSM -lICE -lX11 $(LZLIB) $(LGIFTI) -lm  -ldl -lc
+
+# for static linking, as far as possible
+
+# LLIBS = -lmri -lf2c -ldl               \
+#         /usr/X11R6/lib/libXm.a   \
+#        /usr/X11R6/lib/libXpm.a  \
+#        /usr/X11R6/lib/libXext.a \
+#        /usr/X11R6/lib/libXmu.a  \
+#        /usr/X11R6/lib/libXt.a   \
+#        /usr/X11R6/lib/libSM.a   \
+#        /usr/X11R6/lib/libICE.a  \
+#        /usr/X11R6/lib/libX11.a  \
+#        /usr/lib/libm.a          \
+#        /usr/lib/libc.a
+
+# vvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvvv
+# For suma (NO STATIC LINKING OF GL libs)
+SUMA_GLIB_VER = -2.0
+SUMA_INCLUDE_PATH = -I/usr/X11R6/include -I./ -I../ -I../niml/ -Igts/src -I/usr/include/glib-1.2 -I/usr/include/glib-2.0 -I/usr/lib64/glib/include -I/usr/lib64/ -I/usr/lib/x86_64-linux-gnu/glib-2.0/include -I/usr/lib/aarch64-linux-gnu/glib-2.0/include
+SUMA_LINK_PATH = -L/usr/lib64 -L/usr/X11R6/lib64 -L../
+#use -lGLw if you have libGLw.a or libGLw.so* or 
+#  -lMesaGLw if you have Mesa's version (libMesaGLw*) of libGLw
+#
+SUMA_LINK_LIB = -lGLw -lGLU -lGL $(LLIBS_X11)
+#SUMA_LINK_LIB = /usr/X11R6/lib64/libXm.a -lGLw -lGLU -lGL -lXmu -lXt -lXext -lX11 $(LZLIB) $(LGIFTI) -lm 
+SUMA_MAKEFILE_NAME = SUMA_Makefile
+SUMA_BIN_ARCHIVE = SUMA_Linux.tar
+SUMA_MDEFS = 
+# ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
+
+###############################################################
+
+MAKE = make
+include Makefile.INCLUDE
diff --git a/src/other_builds/OS_notes.linux_ubuntu_26_64_a_admin.txt b/src/other_builds/OS_notes.linux_ubuntu_26_64_a_admin.txt
new file mode 100644
index 0000000000..7e95808b6b
--- /dev/null
+++ b/src/other_builds/OS_notes.linux_ubuntu_26_64_a_admin.txt
@@ -0,0 +1,104 @@
+# Quick build setup script 1/3.
+# - Should match with 'steps_linux_ubuntu26.rst' for setting up a user system.
+# - This setup script is to create a build system, which can also apply to users.
+#
+# From bash shell:
+#   sudo bash OS_notes.linux_ubuntu_26_64_a_admin.txt 2>&1 | tee o.ubu_26_a.txt
+# From tcsh shell:
+#   sudo bash OS_notes.linux_ubuntu_26_64_a_admin.txt |& tee o.ubu_26_a.txt
+
+echo "++ Start preparing; exit on failure"
+set -euo pipefail
+
+echo "++ Add universe repo"
+sudo add-apt-repository universe -y
+
+echo "++ Prepare to install apt version of firefox"
+# this is preferable to the snap-installed version
+# --------------------------------------------------
+
+# Add the Mozilla Team PPA
+sudo add-apt-repository ppa:mozillateam/ppa -y
+
+# Prioritize Firefox PPA over Snap
+echo 'Package: *
+Pin: release o=LP-PPA-mozillateam
+Pin-Priority: 1001' | sudo tee /etc/apt/preferences.d/mozilla-firefox
+
+# Prevent Re-installation of Snap
+echo 'Unattended-Upgrade::Allowed-Origins:: "LP-PPA-mozillateam:${distro_codename}";' | sudo tee /etc/apt/apt.conf.d/51unattended-upgrades-firefox
+
+# --------------------------------------------------
+
+echo "++ Update package manager info"
+sudo apt-get update
+
+
+echo "++ Prepare to install more modern version of R"
+# ... which is 4.6, at time of writing
+# --------------------------------------------------
+
+# following instructions for adding trusted public key info, from here:
+# https://cran.r-project.org/bin/linux/ubuntu/#user
+
+# update indices
+sudo apt update -qq
+
+# install two helper packages we need
+sudo apt install -y --no-install-recommends software-properties-common dirmngr
+
+# add the signing key (by Michael Rutter) for these repos
+# To verify key, run gpg --show-keys /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc 
+# Fingerprint: E298A3A825C0D65DFD57CBB651716619E084DAB9
+wget -qO- https://cloud.r-project.org/bin/linux/ubuntu/marutter_pubkey.asc \
+   | sudo tee -a /etc/apt/trusted.gpg.d/cran_ubuntu_key.asc
+
+# add the repo from CRAN -- lsb_release adjusts to 'noble' or 'jammy'
+# or ... as needed
+sudo add-apt-repository -y   \
+  "deb https://cloud.r-project.org/bin/linux/ubuntu $(lsb_release -cs)-cran40/"
+
+# --------------------------------------------------
+
+echo "++ Update package manager info again"
+sudo apt-get update
+
+# this apt-get cmd is separate from the large one, below, bc
+# firefox has special considerations (from PPA, above)
+echo "++ Install Mozilla Firefox"
+sudo apt-get install -y --allow-downgrades firefox
+
+echo "++ Install other main dependencies"
+sudo apt-get install -y tcsh xfonts-base libssl-dev       \
+                        python-is-python3                 \
+                        python3-matplotlib python3-numpy  \
+                        python3-flask python3-flask-cors  \
+                        python3-pil                       \
+                        gsl-bin netpbm gnome-tweaks       \
+                        libjpeg62 xvfb xterm vim curl     \
+                        gedit evince eog                  \
+                        libglu1-mesa-dev libglw1-mesa-dev \
+                        libxm4 build-essential            \
+                        libcurl4-openssl-dev libxml2-dev  \
+                        libgfortran-14-dev libgomp1       \
+                        gnome-terminal nautilus           \
+                        xfonts-100dpi                     \
+                        r-base-dev cmake bc git           \
+                        libxext-dev libxmu-dev libxpm-dev \
+                        libgsl-dev libglut-dev libxi-dev  \
+                        libglib2.0-dev 
+      
+
+echo "++ Get more dependencies for R-package brms"
+sudo apt-get install -y libgdal-dev libopenblas-dev       \
+                        libnode-dev libudunits2-dev
+
+
+echo "++ Fix GLwDrawA.h"
+cd /usr/include/GL
+sudo mv GLwDrawA.h GLwDrawA.h.orig
+sed 's/^GLAPI WidgetClass/extern GLAPI WidgetClass/' GLwDrawA.h.orig > /tmp/GLwDrawA.h
+sudo mv /tmp/GLwDrawA.h GLwDrawA.h
+
+
+echo "++ Done with sudo-required part"
diff --git a/src/other_builds/OS_notes.linux_ubuntu_26_64_b_user.tcsh b/src/other_builds/OS_notes.linux_ubuntu_26_64_b_user.tcsh
new file mode 100644
index 0000000000..626f419e48
--- /dev/null
+++ b/src/other_builds/OS_notes.linux_ubuntu_26_64_b_user.tcsh
@@ -0,0 +1,77 @@
+# Quick build setup script 2/3. Should match with 'steps_linux_ubuntu26.rst'
+# From bash shell:
+#   tcsh OS_notes.linux_ubuntu_26_64_b_user.tcsh 2>&1 | tee o.ubu_26_b.txt
+# From tcsh shell:
+#   tcsh OS_notes.linux_ubuntu_26_64_b_user.tcsh |& tee o.ubu_26_b.txt
+
+# ------------------------------------------------------------------------
+
+echo "++ Get AFNI binaries"
+
+cd
+curl -O https://afni.nimh.nih.gov/pub/dist/bin/misc/@update.afni.binaries
+tcsh @update.afni.binaries -package linux_ubuntu_24_64 -do_extras
+
+# put the new binaries into the PATH
+if ( -f ~/.tcshrc ) then
+   source ~/.tcshrc
+else if ( -f ~/.cshrc ) then
+   source ~/.cshrc
+else
+   echo "-- no .cshrc file, assuming afni is already in PATH"
+endif
+rehash
+
+# ------------------------------------------------------------------------
+
+echo "++ Download Bootcamp data, **if** it doesn't appear to exist already"
+
+if ( 1 && ! -d ~/AFNI_data6 && ! -d ~/AFNI_demos ) then
+   echo "++ No ~/AFNI_data6 and ~/AFNI_demo dirs already,"
+   echo "   so will download+install the Bootcamp data CD.tgz"
+
+   curl -O https://afni.nimh.nih.gov/pub/dist/edu/data/CD.tgz
+   tar xvzf CD.tgz
+   cd CD
+   tcsh s2.cp.files . ~
+   cd ..
+else
+   echo "+* WARN: Finding ~/AFNI_data6 and ~/AFNI_demo dirs already,"
+   echo "         so I will *not* download+install the Bootcamp data CD.tgz"
+endif
+
+# ------------------------------------------------------------------------
+
+echo "++ Prepare to install R and its packages (will take a while)"
+
+set rver = `R --version | head -n 1 | cut -d ' ' -f 3`
+if ( $status ) then
+   echo "** failed to set R version: R --version"
+   exit 1
+endif
+
+echo "R ver : $rver"
+echo ""
+
+if ( ! $?R_LIBS ) then
+   echo "++ setting R_LIBS=$HOME/sw/R-$rver"
+   # start by setting R_LIBS in shell
+   setenv R_LIBS $HOME/sw/R-$rver
+
+   echo "export R_LIBS=$R_LIBS" >> ~/.bashrc
+   echo "setenv R_LIBS $HOME/sw/R-$rver" >> ~/.cshrc
+else
+   echo "-- already have R_LIBS=$R_LIBS"
+endif
+
+echo "++ building R libraries: rPkgsInstall -pkgs ALL"
+\mkdir -p $R_LIBS
+rPkgsInstall -pkgs ALL |& tee out.rPkgsInstall.txt
+
+# ------------------------------------------------------------------------
+
+set asc  = ~/o.afni_system_check.txt
+echo "++ Run system check, saving to: ${asc}"
+afni_system_check.py -check_all > ${asc}
+
+echo "++ Done with 2nd part of install"
diff --git a/src/other_builds/OS_notes.linux_ubuntu_26_64_c_nice.tcsh b/src/other_builds/OS_notes.linux_ubuntu_26_64_c_nice.tcsh
new file mode 100644
index 0000000000..9b37b84092
--- /dev/null
+++ b/src/other_builds/OS_notes.linux_ubuntu_26_64_c_nice.tcsh
@@ -0,0 +1,30 @@
+# Quick build setup script 3/3.  Should match with 'steps_linux_ubuntu26.rst'
+# From bash shell:
+#   tcsh OS_notes.linux_ubuntu_26_64_c_nice.tcsh 2>&1 | tee o.ubu_26_c.txt
+# From tcsh shell:
+#   tcsh OS_notes.linux_ubuntu_26_64_c_nice.tcsh |& tee o.ubu_26_c.txt
+
+
+echo "++ Set up tab autocompletion for tcsh"
+
+echo ""                            >> ~/.cshrc
+echo 'set filec'                   >> ~/.cshrc
+echo 'set autolist'                >> ~/.cshrc
+echo 'set nobeep'                  >> ~/.cshrc
+
+
+echo "++ Make t/csh aliases for colorful listing of files/dirs: ls, ll, ltr"
+
+echo 'alias ls ls --color=auto'    >> ~/.cshrc
+echo 'alias ll ls --color -l'      >> ~/.cshrc
+echo 'alias ltr ls --color -ltr'   >> ~/.cshrc
+
+
+echo "++ Make bash aliases for colorful listing of files/dirs: ls, ll, ltr"
+
+echo ""                            >> ~/.bashrc
+echo 'alias ls="ls --color"'       >> ~/.bashrc
+echo 'alias ll="ls --color -l"'    >> ~/.bashrc
+echo 'alias ltr="ls --color -ltr"' >> ~/.bashrc
+
+echo "++ Done with niceifying terminal part"
