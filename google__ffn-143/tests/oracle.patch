   return segmentation
 
 
@@ -164,16 +168,43 @@ def clean_up_and_count(seg: np.ndarray,
   cc_to_orig, cc_to_count = None, None
 
   if compute_id_map or compute_counts:
-    unique_result_tuple = np.unique(  # pyrefly: ignore[no-matching-overload]
