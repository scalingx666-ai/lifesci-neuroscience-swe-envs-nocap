+/** `a, b, c …+97 more` — enough to chase one, never enough to flood. */
+function sample(ids: string[], total: number): string {
+  const more = total - ids.length;
+  return more > 0 ? `${ids.join(", ")} …+${more} more` : ids.join(", ");
