+  r = 0
+  for i in range(ITERATION):
+    r += jax.grad(sum_op(bm.jitconn.mv_prob_homo_taichi), argnums=0)(
+      vector, homo_data, conn_prob, seed, shape=shape, transpose=transpose, outdim_parallel=outdim_parallel
+    )
+  return r
