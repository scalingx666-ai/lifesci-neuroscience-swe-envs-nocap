+class JsonMapping(private val keys: Array[Long], private val values: Array[Long]) {
+  def apply(segmentId: Long): Long = {
+    val index = java.util.Arrays.binarySearch(keys, segmentId)
+    if (index >= 0) values(index) else segmentId
+  }
