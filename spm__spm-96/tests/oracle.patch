 %-Condition arguments
 %--------------------------------------------------------------------------
 if nargin == 0, Action='Setup'; else Action=varargin{1}; end
- 
+
+% Check for MATLAB version and set uipanel property
+%--------------------------------------------------------------------------
+matlabVer = spm_check_version('matlab');
+parts = strsplit(matlabVer, '.');
+
+majorVer = str2double(parts{1});
+minorVer = str2double(parts{2});
+
+if majorVer < 9 || (majorVer == 9 && minorVer < 14)
+    % For R2022b (9.13.*) and older, use ShadowColor
+    bcProp = 'ShadowColor';
+else
+    % For R2023a (9.14.*) and newer, use BorderColor
+    bcProp = 'BorderColor';
+end
+
  
 %==========================================================================
