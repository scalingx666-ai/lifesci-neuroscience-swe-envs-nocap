+    "class vae_visualizer(nn.Module):\n",
+    "    def __init__(self, enc, dec):\n",
+    "        super().__init__()\n",
+    "        self.enc = enc\n",
+    "        self.dec = dec\n",
+    "\n",
+    "    def forward(self, x):\n",
+    "        x = self.enc(x).mean\n",
+    "        x = self.dec(x)\n",
+    "        return x\n",
+    "\n",
+    "X = torch.rand(128, 1, 90)\n",
+    "X = X.to(DEVICE)\n",
+    "model = vae_visualizer(enc, dec)\n",
+    "model_history = tl.log_forward_pass(model, X,\n",
+    "                                    layers_to_save='all',\n",
+    "                                    vis_opt='rolled')"
+   ]
