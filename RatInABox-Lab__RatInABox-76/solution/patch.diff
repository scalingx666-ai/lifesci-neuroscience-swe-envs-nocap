+   "source": [
+    "Env = Environment()\n",
+    "object_pos = Env.sample_positions(n=2,)\n",
+    "for pos in object_pos:\n",
+    "    Env.add_object(pos)\n",
+    "\n",
+    "Ag = Agent(Env)\n",
+    "\n",
+    "\n",
+    "# Create a OVC for each object type\n",
+    "\n",
+    "FoV_OVCs = [FieldOfViewOVCs(Ag, params={\n",
