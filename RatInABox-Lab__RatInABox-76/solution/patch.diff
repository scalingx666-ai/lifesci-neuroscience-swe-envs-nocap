+    "                            }) for i in range(2)]\n",
+    "\n",
+    "\n",
+    "# Run the simulation for 30 seceonds\n",
+    "\n",
+    "for i in range(int(30/Ag.dt)):\n",
+    "    Ag.update()\n",
+    "    for fov_ovc in FoV_OVCs:\n",
+    "        fov_ovc.update()"
