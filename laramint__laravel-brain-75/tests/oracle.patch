+        fn ($e) => $e->calleeFqcn.'::'.$e->calleeMethod.' ('.$e->type.')',
+        $edges,
+    );
+
+    $sibling = $describe($tracer->traceMethod('App\Events\Sibling', 'go', $psr4, $root));
+    $imported = $describe($tracer->traceMethod('App\Outside\Importer', 'go', $psr4, $root));
+
