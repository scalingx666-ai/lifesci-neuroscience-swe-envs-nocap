+    id_vox = id_wim.get_data()
+    mask = bin_vox.astype(bool)
+    assert_equal(id_vox[~mask], -1)
+    ids = nroi.get_id()
+    assert_equal(np.unique(id_vox), [-1] + list(ids))
+    # Test activation
