-    def _argrepr_params(self):
-        """Params and defaults to be listed in this object's ``repr``."""
-
-        # get default values from __init__'s
-        arg_order = []
-        arg_defaults = []
-        for t in type(self).__mro__[:-1]:
-            spec = getfullargspec(t.__init__)
