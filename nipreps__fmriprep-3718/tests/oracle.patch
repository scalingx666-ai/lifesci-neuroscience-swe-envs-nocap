diff --git a/docs/usage.rst b/docs/usage.rst
index 57512d296..a4121d817 100644
--- a/docs/usage.rst
+++ b/docs/usage.rst
@@ -236,6 +236,48 @@ registered to the shared anatomical image; with ``sessionwise``, each session is
 processed independently against its own anatomical reference. ``--bold-coreg-level
 subject`` is incompatible with ``--subject-anatomical-reference sessionwise``.
 
+Selecting runs for the BOLD template
+~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+By default, all runs of a group contribute to the template: with two runs, the
+first run's reference defines the template space, and with three or more runs an
+unbiased template is constructed.
+Expert users may instead select which runs build the template, by adding a
+``boldref_template`` column to the
+`scans file <https://bids-specification.readthedocs.io/en/stable/modality-agnostic-files/data-summary-files.html#scans-file>`__
+of each session::
+
+    filename	boldref_template
+    func/sub-01_ses-01_task-rest_run-1_bold.nii.gz	target
+    func/sub-01_ses-01_task-rest_run-2_bold.nii.gz	include
+    func/sub-01_ses-01_task-rest_run-3_bold.nii.gz	n/a
+
+The following values are accepted:
+
+``target``
+    The run's reference defines the template space, and is averaged into the template.
+``include``
+    The run's reference is averaged into the template.
+``n/a``
+    The run is registered to the template, but does not contribute to it.
+    Runs not listed in the scans file are treated as ``n/a``.
+
+A single ``target`` (or a single ``include``) fixes the template space to that run,
+and every other run is registered to it.
+Selecting two or more ``include`` runs without a ``target`` constructs an unbiased
+template from those runs, to which the remaining runs are then registered.
+At most one ``target`` may be selected per template.
+
+The scans file at the same location in a ``--derivatives`` dataset overrides the one
+of the input BIDS dataset, so runs can be selected without modifying the raw data.
+As with other derivatives, a later dataset takes precedence over an earlier one, and
+the first scans file found with a ``boldref_template`` column is used as a whole.
+Because previously computed templates are reused, the first pass of *fMRIPrep*
+(producing the run references to select from) should be run with
+``--bold-coreg-level run``.
+
+The template's JSON sidecar records the runs that defined the template space
+(``TemplateSpace``) and those averaged into the template image (``TemplateData``).
+
 Troubleshooting
 ---------------
 Logs and crashfiles are output into the
diff --git a/fmriprep/utils/bids.py b/fmriprep/utils/bids.py
index 0b46fb8ae..ce9cdd99e 100644
--- a/fmriprep/utils/bids.py
+++ b/fmriprep/utils/bids.py
@@ -149,6 +149,110 @@ def bold_template_zooms(
     return (target,) * 3
 
 
+TEMPLATE_SELECTION_COLUMN = 'boldref_template'
+TEMPLATE_SELECTION_VALUES = ('target', 'include', 'n/a')
+
+
+def read_selection(scans_file: Path) -> dict[str, str] | None:
+    """Read the ``boldref_template`` column of a scans file, keyed by ``filename``.
+
+    Returns ``None`` if the scans file is missing or has no ``boldref_template`` column.
+    """
+    import pandas as pd
+
+    if not scans_file.is_file():
+        return
+    scans = pd.read_csv(scans_file, sep='\t', dtype=str, keep_default_na=False)
+    if TEMPLATE_SELECTION_COLUMN not in scans.columns:
+        return
+    if 'filename' not in scans.columns:
+        raise ValueError(
+            f'{scans_file} has a "{TEMPLATE_SELECTION_COLUMN}" column but no "filename".'
+        )
+
+    selection = {}
+    for filename, value in zip(scans['filename'], scans[TEMPLATE_SELECTION_COLUMN], strict=True):
+        value = value.strip() or 'n/a'
+        if value not in TEMPLATE_SELECTION_VALUES:
+            raise ValueError(
+                f'{scans_file}: invalid {TEMPLATE_SELECTION_COLUMN} value "{value}" for '
+                f'{filename} (expected one of {", ".join(TEMPLATE_SELECTION_VALUES)}).'
+            )
+        selection[filename] = value
+    return selection
+
+
+def _find_selection(scans_dir: Path, roots: list[Path]) -> dict[str, str]:
+    scans_file = scans_dir / f'{"_".join(scans_dir.parts)}_scans.tsv'
+    for root in roots:
+        if (selection := read_selection(root / scans_file)) is not None:
+            config.loggers.utils.info(f'Reading BOLD template selection from {root / scans_file}')
+            return selection
+    return {}
+
+
+def collect_selection(
+    bold_files: list[str],
+    bids_dir: Path | str,
+    derivatives: list[Path | str],
+) -> list[str]:
+    """Read the BOLD template selection of each run from ``*_scans.tsv`` files.
+
+    For each subject/session, the scans file of the last derivatives dataset with a
+    ``boldref_template`` column at the same relative path is used, otherwise that of the
+    raw dataset.
+
+    Returns
+    -------
+    list of str
+        One of ``target``, ``include`` or ``n/a`` per run.
+    """
+    bids_dir = Path(bids_dir)
+    roots = [*(Path(deriv_dir) for deriv_dir in reversed(derivatives)), bids_dir]
+    bold_paths = [Path(bold_file).relative_to(bids_dir) for bold_file in bold_files]
+    selections = {
+        scans_dir: _find_selection(scans_dir, roots)
+        for scans_dir in {bold_path.parent.parent for bold_path in bold_paths}
+    }
+
+    labels = []
+    for bold_path in bold_paths:
+        scans_dir = bold_path.parent.parent
+        filename = bold_path.relative_to(scans_dir).as_posix()
+        labels.append(selections[scans_dir].get(filename, 'n/a'))
+    return labels
+
+
+def resolve_selection(labels: list[str]) -> tuple[int | None, list[bool]]:
+    """Resolve per-run selection labels into the BOLD template construction strategy.
+
+    Returns
+    -------
+    reference : int or None
+        Index of the run defining the template space, or ``None`` for an unbiased template.
+    template_runs : list of bool
+        List of runs to be averaged into the template image.
+    """
+    n_runs = len(labels)
+    targets = [i for i, label in enumerate(labels) if label == 'target']
+    includes = [i for i, label in enumerate(labels) if label == 'include']
+
+    if len(targets) > 1:
+        raise RuntimeError(
+            'Only one BOLD run may be selected as the "target" of a BOLD template; '
+            f'found {len(targets)}.'
+        )
+    if not targets and not includes:
+        return (0 if n_runs <= 2 else None), [True] * n_runs
+
+    template_runs = [label in ('target', 'include') for label in labels]
+    if targets:
+        return targets[0], template_runs
+    if len(includes) == 1:
+        return includes[0], template_runs
+    return None, template_runs
+
+
