+function c=my_struct2cell(s)
+% Convert structure cell array with name-value pairs
+
+fn=fieldnames(s);
+nf=length(fn);
+c=cell(1,2*nf);
+c(1:2:end)=fn;
+for n=1:nf
+    c{2*n}=s.(fn{n});
