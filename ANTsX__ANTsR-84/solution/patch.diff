+load.ANTsR <- function(filename=file.path('.','.ANTsRsession'),
+                       env=as.environment(1)) {
+  
+  funimgL = function(x,fold=filename) {
+    if (length(x) > 1) return(x)
+    if (substr(x,1,8) == 'ANTSload') {
+      fn = file.path(fold, substr(x,9,nchar(x)) )
+      x = antsImageRead(fn)
+    }
+    return(x)
