diff --git a/docs/javascripts/mathjax.js b/docs/javascripts/mathjax.js
new file mode 100644
index 00000000..e5758190
--- /dev/null
+++ b/docs/javascripts/mathjax.js
@@ -0,0 +1,22 @@
+// MathJax configuration for LaTeX rendering (used with pymdownx.arithmatex,
+// generic mode). Inline math: $...$ or \(...\); display math: $$...$$ or \[...\].
+window.MathJax = {
+  tex: {
+    inlineMath: [["\\(", "\\)"]],
+    displayMath: [["\\[", "\\]"]],
+    processEscapes: true,
+    processEnvironments: true
+  },
+  options: {
+    ignoreHtmlClass: ".*|",
+    processHtmlClass: "arithmatex"
+  }
+};
+
+// Re-typeset on every page load, including instant navigation.
+document$.subscribe(() => {
+  MathJax.startup.output.clearCache()
+  MathJax.typesetClear()
+  MathJax.texReset()
+  MathJax.typesetPromise()
+})
