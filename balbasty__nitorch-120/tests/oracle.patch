+def test_mad_estimated_lam_zero_residuals():
+    """MAD's lam is the Laplace maximum-likelihood estimate 1/mean|r|^2,
+    which stays finite when some residuals are exactly zero"""
+    for zeros in (0, 4):
+        mov, fix = make_noisy(zeros=zeros)
+        loss = MAD(lam=None)
