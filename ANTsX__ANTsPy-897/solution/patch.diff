+      - uses: actions/checkout@v6
         with:
           submodules: true
 
-      - uses: actions/setup-python@v5
+      - uses: actions/setup-python@v6
         name: Install Python host for cibuildwheel
         with:
           python-version: ${{ matrix.python }}
@@ -123,7 +123,11 @@ jobs:
         uses: ilammy/msvc-dev-cmd@v1
 
       - name: Install cibuildwheel
-        run: python -m pip install cibuildwheel==2.19.2 setuptools toml
+        shell: bash
+        run: |
+          python -m pip install cibuildwheel==2.23.3 setuptools toml
+          # pin virtualenv version - this depends on cibuildwheel version
+          echo "VIRTUALENV_VERSION=20.30.0" >> $GITHUB_ENV
 
       - name: Get package name and version (Linux / Mac)
         if: ${{ ! startsWith(matrix.os, 'windows-') }}
@@ -145,6 +149,24 @@ jobs:
           macos_version=$(sw_vers -productVersion | awk -F '.' '{print $1".0"}')
           echo "MACOSX_DEPLOYMENT_TARGET=${macos_version}" >> $GITHUB_ENV
 
+      - name: Set cibuildwheel cache path (macOS / Windows)
+        if: ${{ startsWith(matrix.os, 'macos-') || startsWith(matrix.os, 'windows-') }}
+        shell: bash
+        run: |
+          set -euxo pipefail
+          cache_dir="${RUNNER_TEMP}/cibw-cache"
+          mkdir -p "${cache_dir}"
+          echo "CIBW_CACHE_PATH=${cache_dir}" >> "${GITHUB_ENV}"
+
+      - name: Download virtualenv.pyz for cibuildwheel to cache dir (macOS / Windows)
+        if: ${{ startsWith(matrix.os, 'macos-') || startsWith(matrix.os, 'windows-') }}
+        shell: bash
+        run: |
+          set -euxo pipefail
+          curl -L --retry 5 --retry-delay 5 \
+            -o "${CIBW_CACHE_PATH}/virtualenv-${VIRTUALENV_VERSION}.pyz" \
+            https://bootstrap.pypa.io/virtualenv/${{ matrix.python }}/virtualenv.pyz
+
       - name: Build wheels
         env:
           CIBW_MANYLINUX_X86_64_IMAGE: manylinux2014
