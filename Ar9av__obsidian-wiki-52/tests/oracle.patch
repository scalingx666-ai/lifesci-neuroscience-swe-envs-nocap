+    fi
     link_path="$target_dir/$skill_name"
+    if [ "$mode" = "relative" ]; then
+      link_target="${rel_prefix}.skills/$skill_name"
+    else
+      link_target="${skill%/}"
+    fi
     if [ -L "$link_path" ]; then
       rm "$link_path"
     elif [ -d "$link_path" ]; then
