+      exit 1
+    fi
+    # One ../ per path component in $rel; e.g. .claude/skills → 2 components → ../../
+    local slashes="${rel//[^\/]/}"
+    local depth=$(( ${#slashes} + 1 )) i
+    for (( i=0; i<depth; i++ )); do rel_prefix="../$rel_prefix"; done
