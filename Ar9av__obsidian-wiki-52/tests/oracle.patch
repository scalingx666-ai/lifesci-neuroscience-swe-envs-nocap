   local target_dir="$1"
   local label="$2"
+  local mode="${3:-absolute}"
+  shift 3 || shift $#
+  local subset=("$@")  # empty = install all
+
+  case "$mode" in
+    relative|absolute) ;;
+    *) echo "install_skills: bad mode '$mode' (want relative|absolute)" >&2; exit 1 ;;
+  esac
