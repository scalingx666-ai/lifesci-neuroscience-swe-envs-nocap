+            description=(
+                "BCI-FIT: longitudinal Matrix and RSVP P300 calibration "
+                "recordings of five participants with ALS using a "
+                "customized non-implantable communication BCI."
+            ),
+            investigators=[
+                "Betts Peters",
+                "Daniel Klee",
+                "Michelle Kinsella",
+                "Yonah Hendin",
+                "Tab Memmott",
+                "Matthew Lawhead",
+                "Srikar Ananthoju",
+                "Basak Celik",
