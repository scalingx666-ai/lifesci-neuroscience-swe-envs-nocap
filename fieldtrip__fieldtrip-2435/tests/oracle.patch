 %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
 function [new] = apply(transform, old)
 
+if iscell(old)
+  % recurse into the cell-array
+  new = cell(size(old));
+  for i=1:numel(old)
+    if ~isempty(old{i})
+      new{i} = apply(transform, old{i});
+    end
+  end
+  return;
+end
+
 [m, n] = size(old);
 if m~=3 && n==3
