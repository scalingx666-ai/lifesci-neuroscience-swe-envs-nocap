diff --git a/obsidian_wiki/links.py b/obsidian_wiki/links.py
index 6af0963f..10d1f36d 100644
--- a/obsidian_wiki/links.py
+++ b/obsidian_wiki/links.py
@@ -19,7 +19,14 @@
 
 #: Obsidian does not treat a `[[link]]` inside inline code or a fenced block as
 #: a link, so neither does anything that walks the link graph.
-_FENCE_RE = re.compile(r"^(```|~~~).*?^\1[^\n]*$", re.MULTILINE | re.DOTALL)
+# Fences follow CommonMark: up to 3 spaces of indent, no backtick in the info
+# string of a backtick fence, closed by a bare fence of the same character at
+# least as long, or by the end of the page.
+_FENCE_RE = re.compile(
+    r"^ {0,3}(?P<fence>(?P<ch>[`~])(?P=ch){2,})(?!(?P=ch))(?:(?<=~)[^\n]*|[^`\n]*)$"
+    r"(?:\n(?:.*?\n)?? {0,3}(?P=fence)(?P=ch)*[ \t\r]*$|.*\Z)",
+    re.MULTILINE | re.DOTALL,
+)
 # Single-line on purpose: a stray backtick must not swallow the rest of a page.
 _INLINE_CODE_RE = re.compile(r"(`+)(?!`).+?(?<!`)\1(?!`)")
 
diff --git a/tests/test_links.py b/tests/test_links.py
index 38ace910..cbc9cf50 100644
--- a/tests/test_links.py
+++ b/tests/test_links.py
@@ -66,6 +66,22 @@ def test_strip_code_drops_fences_and_inline_spans_only() -> None:
     assert "[[b]]" not in kept and "[[c]]" not in kept
 
 
+def test_strip_code_fences_follow_commonmark() -> None:
+    cases = [
+        "````md\n```js\n[[a]]\n```\n````\n[[b]]",  # longer fence wraps a shorter one
+        "```\nx\n```python\n[[a]]\n```\n[[b]]",  # an info string does not close
+        "~~~\n```\n[[a]]\n~~~\n[[b]]",  # only the same character closes
+        "```\n[[a]]\n``` x\n```\n[[b]]",  # trailing text does not close
+        "```\r\n[[a]]\r\n```\r\n[[b]]",
+        "   ```\n[[a]]\n```\n[[b]]",  # up to 3 spaces of indent
+        "```\n```\n[[b]]\n```\n[[a]]",  # empty block, then one to the end
+        "``` a`b\n[[b]]",  # a backtick in the info string: not a fence
+    ]
+    for text in cases:
+        kept = strip_code(text)
+        assert "[[a]]" not in kept and "[[b]]" in kept, text
+
+
 # -- every consumer ---------------------------------------------------------
 
 
