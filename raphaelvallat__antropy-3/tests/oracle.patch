+@np.vectorize
+def _xlog2x(x):
+    """Returns x log2 x if x is positive, 0 if x == 0, and np.nan
+    otherwise. This handles the case when the power spectrum density
+    takes any zero value.
+    """
+    return 0.0 if x == 0 else x * np.log2(x)
