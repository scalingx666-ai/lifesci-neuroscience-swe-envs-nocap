index 00000000000..6e2157d4ac0
--- /dev/null
+++ b/Base/QTGUI/Testing/Cxx/qSlicerSaveDataDialogSaveOutcomeTest.cxx
@@ -0,0 +1,250 @@
+/*==============================================================================
