+            run=$(curl -fsS --max-time 30 --retry 3 "https://circleci.com/api/v2/insights/gh/$GH_REPO/workflows/$name?branch=$branch" | jq -c '.items[0] // empty')
+            if [[ "$name" == monthly ]]; then
+              # a manually triggered linkcheck stands in for the monthly one if newer
+              manual=$(curl -fsS --max-time 30 --retry 3 "https://circleci.com/api/v2/insights/gh/$GH_REPO/workflows/linkcheck?branch=$branch" | jq -c '.items[0] // empty')
