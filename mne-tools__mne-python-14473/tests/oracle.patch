index 1ac8e04562e..8fc23f7411c 100644
--- a/.circleci/config.yml
+++ b/.circleci/config.yml
@@ -5,12 +5,22 @@
 # Tagging a commit with the following overrides these behaviors:
 # - [circle front] will run the front page examples and perform test-doc
 # - [circle full] will run all examples and perform test-doc
+# - [circle lite] will build the JupyterLite site ([circle front] does too)
 # - [circle linkcheck] will run our linkcheck job
 # - [circle deploy] on a main or maint/* commit will try to immediately build
 #   and deploy docs rather than waiting for the nightly build
+#
+# Triggering a pipeline on main with the `linkcheck` parameter set to true runs
+# only the linkcheck, and counts toward the scheduled-failure issue like the
+# monthly run does.
 
 version: 2.1
 
+parameters:
+  linkcheck:
+    type: boolean
+    default: false
+
 _check_skip: &check_skip
   name: Check-skip
   command: |
@@ -631,6 +641,7 @@ jobs:
 
 workflows:
   default:
+    unless: << pipeline.parameters.linkcheck >>
     jobs:
       - build_docs:
           name: build_docs
@@ -686,6 +697,13 @@ workflows:
               only:
                 - /maint\/.*/
 
+  linkcheck:
+    when: << pipeline.parameters.linkcheck >>
+    jobs:
+      - linkcheck:
+          name: linkcheck_manual
+          scheduled: "true"
+
   monthly:
     jobs:
       - linkcheck:
