         self._polydata.GetPointData().SetActiveNormals("Normals")
+        if triangles is not None:
+            self._triangles = triangles
+            self._polydata.faces = np.hstack(
+                [np.full((len(triangles), 1), 3), triangles]
+            ).ravel()
 
