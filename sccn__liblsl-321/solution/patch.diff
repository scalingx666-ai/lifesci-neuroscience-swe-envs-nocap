@@ -246,3 +247,39 @@ TEST_CASE("outlet teardown with a stalled consumer", "[network]") {
 	// give the detached transfer thread time to drop its queue
 	std::this_thread::sleep_for(std::chrono::milliseconds(200));
 }
+
+TEST_CASE("tcpserver_sync_requires_protocol_110", "[network][sync]") {
+	asio::io_context ctx(1);
+
+	auto info =
+		std::make_shared<lsl::stream_info_impl>("TCP_sync", "", 3, 4., cft_float32, "abc123");
+	tcp_server_wrapper tcp_server(info, true);
+	tcp::endpoint ep(address_v4(0x7f000001), info->v4data_port());
+	int responses = 0;
+
+	// Make sure it is rejected so the client does not receive data it cannot parse.
+	send_request(ctx, ep, asio::buffer("LSL:streamfeed\n10 0\r\n"),
+		with_read_callback("legacy feed", [&](const std::string &res) {
+			++responses;
+			REQUIRE(res.empty());
+		}));
+
+	send_request(ctx, ep,
+		asio::buffer("LSL:streamfeed/110 \nMax-Buffer-Length: 10\r\nHas-IEEE754-Floats: 0\r\n\r\n"),
+		with_read_callback("downgraded feed", [&](const std::string &res) {
+			++responses;
+			REQUIRE(res.substr(0, 11) == "LSL/110 505");
+		}));
+
+	// Make sure the 1.00 handshake is still served when the buffer is 0.
+	send_request(ctx, ep, asio::buffer("LSL:streamfeed\n0 0\r\n"),
+		with_read_callback("streamfeed 100", [&](const std::string &res) {
+			++responses;
+			check_streamfeed_100_response(res);
+		}));
+
+	tcp_server.run();
+	// A feed the server wrongly keeps open never reaches EOF; fail instead of waiting forever.
+	ctx.run_for(std::chrono::seconds(5));
+	REQUIRE(responses == 3);
+}
