-
-
-def _is_delimiter_row(line: str) -> bool:
-    """Is this the `---|---` line that separates a table's header from its body?"""
-    stripped = line.strip()
-    if "|" not in stripped or set(stripped) - set("|-: "):
-        return False
-    cells = [cell.strip() for cell in stripped.strip("|").split("|")]
