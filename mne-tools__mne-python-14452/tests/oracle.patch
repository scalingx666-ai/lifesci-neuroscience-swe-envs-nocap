diff --git a/doc/changes/dev/14452.bugfix.rst b/doc/changes/dev/14452.bugfix.rst
new file mode 100644
index 00000000000..a2c2e56a1ea
--- /dev/null
+++ b/doc/changes/dev/14452.bugfix.rst
@@ -0,0 +1 @@
+Fix :meth:`mne.preprocessing.ICA.get_sources` assigning the wrong channel names and types to ``add_channels`` that are not in the order of the instance's channels, by `Stefan Appelhoff`_.
diff --git a/mne/preprocessing/ica.py b/mne/preprocessing/ica.py
index e79d9392e65..b0235f454ca 100644
--- a/mne/preprocessing/ica.py
+++ b/mne/preprocessing/ica.py
@@ -1500,7 +1500,7 @@ def _export_info(self, info, container, add_channels):
             ch_names += add_channels
             # re-append additionally picked ch_info
             ch_info += [
-                k for k in container.info["chs"] if k["ch_name"] in add_channels
+                container.info["chs"][container.ch_names.index(k)] for k in add_channels
             ]
         with info._unlock(update_redundant=True, check_after=True):
             info["chs"] = ch_info
diff --git a/mne/preprocessing/tests/test_ica.py b/mne/preprocessing/tests/test_ica.py
