+            plt.figure()
+            ax = plt.subplot(1, 1, 1)
+
+        ax.imshow(contrast, interpolation='Nearest', 
+                  aspect='auto',
+                  cmap=cmap)
+        ax.set_label('conditions')
+        ax.set_yticks(range(contrast.shape[0]))
+        ax.set_yticklabels([])
+
+        if self.names is not None:
+            ax.set_xticks(range(len(self.names)))
