+        const q = queries[qi];
+        const matched = q.qTokens.length > 0 ? pageMatchCountWithPath(page, at.row, masks[at.page][qi], scratch, q.qTokens, pathTokens) : 0;
+        const boost = q.qTokens.length > 0 ? 0.1 * (matched / q.qTokens.length) : 0;
