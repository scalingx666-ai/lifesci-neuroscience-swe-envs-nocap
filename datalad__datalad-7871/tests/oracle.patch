+++ b/datalad/tests/test_jobs.py
@@ -0,0 +1,131 @@
+# ex: set sts=4 ts=4 sw=4 et:
+# ## ### ### ### ### ### ### ### ### ### ### ### ### ### ### ### ### ### ### ##
+#
