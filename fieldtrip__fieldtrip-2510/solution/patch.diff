+tlock3.dimord = 'rpt_chan_time';
+tlock3.trial = randn(8, 2, 5);
+
+cfg = [];
+cfg.memory = 'high';
+thigh = ft_appendtimelock(cfg, tlock1, tlock2, tlock3);
+cfg.memory = 'low';
+tlow = ft_appendtimelock(cfg, tlock1, tlock2, tlock3);
+assert(isequal(thigh.trial, tlow.trial));
