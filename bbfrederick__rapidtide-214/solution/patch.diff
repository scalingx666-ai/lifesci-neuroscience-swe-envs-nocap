diff --git a/.github/workflows/docker-build-latest.yml b/.github/workflows/docker-build-latest.yml
index 59128d16b..92421b78b 100644
--- a/.github/workflows/docker-build-latest.yml
+++ b/.github/workflows/docker-build-latest.yml
@@ -15,7 +15,7 @@ jobs:
         uses: docker/setup-qemu-action@v3
 
       - name: Install GitVersion
-        uses: gittools/actions/gitversion/setup@v3
+        uses: gittools/actions/gitversion/setup@v4
         with:
           versionSpec: '5.x'
 
@@ -27,7 +27,7 @@ jobs:
 
