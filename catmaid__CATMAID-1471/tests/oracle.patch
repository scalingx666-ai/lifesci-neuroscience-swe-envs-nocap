+        var responseObj = json.reduce(function(obj, arr) {
+          var labelID = arr[0];
+          var labelName = arr[1];
+          var skelID = arr[2];
+          var nodeID = arr[3];
+
+          if (!(labelName in obj)) {
+            obj[labelName] = {
+              'labelIDs': new Set([labelID]),
+              'skelIDs': new Set(),
+              'nodeIDs': new Set(),
+              'checked': false
+            };
+          } else {
+            obj[labelName].labelIDs.add(labelID);
+            obj[labelName].skelIDs.add(skelID);
+            obj[labelName].nodeIDs.add(nodeID);
+          }
+
+          return obj;
+        }, {});
+
+        responseCache = responseObj;
