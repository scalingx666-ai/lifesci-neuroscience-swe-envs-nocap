+    if first:
+        mode = ''
+
+    if isinstance(lb, (list, tuple)):
+        lb = torch.stack(lb)
+
+    # --- Restore figure elements --------------------------------------
+    dim = X.dim() - 1
+    ncol = len(X) + 1 + 2 * (M is not None) + 2 * (B is not None)
