+        self.bias_acceleration = min(1., max(0., bias_acceleration))
+        self.do_bias = do_bias
+        self.do_warp = do_warp
+        self.do_mixing = do_mixing
+        self.do_mrf = do_mrf
+
+        if prior is None:
