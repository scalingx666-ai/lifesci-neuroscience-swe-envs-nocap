+            X2 = X[:, :, X.shape[-2] // 2, :].cpu()
+            X3 = X[:, X.shape[-3] // 2, :, :].cpu()
+        if not mode:
+            for c in range(len(X)):
+                mn = X[c].min()
+                mx = X[c].max()
