+  attempt: number
+  deadline: number
+  maximumAttempts: number
+  now: () => number
+}
+
+const baselineObservationRetryExhausted = (): never =>
+  fail('REPOSITORY_CHANGED', 'The canonical repository changed repeatedly during the operation.')
