+def test_interpolate_masked_values_precomputed_phys_coords():
+    img = nib.Nifti1Image(np.ones((5, 1, 1), dtype=np.uint8), np.eye(4))
+    mask = np.ones(5, dtype=bool)
+    data = np.array([99.0, 2.0, 3.0, 4.0, 99.0])
