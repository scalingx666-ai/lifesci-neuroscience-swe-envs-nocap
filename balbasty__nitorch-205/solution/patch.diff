+def test_autoreg_init_nonlinear(images, timeout):
+    _run('-mse', '-fix', 'fix.nii', '-mov', 'mov.nii',
+         '-dif', '-o', 'd0.nii.gz')
+    d0 = io.volumes.loadf('d0.nii.gz')
+    assert d0.abs().max() > 0
+    _autoreg(['-mse', '-fix', 'fix.nii', '-mov', 'mov.nii',
+              '-dif', '-init', 'd0.nii.gz', '-o', 'd1.nii.gz',
