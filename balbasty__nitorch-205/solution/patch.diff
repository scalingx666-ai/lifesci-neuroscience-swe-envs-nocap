+    # several pyramid levels: downsampled to the coarsest, then back up
+    _run('-mse', '-fix', 'fix.nii', '-mov', 'mov.nii',
+         '-dif', '-init', 'd0.nii.gz', '-pyr', '1', '2', '-o', 'd2.nii.gz')
+    assert list(io.volumes.map('d2.nii.gz').shape[:3]) == [12, 12, 12]
