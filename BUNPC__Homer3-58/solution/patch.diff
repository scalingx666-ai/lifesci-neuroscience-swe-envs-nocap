+    stimEdit.dataTreeHandle.currElem.AddStimColumn(labels{1}{j},1);
+end
+for i = 1:length(stimData)
+    onsets = str2double(stimData{i}(:,1));
+    dur = str2double(stimData{i}(:,2));
+    amp = str2double(stimData{i}(:,3));
+    if size(stimData{i},2) > 3
