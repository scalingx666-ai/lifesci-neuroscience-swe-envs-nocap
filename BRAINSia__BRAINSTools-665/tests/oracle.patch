+        config: ${{ fromJSON(needs.setup.outputs.matrix) }}
 
     steps:
       # ── Checkout & version extraction ─────────────────────────────────────────
       - uses: actions/checkout@v5
 
+      - name: Resolve ITK ref
+        id: itk
+        shell: bash
+        env:
+          ITK_REPO: ${{ matrix.config.itk_ref && inputs.itk_repo || '' }}
+          ITK_REF: ${{ matrix.config.itk_ref && (inputs.itk_ref || matrix.config.itk_ref) || '' }}
+        run: |
+          # Empty ITK_REF keeps the SuperBuild's pinned ITK; otherwise build the commit
+          # the ref points at now, so ccache keys and the log name an exact SHA.
+          if [ -z "${ITK_REF}" ]; then
+            { echo "sha="; echo "repo="; echo "version="; echo "keytag="; echo "cdash="; } >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          DEFAULT_ITK_REPO=https://github.com/InsightSoftwareConsortium/ITK.git
+          ITK_REPO="${ITK_REPO:-${DEFAULT_ITK_REPO}}"
+          if ! echo "${ITK_REPO}" | grep -qE '^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(\.git)?$'; then
+            echo "::error::ITK repository '${ITK_REPO}' is not an https://github.com/<owner>/<name> URL"
+            exit 1
+          fi
+          if echo "${ITK_REF}" | grep -qE '^[0-9a-f]{40}$'; then
+            SHA="${ITK_REF}"
+          else
+            SHA=$(git ls-remote -- "${ITK_REPO}" "refs/heads/${ITK_REF}" "refs/tags/${ITK_REF}" | head -1 | cut -f1)
+          fi
+          if [ -z "${SHA}" ]; then
+            echo "::error::ITK ref '${ITK_REF}' not found in ${ITK_REPO}"
+            exit 1
+          fi
+          # The SuperBuild needs the major.minor version to find ITK and to pick the legacy-removal flags.
+          OWNER=$(echo "${ITK_REPO}" | sed -E 's#https://github.com/([^/]+)/.*#\1#')
+          VERSION_FILE=$(curl -fsSL "https://raw.githubusercontent.com/${OWNER}/ITK/${SHA}/CMake/itkVersion.cmake")
+          MAJOR=$(echo "${VERSION_FILE}" | grep -E 'ITK_VERSION_MAJOR' | head -1 | sed -E 's/.*"([0-9]+)".*/\1/')
+          MINOR=$(echo "${VERSION_FILE}" | grep -E 'ITK_VERSION_MINOR' | head -1 | sed -E 's/.*"([0-9]+)".*/\1/')
+          if [ -z "${MAJOR}" ] || [ -z "${MINOR}" ]; then
+            echo "::error::could not read the ITK version at ${SHA}"
+            exit 1
+          fi
+          TAG="itk-$(echo "${ITK_REF}" | tr -cs 'a-zA-Z0-9' '-' | sed -E 's/^-//; s/-$//' | cut -c1-30)"
+          # A ref name alone must not share cache keys across repositories.
+          if [ "${ITK_REPO}" != "${DEFAULT_ITK_REPO}" ]; then
+            TAG="${TAG}-$(printf '%s' "${ITK_REPO}" | shasum -a 256 | cut -c1-8)"
+          fi
+          {
+            echo "sha=${SHA}"
+            echo "repo=${ITK_REPO}"
+            echo "version=${MAJOR}.${MINOR}"
+            echo "keytag=${TAG}-"
+            echo "cdash=:${TAG}"
+          } >> "$GITHUB_OUTPUT"
+          echo "### Built against ITK ${MAJOR}.${MINOR}, ${ITK_REF} @ ${SHA} (${ITK_REPO})" >> "$GITHUB_STEP_SUMMARY"
+
