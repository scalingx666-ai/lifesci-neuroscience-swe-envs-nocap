diff --git a/nitorch/tests/test_compute_fov.py b/nitorch/tests/test_compute_fov.py
new file mode 100644
index 00000000..c87481b7
--- /dev/null
+++ b/nitorch/tests/test_compute_fov.py
@@ -0,0 +1,28 @@
+import torch
+
+from nitorch.spatial import compute_fov
+
+
+def test_compute_fov_single_vs_batched():
+    mat = torch.eye(4, dtype=torch.double)
+    aff = torch.eye(4, dtype=torch.double)
+    aff[:3, -1] = torch.as_tensor([2., -3., 5.])
+    shape = torch.as_tensor([10, 20, 30])
+
+    mn_batch, mx_batch = compute_fov(mat, aff[None], shape[None])
+    mn_single, mx_single = compute_fov(mat, aff, shape)
+    assert torch.allclose(mn_single, mn_batch)
+    assert torch.allclose(mx_single, mx_batch)
+    # corners (1, 1, 1) and (10, 20, 30), shifted by the translation
+    assert torch.allclose(mn_batch, torch.as_tensor([3., -2., 6.]).double())
+    assert torch.allclose(mx_batch, torch.as_tensor([12., 17., 35.]).double())
+
+
+def test_compute_fov_shared_shape():
+    mat = torch.eye(4, dtype=torch.double)
+    affs = torch.eye(4, dtype=torch.double).repeat(2, 1, 1)
+    affs[1, :3, -1] = 10
+    shape = torch.as_tensor([4, 4, 4])
+    mn, mx = compute_fov(mat, affs, shape)
+    assert torch.allclose(mn, torch.full([3], 1.).double())
+    assert torch.allclose(mx, torch.full([3], 14.).double())
diff --git a/nitorch/tests/test_line_search.py b/nitorch/tests/test_line_search.py
new file mode 100644
index 00000000..deae4739
--- /dev/null
+++ b/nitorch/tests/test_line_search.py
@@ -0,0 +1,36 @@
+import torch
+
+from nitorch.cli.registration.helpers import BacktrackingLineSearch
+
+
+def make_problem(**kwargs):
+    param = torch.tensor([3., -2.], requires_grad=True)
+    optim = BacktrackingLineSearch(torch.optim.SGD([param], **kwargs))
+
+    def closure():
+        optim.zero_grad()
+        loss = param.square().sum()
+        loss.backward()
+        return loss
+
+    return param, optim, closure
+
+
+def test_line_search_decreases_loss():
+    param, optim, closure = make_problem(lr=0.1)
+    loss0 = param.detach().square().sum()
+    loss = optim.step(closure)
+    assert optim.last_ok
+    assert loss < loss0
+    assert torch.allclose(loss, param.detach().square().sum())
+
+
+def test_line_search_restores_params_on_failure():
+    # steps go uphill, so no backtracking step can decrease the loss
+    param, optim, closure = make_problem(lr=0.1, maximize=True)
+    param0 = param.detach().clone()
+    loss0 = param0.square().sum()
+    loss = optim.step(closure)
+    assert not optim.last_ok
+    assert torch.equal(param.detach(), param0)
+    assert torch.allclose(loss, loss0)
