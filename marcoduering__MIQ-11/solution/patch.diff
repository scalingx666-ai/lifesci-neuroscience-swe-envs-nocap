+  gh release download "$TAG" -p MIQ.app.zip -D "$STAGING/asset" --clobber
+  ./scripts/release_appcast.sh --notes-file "$CLEAN_NOTES" "$STAGING/asset/MIQ.app.zip"
+  check_tree "$APPCAST"
