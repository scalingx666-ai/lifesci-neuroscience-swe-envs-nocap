--- a/Applications/SlicerApp/Testing/Python/DICOMPluginTests.py
+++ b/Applications/SlicerApp/Testing/Python/DICOMPluginTests.py
@@ -63,6 +63,8 @@ def runTest(self):
         self.test_DICOMTID1500Plugin()
         self.setUp()
         self.test_DICOMM3DPlugin()
+        self.setUp()
+        self.test_visualBrowserPrecachesPluginTags()
 
     # -------------------------------------------------------------------------
     # Test: _dcmqi_binary helper
@@ -288,3 +290,24 @@ def test_DICOMM3DPlugin(self):
             shutil.rmtree(tmpDir)
 
         self.delayDisplay("test_DICOMM3DPlugin passed!")
+
+    # -------------------------------------------------------------------------
+    # Test: pre-caching of DICOM plugin tags in the visual DICOM browser
+    # -------------------------------------------------------------------------
+
+    def test_visualBrowserPrecachesPluginTags(self):
+        """Test that the visual DICOM browser pre-caches the tags of all DICOM plugins during import.
+
+        The visual browser has its own database object, which does not get the tags
+        of the DICOM plugins from the main database object by default.
+        """
+        self.delayDisplay("Starting test_visualBrowserPrecachesPluginTags")
+
+        browserWidget = slicer.modules.dicom.widgetRepresentation().self().browserWidget
+        tagsToPrecache = browserWidget.dicomVisualBrowser.dicomDatabase().tagsToPrecache
+
+        for pluginName, pluginClass in slicer.modules.dicomPlugins.items():
+            for tag in pluginClass().tags.values():
+                self.assertIn(tag.upper(), tagsToPrecache, f"Tag of {pluginName} is not pre-cached")
+
+        self.delayDisplay("test_visualBrowserPrecachesPluginTags passed!")
diff --git a/Modules/Scripted/DICOMLib/DICOMBrowser.py b/Modules/Scripted/DICOMLib/DICOMBrowser.py
index ef05eaa93aa..2be26e1da35 100644
--- a/Modules/Scripted/DICOMLib/DICOMBrowser.py
+++ b/Modules/Scripted/DICOMLib/DICOMBrowser.py
@@ -58,6 +58,12 @@ def __init__(self, dicomBrowser=None, parent="mainWindow"):
 
         # Add ctkVisualDICOMBrowser
         self.dicomVisualBrowser = ctk.ctkDICOMVisualBrowserWidget()
+        # The visual browser has its own database object. Use the import settings of the main database,
+        # otherwise the tags of DICOM plugins are not pre-cached during import and examining the imported
+        # data becomes magnitudes slower, as values are then read from the files one by one.
+        visualBrowserDatabase = self.dicomVisualBrowser.dicomDatabase()
+        visualBrowserDatabase.tagsToPrecache = slicer.dicomDatabase.tagsToPrecache
+        visualBrowserDatabase.indexingThreadCount = slicer.dicomDatabase.indexingThreadCount
         thumbnailsSize = settingsValue("DICOM/thumbnailsSize", "small")
         if thumbnailsSize == "large":
             self.dicomVisualBrowser.thumbnailSizePreset = ctk.ctkDICOMVisualBrowserWidget.ThumbnailSizePresetOption.Large
