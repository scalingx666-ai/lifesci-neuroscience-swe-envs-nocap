+  order = sorted(range(num_scales), key=lambda i: int(np.prod(scale_arrays[i])))
+  parents: list[int | None] = [None] * num_scales
+  remaining_children = [0] * num_scales
+  for pos, i in enumerate(order):
+    best_parent = None
