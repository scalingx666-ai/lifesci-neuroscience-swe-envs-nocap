+        # keep the legacy module-level handles pointing at the last program
+        # compiled for each atlas format, for backwards compatibility
+        global rgbShader, alphaShader
+        if atlasFormat == 'rgb':
+            rgbShader = self.shader
+        else:
+            alphaShader = self.shader
