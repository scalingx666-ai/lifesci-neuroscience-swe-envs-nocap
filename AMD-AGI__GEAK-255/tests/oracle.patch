+    "/opt/rocm",
+    "/opt/conda",
+    "/opt/venv",
+    "/opt/cuda",
+    "/usr/local",
+    "/lib/",
+    "/lib64/",
+    "/bin/",
+    "/sbin/",
+    "/etc/",
+    "/proc/",
+    "/sys/",
+    "/dev/",
+    "/tmp/",
+    "/var/",
+    "/run/",
+    "/root/.cache",
+    "/home/",
