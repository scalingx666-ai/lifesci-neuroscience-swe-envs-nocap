+@pytest.mark.parametrize(
+    ["metadata", "expected_output", "error_message"],
+    [
+        pytest.param(
+            {
+                "key": "citation",
+                "value": "BrainGlobe et. al., 2025., https://doi.org",
+            },
+            True,
+            None,
+            id="citation (multiple commas)",
+        ),
+        pytest.param(
+            {
+                "key": "resolution",
+                "value": [1, 1],
+            },
+            True,
+            None,
+            id="2D resolution [1, 1]",
+        ),
+        pytest.param(
+            {
+                "key": "resolution",
+                "value": (1, 1),
+            },
