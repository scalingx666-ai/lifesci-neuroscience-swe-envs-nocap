+
+const processIsDefinitelyDead = (pid: number) => {
+  let dead = false
+  try {
+    process.kill(pid, 0)
+  } catch (error) {
+    dead = (error as NodeJS.ErrnoException).code === 'ESRCH'
+  }
+  return dead
