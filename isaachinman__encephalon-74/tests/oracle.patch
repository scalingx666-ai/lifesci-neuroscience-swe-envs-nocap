+) => {
+  let moved = false
+  let authorityFailed = false
+  let authorityFailure: unknown
+  const assertCandidateAuthority = () => {
+    try {
+      assertCurrentLock()
+    } catch (error) {
+      authorityFailed = true
+      authorityFailure = error
+      throw error
+    }
