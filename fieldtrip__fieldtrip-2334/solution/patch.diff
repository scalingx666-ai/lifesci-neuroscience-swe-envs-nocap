+ft_uilayout(p1, 'tag', 'c..', 'units', 'normalized', 'height', 0.15)
+ft_uilayout(p1, 'style', 'edit', 'width', 0.25, 'backgroundcolor', [1 1 1]);
+ft_uilayout(p1, 'tag', 'c.p', 'width', 0.05)
+ft_uilayout(p1, 'tag', 'c.m', 'width', 0.05)
