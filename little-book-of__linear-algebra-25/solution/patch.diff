diff --git a/.github/workflows/quarto-publish.yml b/.github/workflows/quarto-publish.yml
new file mode 100644
index 0000000..83e964c
--- /dev/null
+++ b/.github/workflows/quarto-publish.yml
@@ -0,0 +1,58 @@
+name: Build and Deploy Quarto Site
+
+on:
+  push:
+    branches:
+      - master
+  pull_request:
+    branches:
+      - master
+  workflow_dispatch:
+
+permissions:
+  contents: read
+  pages: write
+  id-token: write
+
+concurrency:
+  group: pages
+  cancel-in-progress: true
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Setup Quarto
+        uses: quarto-dev/quarto-actions/setup@v2
+
+      - name: Render English HTML
+        run: quarto render --to html
+
+      - name: Render translated HTML books
+        run: |
+          quarto render books/de --to html
+          quarto render books/es --to html
+          quarto render books/ja --to html
+          quarto render books/ko --to html
+          quarto render books/vi --to html
+          quarto render books/zh-CN --to html
+
+      - name: Upload Pages artifact
+        uses: actions/upload-pages-artifact@v3
+        with:
+          path: docs
+
+  deploy:
+    if: github.event_name == 'push' && github.ref == 'refs/heads/master'
+    needs: build
+    runs-on: ubuntu-latest
+    environment:
+      name: github-pages
+      url: ${{ steps.deployment.outputs.page_url }}
+    steps:
+      - name: Deploy to GitHub Pages
+        id: deployment
+        uses: actions/deploy-pages@v4
