+
+// Traces the outline of a square around `center`, back to its start.
+function traceSquareAround(center: Vector3, halfWidth: number) {
+  const [x, y, z] = center;
+  traceAlong([
+    [x - halfWidth, y - halfWidth, z],
+    [x + halfWidth, y - halfWidth, z],
+    [x + halfWidth, y + halfWidth, z],
+    [x - halfWidth, y + halfWidth, z],
