@@ -0,0 +1,8 @@
+### 🧪 Tests
+
+- `test_get_open_files` waits for the terminated child process to exit before
+  checking that no files are reported open, so it no longer fails on
+  single-CPU systems.
+  Fixes [#7985](https://github.com/datalad/datalad/issues/7985) via
+  [PR #7987](https://github.com/datalad/datalad/pull/7987)
+  (by [@sanvila](https://github.com/sanvila))
diff --git a/datalad/tests/test_utils.py b/datalad/tests/test_utils.py
index 2514785d82..6a141d9331 100644
--- a/datalad/tests/test_utils.py
+++ b/datalad/tests/test_utils.py
@@ -1358,6 +1358,7 @@ def test_get_open_files(p=None):
     eq_(get_open_files(p)[str(subd.resolve())].pid, proc.pid)
     eq_(get_open_files(subd)[str(subd.resolve())].pid, proc.pid)
     proc.terminate()
+    proc.wait()
     assert_equal(get_open_files(str(subd)), {})
 
 
