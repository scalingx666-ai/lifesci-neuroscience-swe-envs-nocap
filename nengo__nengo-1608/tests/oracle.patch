+def test_readonly_attributes():
+    def test_attr(net, attr):
+        with pytest.raises(
+            ReadonlyError, match="Network.%s: %s is read-only" % (attr, attr)
+        ):
+            setattr(net, attr, [])
+
+    with nengo.Network() as net:
+        for attr in (
+            "objects",
+            "ensembles",
+            "nodes",
+            "networks",
+            "connections",
+            "probes",
+            "config",
+        ):
+            test_attr(net, attr)
