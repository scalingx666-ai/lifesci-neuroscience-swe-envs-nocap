diff --git a/run_tests.sh b/run_tests.sh
index b73b0f48b..b05112c34 100755
--- a/run_tests.sh
+++ b/run_tests.sh
@@ -10,11 +10,18 @@ else
     VARIANT="legacy"
 fi
 
