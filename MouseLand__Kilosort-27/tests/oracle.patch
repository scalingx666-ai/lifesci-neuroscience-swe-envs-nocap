diff --git a/utils/get_file_size.m b/utils/get_file_size.m
new file mode 100644
index 00000000..6c5c5974
--- /dev/null
+++ b/utils/get_file_size.m
@@ -0,0 +1,16 @@
+function bytes = get_file_size(fname)
+% gets file size ensuring that symlinks are dereferenced
+    bytes = NaN;
+    if isunix
+        cmd = sprintf('stat -Lc %%s %s', fname);
+        [status, r] = system(cmd);
+        if status == 0
+            bytes = str2double(r);
+        end
+    end
+
+    if isnan(bytes)
+        o = dir(fname);
+        bytes = o.bytes;
+    end
+end
