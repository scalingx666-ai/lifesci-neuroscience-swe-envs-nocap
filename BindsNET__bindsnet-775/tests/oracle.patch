+    def test_hebbian_predictable(self):
+        # Hebbian: dW = nu0 * outer(src_s, tgt_x) + nu1 * outer(src_x, tgt_s), then
+        # clamped. Both pre- and post-synaptic terms are positive (contrast PostPre,
+        # which subtracts the pre term).
