-
-    # Nitransforms warps are in RAS, with the vector components changing slowest
-    nt_warp = itk_warp.transpose(1, 2, 3, 0) * np.array([-1, -1, 1])
-
-    transforms.insert(0, nt.DenseFieldTransform(nb.Nifti1Image(nt_warp, ras_affine)))
