+   "cell_type": "code",
+   "execution_count": 2,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "import logging\n",
+    "#logger = logging.getLogger()\n",
+    "#logger.setLevel(logging.DEBUG)\n",
