+// ═════════════════════════════════════════════════════════════════════════════
+// Calibration Wizard
+// ═════════════════════════════════════════════════════════════════════════════
+
+type CalStep = "intro" | "baseline" | "blink" | "done" | "error";
+
+interface CalibrationWizardProps {
+  eegData: EEGData;
+  existing: BlinkCalibration | null;
+  onComplete: (cal: BlinkCalibration) => void;
+  onSkip?: () => void;
+  onExit: () => void;
+}
+
+function CalibrationWizard({
+  eegData,
+  existing,
+  onComplete,
+  onSkip,
+  onExit,
+}: CalibrationWizardProps) {
+  const [step, setStep] = useState<CalStep>("intro");
+  const [progress, setProgress] = useState(0);
+  const [blinkCount, setBlinkCount] = useState(0);
+  const [amp, setAmp] = useState(0);
+  const [result, setResult] = useState<BlinkCalibration | null>(null);
+  const [errorMsg, setErrorMsg] = useState("");
+
+  const baselineRef = useRef<number[]>([]);
+  const blinkRef = useRef<TimedReading[]>([]);
+  const channels = [0, 1]; // Fp1, Fp2
+
+  // ── Baseline collection (3 seconds) ──
+  useEffect(() => {
+    if (step !== "baseline") return;
+    baselineRef.current = [];
+    const start = performance.now();
+    const dur = 3000;
+
+    const iv = setInterval(() => {
+      const a = readAmplitude(eegData, channels);
+      baselineRef.current.push(a);
+      setAmp(a);
+      const elapsed = performance.now() - start;
+      setProgress(Math.min(1, elapsed / dur));
+      if (elapsed >= dur) {
+        clearInterval(iv);
+        setStep("blink");
+        setProgress(0);
+        setBlinkCount(0);
+      }
+    }, 100);
+
+    return () => clearInterval(iv);
+  }, [step, eegData]);
+
+  // ── Blink collection (~12 seconds, 5 prompts) ──
+  useEffect(() => {
+    if (step !== "blink") return;
+    blinkRef.current = [];
+    const start = performance.now();
+    const dur = 12000;
+    const promptInterval = 2400;
+    let nextPrompt = start + 400; // small initial delay
+
+    const iv = setInterval(() => {
+      const now = performance.now();
+      const a = readAmplitude(eegData, channels);
+      blinkRef.current.push({ time: now, amp: a });
+      setAmp(a);
+
+      // Count prompts
+      if (now >= nextPrompt) {
+        setBlinkCount((c) => Math.min(c + 1, 5));
+        nextPrompt += promptInterval;
+      }
+
+      const elapsed = now - start;
+      setProgress(Math.min(1, elapsed / dur));
+
+      if (elapsed >= dur) {
+        clearInterval(iv);
+        // Compute calibration
+        const cal = computeCalibration(
+          baselineRef.current,
+          blinkRef.current,
+          channels,
+        );
+        if (cal) {
+          setResult(cal);
+          setStep("done");
+        } else {
+          setErrorMsg(
+            "Could not detect enough distinct blinks above baseline. " +
+              "Try blinking more forcefully or check electrode contact on Fp1/Fp2 channels.",
+          );
+          setStep("error");
+        }
+      }
+    }, 50);
+
+    return () => clearInterval(iv);
+  }, [step, eegData]);
+
+  // ── Keyboard: Esc to exit ──
+  useEffect(() => {
+    const handler = (e: KeyboardEvent) => {
+      if (e.key === "Escape") onExit();
+    };
+    window.addEventListener("keydown", handler);
+    return () => window.removeEventListener("keydown", handler);
+  }, [onExit]);
+
+  // ── Amplitude display scale ──
+  const ampPct = Math.min(100, (amp / 400) * 100);
+  const ampColor = amp > 150 ? "#00c853" : amp > 80 ? "#eab308" : "#333";
+
+  return (
+    <div style={S.root}>
+      <div style={S.wizardWrap}>
+        <div style={S.wizardCard}>
+          {/* ── INTRO ── */}
+          {step === "intro" && (
+            <>
+              <div style={{ fontSize: 40, marginBottom: 12 }}>👁️</div>
+              <h2 style={S.wizardTitle}>Blink Calibration</h2>
+              <p style={S.wizardSub}>
+                This calibration measures your baseline brain activity and blink
+                amplitude to create a personalized detection profile.
+                <br />
+                <br />
+                You'll need about 15 seconds. Make sure electrodes on{" "}
+                <strong>Fp1</strong> and <strong>Fp2</strong> (channels 0 &amp;
+                1) have good contact.
+              </p>
+              <div style={S.btnRow}>
+                <button style={S.btn} onClick={onExit}>
+                  ← Exit
+                </button>
+                {onSkip && (
+                  <button style={S.btn} onClick={onSkip}>
+                    Skip
+                  </button>
+                )}
+                <button
+                  style={S.btnPrimary}
+                  onClick={() => setStep("baseline")}
+                >
+                  Start Calibration
+                </button>
+              </div>
+            </>
+          )}
+
+          {/* ── BASELINE ── */}
+          {step === "baseline" && (
+            <>
+              <div style={S.wizardStep}>Step 1 of 2 — Baseline</div>
+              <h2 style={S.wizardTitle}>Keep still, eyes open</h2>
+              <p style={S.wizardSub}>
+                Relax and look at the screen. Don't blink if you can help it.
+                <br />
+                Recording your baseline brain activity…
+              </p>
+              <div style={S.progressBar}>
+                <div
+                  style={{
+                    ...S.progressFill,
+                    width: `${progress * 100}%`,
+                  }}
+                />
+              </div>
+              <div style={S.ampMeter}>
+                <div
+                  style={{
+                    ...S.ampFill,
+                    width: `${ampPct}%`,
+                    background: ampColor,
+                  }}
+                />
+              </div>
+              <div style={{ fontSize: 12, color: "#666" }}>
+                {(progress * 3).toFixed(1)}s / 3.0s
+              </div>
+            </>
+          )}
+
+          {/* ── BLINK ── */}
+          {step === "blink" && (
+            <>
+              <div style={S.wizardStep}>Step 2 of 2 — Blink Detection</div>
+              <h2 style={S.wizardTitle}>Blink when you see the green dot</h2>
+              <p style={S.wizardSub}>
+                Blink clearly and deliberately each time the dot appears.
+              </p>
+              <div
+                style={{
+                  ...S.blinkDot,
+                  background:
+                    blinkCount > 0 && progress < 0.98
+                      ? blinkCount % 2 === 0
+                        ? "#00c853"
+                        : "#0a3d1a"
+                      : "#222",
+                  boxShadow:
+                    blinkCount > 0 && blinkCount % 2 === 0
+                      ? "0 0 30px rgba(0,200,83,0.4)"
+                      : "none",
+                }}
+              />
+              <div style={{ fontSize: 14, fontFamily: "'Geist Mono',monospace" }}>
+                Blink {blinkCount} / 5
+              </div>
+              <div style={{ ...S.progressBar, marginTop: 16 }}>
+                <div
+                  style={{
+                    ...S.progressFill,
+                    width: `${progress * 100}%`,
+                    background: "#00c853",
+                  }}
+                />
+              </div>
+              <div style={S.ampMeter}>
+                <div
+                  style={{
+                    ...S.ampFill,
+                    width: `${ampPct}%`,
+                    background: ampColor,
+                  }}
+                />
+              </div>
+            </>
+          )}
+
+          {/* ── DONE ── */}
+          {step === "done" && result && (
+            <>
+              <div style={{ fontSize: 40, marginBottom: 12 }}>✅</div>
+              <h2 style={S.wizardTitle}>Calibration Complete</h2>
+              <p style={S.wizardSub}>
+                Your blink profile has been computed. These settings will be
+                saved for future sessions.
+              </p>
+              <div style={S.resultGrid}>
+                <div style={S.resultItem}>
+                  <div style={S.resultLabel}>Baseline p95</div>
+                  <div style={S.resultValue}>
+                    {result.baselineCeiling.toFixed(0)} µV
+                  </div>
+                </div>
+                <div style={S.resultItem}>
+                  <div style={S.resultLabel}>Blink median</div>
+                  <div style={S.resultValue}>
+                    {result.blinkMedian.toFixed(0)} µV
+                  </div>
+                </div>
+                <div style={S.resultItem}>
+                  <div style={S.resultLabel}>Threshold</div>
+                  <div style={{ ...S.resultValue, color: "#f59e0b" }}>
+                    {result.threshold.toFixed(0)} µV
+                  </div>
+                </div>
+                <div style={S.resultItem}>
+                  <div style={S.resultLabel}>Channels</div>
+                  <div style={S.resultValue}>
+                    Fp1, Fp2
+                  </div>
+                </div>
+              </div>
+              <div style={S.btnRow}>
+                <button
+                  style={S.btn}
+                  onClick={() => {
+                    setStep("intro");
+                    setProgress(0);
+                  }}
+                >
+                  Redo
+                </button>
+                <button
+                  style={S.btnPrimary}
+                  onClick={() => onComplete(result)}
+                >
+                  Start Browsing →
+                </button>
+              </div>
+            </>
+          )}
+
+          {/* ── ERROR ── */}
+          {step === "error" && (
+            <>
+              <div style={{ fontSize: 40, marginBottom: 12 }}>⚠️</div>
+              <h2 style={S.wizardTitle}>Calibration Failed</h2>
+              <p style={S.wizardSub}>{errorMsg}</p>
+              <div style={S.btnRow}>
+                <button style={S.btn} onClick={onExit}>
+                  Exit
+                </button>
+                <button
+                  style={S.btnPrimary}
+                  onClick={() => {
+                    setStep("intro");
+                    setProgress(0);
+                    setErrorMsg("");
+                  }}
+                >
+                  Try Again
+                </button>
+              </div>
+            </>
+          )}
+        </div>
+      </div>
+    </div>
+  );
+}
+
+// ═════════════════════════════════════════════════════════════════════════════
+// Browse Mode
+// ═════════════════════════════════════════════════════════════════════════════
+
+interface BrowseModeProps {
+  eegData: EEGData;
+  calibration: BlinkCalibration;
+  onRecalibrate: () => void;
+  onExit: () => void;
+}
+
+function BrowseMode({
+  eegData,
+  calibration,
+  onRecalibrate,
+  onExit,
+}: BrowseModeProps) {
+  const [scrollDir, setScrollDir] = useState<"down" | "up">("down");
+  const [blinkFlash, setBlinkFlash] = useState(false);
+  const [enabled, setEnabled] = useState(true);
+  const [scrollAmount, setScrollAmount] = useState(calibration.scrollAmount);
+  const [amp, setAmp] = useState(0);
+  const [blinkTotal, setBlinkTotal] = useState(0);
+  const [mode, setMode] = useState<"reader" | "web">("reader");
+  const [url, setUrl] = useState(
+    "https://en.wikipedia.org/wiki/Electroencephalography",
+  );
+  const [iframeUrl, setIframeUrl] = useState("");
+  const [iframeScroll, setIframeScroll] = useState(0);
+  const [showSettings, setShowSettings] = useState(false);
+  const [threshold, setThreshold] = useState(calibration.threshold);
+
+  const contentRef = useRef<HTMLDivElement>(null);
+  const stateRef = useRef<"idle" | "in-blink">("idle");
+  const lastBlinkRef = useRef(0);
+  const blinkStartRef = useRef(0);
+  const flashTimeoutRef = useRef(0);
+  const ampRef = useRef(0);
+  const lastAmpUpdate = useRef(0);
+
+  // ── Scroll action ──
+  const doScroll = useCallback(() => {
+    setBlinkTotal((c) => c + 1);
+    setBlinkFlash(true);
+    clearTimeout(flashTimeoutRef.current);
+    flashTimeoutRef.current = window.setTimeout(
+      () => setBlinkFlash(false),
+      200,
+    );
+
+    const amount = scrollDir === "down" ? scrollAmount : -scrollAmount;
+
+    if (mode === "reader" && contentRef.current) {
+      contentRef.current.scrollBy({ top: amount, behavior: "smooth" });
+    } else if (mode === "web") {
+      setIframeScroll((prev) => Math.max(0, prev + amount));
+    }
+  }, [scrollDir, scrollAmount, mode]);
+
+  // ── Blink detection loop (RAF) ──
+  useEffect(() => {
+    if (!enabled) return;
+
+    const WINDOW = 25; // 100ms
+    const REFRACTORY_MS = 400;
+    const MAX_BLINK_MS = 600;
+    const CHECK_MS = 20;
+
+    let lastCheck = 0;
+    let raf: number;
+
+    // Stable refs for current values
+    const scrollFn = doScroll;
+
+    function check() {
+      const now = performance.now();
+      if (now - lastCheck < CHECK_MS) {
+        raf = requestAnimationFrame(check);
+        return;
+      }
+      lastCheck = now;
+
+      const a = readAmplitude(eegData, calibration.channels, WINDOW);
+      ampRef.current = a;
+
+      // Throttle React state update for amplitude display (every 80ms)
+      if (now - lastAmpUpdate.current > 80) {
+        lastAmpUpdate.current = now;
+        setAmp(a);
+      }
+
+      const above = a > threshold;
+      const state = stateRef.current;
+
+      if (state === "idle") {
+        if (above && now - lastBlinkRef.current > REFRACTORY_MS) {
+          stateRef.current = "in-blink";
+          blinkStartRef.current = now;
+        }
+      } else if (state === "in-blink") {
+        if (!above) {
+          const dur = now - blinkStartRef.current;
+          if (dur >= 30 && dur <= MAX_BLINK_MS) {
+            lastBlinkRef.current = now;
+            stateRef.current = "idle";
+            scrollFn();
+          } else {
+            stateRef.current = "idle";
+          }
+        } else if (now - blinkStartRef.current > MAX_BLINK_MS) {
+          stateRef.current = "idle";
+        }
+      }
+
+      raf = requestAnimationFrame(check);
+    }
+
+    raf = requestAnimationFrame(check);
+    return () => cancelAnimationFrame(raf);
+  }, [enabled, eegData, calibration, threshold, doScroll]);
+
+  // ── Keyboard shortcuts ──
+  useEffect(() => {
+    const handler = (e: KeyboardEvent) => {
+      if (e.target instanceof HTMLInputElement) return;
+      switch (e.key) {
+        case "Escape":
+          if (showSettings) setShowSettings(false);
+          else onExit();
+          break;
+        case " ":
+          e.preventDefault();
+          setScrollDir((d) => (d === "down" ? "up" : "down"));
+          break;
+        case "s":
+        case "S":
+          setShowSettings((v) => !v);
+          break;
+        case "+":
+        case "=":
+          setScrollAmount((v) => Math.min(800, v + 50));
+          break;
+        case "-":
+        case "_":
+          setScrollAmount((v) => Math.max(50, v - 50));
+          break;
+      }
+    };
+    window.addEventListener("keydown", handler);
+    return () => window.removeEventListener("keydown", handler);
+  }, [onExit, showSettings]);
+
+  // ── Amplitude meter ──
+  const ampPct = Math.min(100, (amp / (threshold * 2)) * 100);
+  const threshPct = Math.min(100, (threshold / (threshold * 2)) * 100);
+  const meterColor = amp > threshold ? "#00c853" : "#333";
+
+  return (
+    <div style={S.root}>
+      {/* ── Header ── */}
+      <div style={S.header}>
+        <button style={S.btnSmall} onClick={onExit}>
+          ← Exit
+        </button>
+        <div style={S.headerTitle}>Blink Browser</div>
+
+        {/* Amplitude meter */}
+        <div style={S.meterWrap}>
+          <div
+            style={{
+              ...S.meterFill,
+              width: `${ampPct}%`,
+              background: meterColor,
+            }}
+          />
+          <div style={{ ...S.meterThreshLine, left: `${threshPct}%` }} />
+        </div>
+
+        {/* Blink indicator */}
+        <div
+          style={{
+            ...S.blinkBadge,
+            background: blinkFlash
+              ? "rgba(0,200,83,0.2)"
+              : "rgba(255,255,255,0.04)",
+            color: blinkFlash ? "#00c853" : "#666",
+            border: blinkFlash
+              ? "1px solid rgba(0,200,83,0.3)"
+              : "1px solid rgba(255,255,255,0.06)",
+          }}
+        >
+          {blinkFlash ? "BLINK" : `${blinkTotal} blinks`}
+        </div>
+
+        {/* Direction toggle */}
+        <button
+          style={S.dirBtn}
+          onClick={() =>
+            setScrollDir((d) => (d === "down" ? "up" : "down"))
+          }
+          title="Toggle scroll direction (Space)"
+        >
+          {scrollDir === "down" ? "↓" : "↑"} {scrollDir}
+        </button>
+
+        {/* Enable toggle */}
+        <button
+          style={{
+            ...S.btnSmall,
+            background: enabled ? "rgba(0,200,83,0.1)" : "#111",
+            color: enabled ? "#00c853" : "#666",
+            borderColor: enabled
+              ? "rgba(0,200,83,0.2)"
+              : "rgba(255,255,255,0.1)",
+          }}
+          onClick={() => setEnabled((v) => !v)}
+        >
+          {enabled ? "● ON" : "○ OFF"}
+        </button>
+
+        {/* Settings */}
+        <button
+          style={S.btnSmall}
+          onClick={() => setShowSettings((v) => !v)}
+          title="Settings (S)"
+        >
+          ⚙
+        </button>
+      </div>
+
+      {/* ── URL bar / mode tabs ── */}
+      <div style={S.urlBar}>
+        <button
+          style={{
+            ...S.modeTab,
+            background:
+              mode === "reader" ? "rgba(0,112,243,0.1)" : "transparent",
+            color: mode === "reader" ? "#3291ff" : "#666",
+            borderColor:
+              mode === "reader"
+                ? "rgba(0,112,243,0.2)"
+                : "rgba(255,255,255,0.08)",
+          }}
+          onClick={() => setMode("reader")}
+        >
+          📖 Reader
+        </button>
+        <button
+          style={{
+            ...S.modeTab,
+            background:
+              mode === "web" ? "rgba(0,112,243,0.1)" : "transparent",
+            color: mode === "web" ? "#3291ff" : "#666",
+            borderColor:
+              mode === "web"
+                ? "rgba(0,112,243,0.2)"
+                : "rgba(255,255,255,0.08)",
+          }}
+          onClick={() => setMode("web")}
+        >
+          🌐 Web
+        </button>
+
+        {mode === "web" && (
+          <>
+            <input
+              style={S.urlInput}
+              value={url}
+              onChange={(e) => setUrl(e.target.value)}
+              onKeyDown={(e) => {
+                if (e.key === "Enter") {
+                  let u = url.trim();
+                  if (u && !u.startsWith("http")) u = "https://" + u;
+                  setIframeUrl(u);
+                  setIframeScroll(0);
+                }
+              }}
+              placeholder="Enter URL and press Enter…"
+              spellCheck={false}
+            />
+            <button
+              style={S.btnSmall}
+              onClick={() => {
+                let u = url.trim();
+                if (u && !u.startsWith("http")) u = "https://" + u;
+                setIframeUrl(u);
+                setIframeScroll(0);
+              }}
+            >
+              Go
+            </button>
+          </>
+        )}
+      </div>
+
+      {/* ── Content area ── */}
+      {mode === "reader" ? (
+        <div ref={contentRef} style={S.content}>
+          {ARTICLES.map((art, i) => (
+            <div key={i}>
+              {i > 0 && <hr style={S.articleDivider} />}
+              <article style={S.article}>
+                <h1 style={S.articleTitle}>{art.title}</h1>
+                <div style={S.articleBody}>{art.body}</div>
+              </article>
+            </div>
+          ))}
+          <div
+            style={{
+              textAlign: "center",
+              padding: "60px 0",
+              color: "#444",
+              fontSize: 14,
+            }}
+          >
+            — End of articles —
+          </div>
+        </div>
+      ) : (
+        <div style={S.iframeWrap}>
+          {iframeUrl ? (
+            <iframe
+              src={iframeUrl}
+              title="Blink Browser"
+              sandbox="allow-scripts allow-same-origin allow-forms"
+              referrerPolicy="no-referrer"
+              style={{
+                ...S.iframe,
+                transform: `translateY(${-iframeScroll}px)`,
+              }}
+            />
+          ) : (
+            <div
+              style={{
+                flex: 1,
+                display: "flex",
+                alignItems: "center",
+                justifyContent: "center",
+                color: "#444",
+                fontSize: 14,
+              }}
+            >
+              Enter a URL above and press Enter or Go.
+              <br />
+              Note: some websites block iframe embedding.
+            </div>
+          )}
+        </div>
+      )}
+
+      {/* ── Settings panel ── */}
+      {showSettings && (
+        <div style={S.settingsPanel}>
+          <div>
+            <div style={S.settLabel}>Scroll amount</div>
+            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
+              <button
+                style={S.btnSmall}
+                onClick={() => setScrollAmount((v) => Math.max(50, v - 50))}
+              >
+                −
+              </button>
+              <span style={S.settValue}>{scrollAmount}px</span>
+              <button
+                style={S.btnSmall}
+                onClick={() => setScrollAmount((v) => Math.min(800, v + 50))}
+              >
+                +
+              </button>
+            </div>
+          </div>
+          <div>
+            <div style={S.settLabel}>Threshold</div>
+            <div style={{ display: "flex", alignItems: "center", gap: 8 }}>
+              <button
+                style={S.btnSmall}
+                onClick={() => setThreshold((v) => Math.max(20, v - 10))}
+              >
+                −
+              </button>
+              <span style={S.settValue}>{threshold.toFixed(0)} µV</span>
+              <button
+                style={S.btnSmall}
+                onClick={() => setThreshold((v) => Math.min(500, v + 10))}
+              >
+                +
+              </button>
+            </div>
+          </div>
+          <div>
+            <div style={S.settLabel}>Channels</div>
+            <span style={S.settValue}>
+              {calibration.channels.map((c) => `Ch${c}`).join(", ")}
+            </span>
+          </div>
+          <div>
+            <div style={S.settLabel}>Calibrated</div>
+            <span style={{ ...S.settValue, fontSize: 12 }}>
+              {new Date(calibration.timestamp).toLocaleString()}
+            </span>
+          </div>
+          <button style={S.btnSmall} onClick={onRecalibrate}>
+            🔄 Recalibrate
+          </button>
+          <div style={{ flex: 1 }} />
+          <button
+            style={S.btnSmall}
+            onClick={() => setShowSettings(false)}
+          >
+            Close (S)
+          </button>
+        </div>
+      )}
+
+      {/* ── Footer ── */}
+      <div style={S.footer}>
+        <span>
+          <strong>Space</strong> toggle direction
+        </span>
+        <span>
+          <strong>+/−</strong> scroll amount
+        </span>
+        <span>
+          <strong>S</strong> settings
+        </span>
+        <span>
+          <strong>Esc</strong> exit
+        </span>
+        <div style={{ flex: 1 }} />
+        <span style={{ fontFamily: "'Geist Mono',monospace" }}>
+          {amp.toFixed(0)} µV
+        </span>
+      </div>
+    </div>
+  );
+}
+
+// ═════════════════════════════════════════════════════════════════════════════
+// Main Experience Component
+// ═════════════════════════════════════════════════════════════════════════════
+
+interface Props {
+  eegData: EEGData;
+  yScale: number;
+  onExit: () => void;
+}
+
+export default function BlinkBrowser({ eegData, yScale, onExit }: Props) {
+  const [calibration, setCalibration] = useState<BlinkCalibration | null>(
+    () => loadCalibration(),
+  );
+  const [showCal, setShowCal] = useState(!loadCalibration());
+
+  if (showCal) {
+    return (
+      <CalibrationWizard
+        eegData={eegData}
+        existing={calibration}
+        onComplete={(cal) => {
+          saveCalibration(cal);
+          setCalibration(cal);
+          setShowCal(false);
+        }}
+        onSkip={calibration ? () => setShowCal(false) : undefined}
+        onExit={onExit}
+      />
+    );
+  }
+
+  return (
+    <BrowseMode
+      eegData={eegData}
+      calibration={calibration!}
+      onRecalibrate={() => setShowCal(true)}
+      onExit={onExit}
+    />
+  );
+}
