+import{r as i,j as e}from"./index-BlmjQank.js";const X="pieeg_blink_calibration";function J(){try{const s=localStorage.getItem(X);return s?JSON.parse(s):null}catch{return null}}function re(s){localStorage.setItem(X,JSON.stringify(s))}function q(s,m,g=25){const c=s.buffers.current,d=s.writeIndex.current,a=s.samplesInBuffer.current,r=s.bufferSize;if(a<g)return 0;let o=0;for(const l of m){if(l>=c.length)continue;const y=c[l];let u=1/0,p=-1/0;for(let x=0;x<g;x++){const A=((d-1-x)%r+r)%r,C=y[A];C<u&&(u=C),C>p&&(p=C)}const j=p-u;j>o&&(o=j)}return o}function se(s,m=5,g=400){const c=[...s].sort((r,o)=>o.amp-r.amp),d=[],a=[];for(const r of c){if(d.length>=m)break;a.some(l=>Math.abs(r.time-l)<g)||(d.push(r.amp),a.push(r.time))}return d}function ae(s,m,g){if(s.length<10)return null;const c=[...s].sort((u,p)=>u-p),d=Math.floor(c.length*.95),a=c[Math.min(d,c.length-1)],o=se(m,5,400).filter(u=>u>a*1.3);if(o.length<2)return null;o.sort((u,p)=>u-p);const l=o[Math.floor(o.length/2)],y=a+.5*(l-a);return{baselineCeiling:a,blinkMedian:l,threshold:y,channels:g,scrollAmount:200,timestamp:Date.now()}}const oe=[{title:"Understanding Brain-Computer Interfaces",body:`Brain-computer interfaces (BCIs) represent one of the most exciting frontiers in neuroscience and engineering. These systems create a direct communication pathway between the brain and an external device, bypassing traditional neuromuscular output channels.
+
+The concept of BCIs dates back to the 1970s, when Jacques Vidal at UCLA first coined the term and demonstrated that electrical signals from the brain could be used to control a cursor on a computer screen. Since then, the field has grown exponentially, with applications ranging from medical rehabilitation to entertainment.
+
+How BCIs Work
+
+At their core, BCIs rely on detecting and interpreting neural signals. The most common non-invasive approach uses electroencephalography (EEG) — the same technology powering this very experience you're using right now. EEG electrodes placed on the scalp detect the tiny electrical potentials generated by populations of neurons firing in synchrony.
+
+These signals are incredibly weak — typically measured in microvolts (µV), which is one-millionth of a volt. For comparison, a standard AA battery produces 1.5 volts, which is about 1.5 million times stronger than a typical EEG signal. Despite this, modern amplifiers and signal processing techniques can reliably extract meaningful information from these faint neural whispers.
+
+Types of Brain Signals Used in BCIs
+
+Several types of brain signals have proven useful for BCI applications:
+
+1. Event-Related Potentials (ERPs): These are stereotyped responses to specific stimuli. The P300 wave, a positive deflection occurring about 300 milliseconds after a rare or meaningful stimulus, has been widely used in spelling systems where users can select letters by focusing on them.
+
+2. Steady-State Visual Evoked Potentials (SSVEPs): When looking at a flickering light, the visual cortex generates oscillations at the same frequency. By presenting multiple stimuli flickering at different frequencies, a BCI can determine which one the user is attending to.
+
+3. Sensorimotor Rhythms (SMRs): Imagining movement of different body parts produces characteristic changes in the mu (8-12 Hz) and beta (13-30 Hz) rhythms over the motor cortex. This is the basis for motor imagery BCIs.
+
+4. Blink and Eye Movement Artifacts: While traditionally considered noise in EEG research, eye blinks and movements produce large, easily detectable signals — exactly what this Blink Browser experience leverages. Blinks generate deflections of 100-500 µV on frontal electrodes, making them one of the most reliable BCI control signals.
+
+The Future of BCIs
+
+Current research is pushing the boundaries of what's possible with BCIs. Companies like Neuralink are developing high-density implantable arrays that could decode complex thoughts and intentions. Meanwhile, non-invasive approaches continue to improve, with dry electrodes, machine learning algorithms, and real-time processing making BCIs more accessible than ever.
+
+The convergence of neuroscience, artificial intelligence, and miniaturized electronics suggests a future where brain-computer interfaces become as commonplace as touchscreens are today. Projects like PiEEG are already democratizing access to this technology, putting affordable, open-source EEG hardware in the hands of makers, researchers, and enthusiasts worldwide.`},{title:"The Science of Eye Blinks",body:`You blink about 15-20 times per minute — roughly 1,200 times per hour, and up to 28,800 times per day. Yet you rarely notice it. This seemingly trivial reflex is actually a complex neurological event with fascinating properties that make it ideal for brain-computer interface control.
+
+Anatomy of a Blink
+
+A blink involves the rapid closing and opening of the eyelid, primarily driven by the orbicularis oculi muscle (for closing) and the levator palpebrae superioris muscle (for opening). A complete blink cycle takes about 300-400 milliseconds, with the closing phase being faster (roughly 80ms) than the opening phase (roughly 170ms).
+
+Why Blinks Show Up in EEG
+
+When you blink, the movement of the eyelid across the cornea creates a measurable electrical potential change. The eye acts like a small battery, with the cornea being positively charged relative to the retina. This corneoretinal dipole means that any eye movement — including blinks — generates electrical fields that propagate across the scalp and are easily picked up by frontal EEG electrodes.
+
+This is why EEG researchers traditionally viewed blinks as artifacts to be removed. But from a BCI perspective, this strong, reliable signal is a feature, not a bug. Blink artifacts typically range from 100 to 500 µV peak-to-peak on frontal channels (Fp1, Fp2), compared to normal EEG activity of 10-100 µV. This excellent signal-to-noise ratio makes blink detection one of the most robust BCI control methods available.
+
+Types of Blinks
+
+Not all blinks are created equal:
+
+Spontaneous Blinks: These occur naturally to keep the cornea moist and happen reflexively without conscious thought. They're typically smaller in amplitude and occur at semi-regular intervals.
+
+Voluntary Blinks: Deliberate, intentional blinks tend to be stronger and more forceful. They produce larger EEG deflections and are easier to detect — perfect for BCI control.
+
+Reflex Blinks: Triggered by sudden stimuli (bright light, loud sound, approaching object), these are the fastest but least useful for intentional control.
+
+Blink Rate and Cognitive State
+
+Interestingly, blink rate varies with cognitive state. During focused reading, blink rate drops to about 3-4 per minute. During conversation, it increases to about 26 per minute. Fatigue and drowsiness also increase blink rate and duration. This means a blink-based BCI could potentially adapt its behavior based on the user's cognitive state.
+
+Blink Detection in This Experience
+
+The Blink Browser uses a straightforward but effective detection algorithm:
+
+1. Continuous monitoring of frontal EEG channels (Fp1 and Fp2)
+2. Computing peak-to-peak amplitude in a sliding 100ms window
+3. Comparing against a personalized threshold set during calibration
+4. Applying a refractory period to prevent double-counting
+5. Validating blink duration (too short = noise, too long = sustained artifact)
+
+The calibration process is crucial because blink amplitude varies significantly between individuals, depending on factors like skin impedance, electrode placement, muscle strength, and even facial anatomy. By calibrating specifically for each user, the system achieves high detection accuracy with minimal false positives.
+
+Practical Applications
+
+Beyond scrolling through content, blink-based BCIs have been used for:
+
+• Communication systems for patients with locked-in syndrome
+• Fatigue detection in drivers and pilots  
+• Hands-free device control in sterile environments (operating rooms)
+• Gaming interfaces
+• Accessibility tools for people with motor impairments
+
+The simplicity and reliability of blink detection makes it an excellent entry point into the world of brain-computer interfaces.`},{title:"EEG Frequency Bands: A Guide",body:`The brain is always electrically active, producing oscillations across a wide range of frequencies. These oscillations are not random — they reflect the coordinated activity of neural populations and are associated with specific cognitive states and functions.
+
+Delta Waves (0.5-4 Hz)
+
+Delta waves are the slowest brain oscillations and have the highest amplitude. They are most prominent during deep, dreamless sleep (stages 3 and 4 of non-REM sleep) and are thought to play a role in memory consolidation and brain restoration.
+
+In waking adults, delta activity is normally minimal. Excessive delta during wakefulness can indicate brain injury, encephalopathy, or certain neurological conditions. However, some research suggests that frontal delta activity may also be involved in attention and motivation.
+
+Theta Waves (4-8 Hz)
+
+Theta oscillations are associated with drowsiness, light sleep, and the transition between waking and sleeping (the hypnagogic state). In this twilight zone of consciousness, many people experience vivid imagery and creative insights.
+
+During waking, frontal theta increases during working memory tasks, error processing, and emotional regulation. The famous "theta burst" seen during meditation has been linked to enhanced creativity and insight. Hippocampal theta is also crucial for spatial navigation and memory encoding.
+
+Alpha Waves (8-13 Hz)
+
+Perhaps the most well-known brain rhythm, alpha waves were the first to be identified by Hans Berger in 1929 when he invented the electroencephalogram. Alpha is most prominent over posterior (occipital) regions when the eyes are closed and the mind is relaxed but alert.
+
+The classic demonstration: close your eyes, relax, and alpha power increases dramatically. Open your eyes or start thinking about a math problem, and alpha is suppressed (this is called alpha blocking or alpha desynchronization).
+
+Alpha is thought to play an inhibitory role, helping to suppress processing in brain regions that are not relevant to the current task. This "gating" function makes alpha a key target for neurofeedback training, where users learn to voluntarily control their alpha levels.
+
+Beta Waves (13-30 Hz)
+
+Beta oscillations are associated with active thinking, problem-solving, and focused concentration. They are most prominent over frontal and central regions during cognitive tasks.
+
+Low beta (13-15 Hz, sometimes called SMR or sensorimotor rhythm) is associated with calm, focused attention. Mid-beta (15-20 Hz) reflects active engagement. High beta (20-30 Hz) can indicate anxiety, stress, or intense cognitive processing.
+
+In motor cortex, beta power decreases before and during movement (event-related desynchronization) and increases after movement completion (event-related synchronization or beta rebound). Motor imagery BCIs exploit these changes to decode intended movements.
+
+Gamma Waves (30-100 Hz)
+
+Gamma oscillations are the fastest brain rhythms routinely studied in EEG. They are associated with higher cognitive functions including perception, attention, consciousness, and the binding of information from different brain regions into coherent percepts.
+
+When you recognize a face, understand a sentence, or have an "aha!" moment, gamma activity typically increases. Some researchers believe gamma oscillations are the neural correlate of consciousness itself, though this remains debated.
+
+Detecting gamma in scalp EEG is challenging because the signals are small and easily contaminated by muscle artifact (EMG), which also contains high-frequency energy. This is why careful artifact rejection is essential for gamma research.
+
+Practical Implications for BCI
+
+Each frequency band offers different possibilities for BCI control:
+
+• Alpha: Can be voluntarily modulated with practice (neurofeedback), enabling eyes-open/closed control schemes
+• Beta/SMR: Motor imagery BCIs use beta changes to decode intended movements
+• Theta: Could detect attentional states and adapt BCI behavior
+• Gamma: Too variable for direct control but useful for cognitive state monitoring
+
+The PiEEG system you're using detects all these bands in real-time. Explore the FFT panel in the main dashboard to see your own brain's frequency spectrum in action!
+
+Understanding Your Own Brain Rhythms
+
+Everyone's brain produces a unique pattern of oscillations. Factors that influence your EEG include:
+
+• Genetics: Twin studies show EEG patterns are highly heritable
+• Age: Alpha frequency increases during childhood and may slow in aging
+• Cognitive style: Visual thinkers may show different alpha patterns than verbal thinkers  
+• Meditation practice: Regular meditators often show enhanced alpha and theta
+• Caffeine, sleep, stress: All significantly affect frequency band power
+
+By watching your own EEG in real-time with PiEEG, you can begin to understand the relationship between your mental state and your brain's electrical activity — the first step toward effective brain-computer interface control.`}],t={root:{position:"fixed",inset:0,background:"#000",color:"#ededed",fontFamily:"'Geist','Inter',-apple-system,BlinkMacSystemFont,system-ui,sans-serif",display:"flex",flexDirection:"column",overflow:"hidden",zIndex:9e3},wizardWrap:{flex:1,display:"flex",alignItems:"center",justifyContent:"center",padding:24},wizardCard:{background:"#111",border:"1px solid rgba(255,255,255,0.06)",borderRadius:16,padding:40,maxWidth:520,width:"100%",textAlign:"center"},wizardTitle:{fontSize:22,fontWeight:600,marginBottom:8},wizardSub:{color:"#a1a1a1",fontSize:14,lineHeight:1.6,marginBottom:24},wizardStep:{fontSize:12,color:"#666",textTransform:"uppercase",letterSpacing:1,marginBottom:16},progressBar:{width:"100%",height:6,background:"#222",borderRadius:3,overflow:"hidden",marginBottom:20},progressFill:{height:"100%",background:"#0070f3",borderRadius:3,transition:"width 0.3s"},blinkDot:{width:80,height:80,borderRadius:"50%",margin:"24px auto",transition:"all 0.15s"},ampMeter:{height:4,background:"#222",borderRadius:2,overflow:"hidden",marginTop:12,marginBottom:8},ampFill:{height:"100%",borderRadius:2,transition:"width 0.05s"},resultGrid:{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12,margin:"20px 0",textAlign:"left"},resultItem:{background:"#0a0a0a",borderRadius:8,padding:"12px 16px"},resultLabel:{fontSize:11,color:"#666",textTransform:"uppercase",letterSpacing:.5},resultValue:{fontSize:20,fontWeight:600,fontFamily:"'Geist Mono',monospace",marginTop:4},btn:{padding:"10px 20px",borderRadius:8,border:"1px solid rgba(255,255,255,0.12)",background:"#171717",color:"#ededed",fontSize:14,cursor:"pointer",fontFamily:"inherit",transition:"background 0.15s"},btnPrimary:{padding:"10px 24px",borderRadius:8,border:"none",background:"#0070f3",color:"#fff",fontSize:14,fo