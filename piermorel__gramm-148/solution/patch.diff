diff --git a/gramm/@gramm/private/my_theme.m b/gramm/@gramm/private/my_theme.m
new file mode 100644
index 0000000..f2cb37c
--- /dev/null
+++ b/gramm/@gramm/private/my_theme.m
@@ -0,0 +1,15 @@
+function output = my_theme(f)
+%To maintain compatibility with older versions
+persistent has_theme
+if isempty(has_theme)
+    has_theme=~verLessThan('matlab','25.1');
+end
+
+if has_theme
+    output = theme(f).Name;
+else
+    output = 'Light Theme';
+end
+
+end
+
