diff --git a/nitorch/tests/test_cli_autoreg.py b/nitorch/tests/test_cli_autoreg.py
index c18dfc35..b6d430df 100644
--- a/nitorch/tests/test_cli_autoreg.py
+++ b/nitorch/tests/test_cli_autoreg.py
@@ -442,3 +442,25 @@ def test_autoreg_image_output_single_literal_path_rejected(tag):
                  tag, 'out.nii', '-rig'])
     key = 'updated' if tag == '-o' else 'resliced'
     assert getattr(opt.losses[0].moving, key) == ['out.nii']
+
+
+def test_autoreg_lta_is_ras_to_ras(images, timeout, monkeypatch):
+    # the linear transform acts in world space: it must be labelled
+    # RAS-to-RAS and its matrix written unchanged
+    from nitorch.cli.registration.autoreg import main as autoreg_main
+    seen = {}
+    linear_matrix = autoreg_main.linear_matrix
+
+    def spy(*args, **kwargs):
+        seen['lin'] = linear_matrix(*args, **kwargs)
+        return seen['lin']
+
+    monkeypatch.setattr(autoreg_main, 'linear_matrix', spy)
+    _run('-mse', '-fix', 'fix.nii', '-mov', 'mov.nii', '-rig', '-o', 'r.lta')
+    f = io.transforms.map('r.lta')
+    assert f.type() == ('ras', 'ras')
+    lin = seen['lin'].detach().double().reshape([4, 4])
+    assert torch.allclose(f.fdata(dtype=torch.double).reshape([4, 4]),
+                          lin, atol=1e-5)
+    assert torch.allclose(f.data(dtype=torch.double).reshape([4, 4]),
+                          lin, atol=1e-5)
diff --git a/nitorch/tests/test_cli_orient_vopt.py b/nitorch/tests/test_cli_orient_vopt.py
index 212214d9..318da64d 100644
--- a/nitorch/tests/test_cli_orient_vopt.py
+++ b/nitorch/tests/test_cli_orient_vopt.py
@@ -74,3 +74,20 @@ def fake_optimal_svf(inputs, weights=None, **prm):
     outs = sorted(f for f in os.listdir(tmp_path) if 'optimal' in f)
     assert outs == ['a_optimal.nii.gz', 'b_optimal.nii.gz',
                     'c_optimal.nii.gz']
+
+
+def test_orient_transform_is_ras_to_ras(tmp_path, volume):
+    import torch
+    from nitorch import io
+    from nitorch.spatial import affine_rmdiv
+    orient([volume, '-l', 'LPS', '-t'])
+    f = io.transforms.map(str(tmp_path / 'img_to_LPS.lta'))
+    assert f.type() == ('ras', 'ras')
+    aff0 = io.volumes.map(volume).affine.double()
+    aff1 = io.volumes.map(str(tmp_path / 'img.LPS.nii.gz')).affine.double()
+    expected = affine_rmdiv(aff1, aff0)
+    assert not torch.allclose(expected, torch.eye(4, dtype=torch.double))
+    assert torch.allclose(f.fdata(dtype=torch.double).reshape([4, 4]),
+                          expected, atol=1e-5)
+    assert torch.allclose(f.data(dtype=torch.double).reshape([4, 4]),
+                          expected, atol=1e-5)
