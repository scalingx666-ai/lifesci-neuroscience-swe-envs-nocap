+            config,
+            [("in_features", "in", None), ("out_features", "out", None)],
+        )
+    if "pool" in layer_type:
+        return _format_config_fields(
+            config,
+            [
+                ("kernel_size", "k", None),
+                ("stride", "s", None),
+                ("padding", "p", 0),
+                ("output_size", "out", None),
+            ],
+        )
+    if layer_type == "layernorm":
