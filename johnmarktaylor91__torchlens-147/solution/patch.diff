+def compute_default_node_lines(
+    layer_log: GraphNode,
+    node_address: str = "",
+    vis_mode: str = "unrolled",
+) -> list[str]:
+    """Build default plain-text rows for a layer node.
+
+    Parameters
+    ----------
+    layer_log:
+        LayerPassLog or LayerLog to render.
