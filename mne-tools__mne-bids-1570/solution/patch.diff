+@contextmanager
+def _readonly(directory):
+    """Temporarily strip write bit from ``directory``."""
+    original = directory.stat().st_mode
+    os.chmod(directory, 0o555)
+    try:
+        yield directory
+    finally:
+        os.chmod(directory, original)
