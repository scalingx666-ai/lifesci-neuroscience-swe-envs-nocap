+%==========================================================================
+% function val = GetNumaris4Val(str,name)
+%==========================================================================
+function val = GetNumaris4Val(str,name)
+name = deblank(name);
+val  = {};
+for i=1:length(str)
+    if strcmp(deblank(str(i).name),name)
+        for j=1:str(i).nitems
+            if  str(i).item(j).xx(1)
+                val = [val {str(i).item(j).val}];
+            end
+        end
+        break;
+    end
+end
+val = strvcat(val{:});
