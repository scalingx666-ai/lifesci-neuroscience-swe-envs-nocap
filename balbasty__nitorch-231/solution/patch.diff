+    (['-i', 'a', 'b', 'c', '-w'],
+     '-w/--weight expects 3 values: <fix> <mov> <path>'),
+    (['-i', 'a', 'b', 'c', '-o'], '-o/--output expects 1 value: <path>'),
+    (['-i', 'a', 'b', 'c', '-x'], '-x/--bound expects 1 value'),
