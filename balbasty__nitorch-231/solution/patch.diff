+    (['-i', 'a', 'b', 'c', '-m'], '-m/--membrane expects 1 value'),
+    (['-i', 'a', 'b', 'c', '-b'], '-b/--bending expects 1 value'),
+    (['-i', 'a', 'b', 'c', '-l'], '-l/--lame expects 1 value'),
