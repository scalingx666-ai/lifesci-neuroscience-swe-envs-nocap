+int is_xls_pn(SUMA_PARSED_NAME *FN)
+{
+   int a = 0;
+   if (!FN) return(0);
+   if (!strcmp(FN->Ext,".xls")) {
+      a = 1; 
+   }
+   else if (!strcmp(FN->Ext,".xlsx")) {
+      a = 1; 
+   }
+   return(a);
+}
+
+int is_xls(char *name)
+{
+   int a;
+   SUMA_PARSED_NAME *pn;
+   if (!name) return(0);
+   if (!(pn = SUMA_ParseFname (name,NULL))) {
+      return(0);
+   }
+   a = is_xls_pn(pn);
+   SUMA_Free_Parsed_Name (pn);
+   return(a);
+}
