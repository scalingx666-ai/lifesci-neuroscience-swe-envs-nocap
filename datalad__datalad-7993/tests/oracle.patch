index 0000000000..02498fb78e
--- /dev/null
+++ b/changelog.d/pr-7993.md
@@ -0,0 +1,7 @@
+### 🐛 Bug Fixes
+
+- On Windows, `clone` from a local RIA store (`ria+file:///C:/...`) no
+  longer fails in `git annex init` with `"/C:/..." is not absolute`: URLs
+  keep the drive letter's colon unescaped.
+  ([PR #7993](https://github.com/datalad/datalad/pull/7993))
+  (by [@yarikoptic](https://github.com/yarikoptic))
diff --git a/datalad/support/network.py b/datalad/support/network.py
index c8a493cd33..b73cfd5177 100644
--- a/datalad/support/network.py
+++ b/datalad/support/network.py
@@ -684,8 +684,9 @@ def _fields_to_pr(cls, fields):
         }
         pr_fields['netloc'] = netloc
         pr_fields['params'] = ''
-        # We need to quote the path
-        pr_fields['path'] = urlquote(pr_fields['path'])
+        # We need to quote the path, but keep the colon of a Windows drive
+        # (/C:/...): git-annex does not recognize an escaped one (C%3A)
+        pr_fields['path'] = quote_path(pr_fields['path'])
         # TODO: figure out what to do with query/fragment... one step at a time
         return ParseResult(**pr_fields)
 
