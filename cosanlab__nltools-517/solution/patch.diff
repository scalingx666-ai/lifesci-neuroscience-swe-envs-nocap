+        access_token="your_neurovault_api_key",
+        collection_name="Neurosynth Parcellation",
+        img_type="Pa",
+        img_modality="Other",
+        analysis_level="M",
+    )
+    ```
+    """)
+    return
+
+
+if __name__ == "__main__":
+    app.run()
