+
+class seedCorrelation(bis_basemodule.baseModule):
+
+    def __init__(self):
+        super().__init__();
+        self.name='seedCorrelation';
+   
+    def createDescription(self):
+        return modules_desc.descriptions['seedCorrelationImage'];
