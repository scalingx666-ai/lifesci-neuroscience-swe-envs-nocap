+              [0, 0,3]])
+
+eigvals = np.linalg.eigvals(A)
+spectral_radius = max(abs(eigvals))
+
+print("Eigenwerte:", Gleichwerte)
+print("Spektralradius:", spectral_radius)
+
+print("A^10:\n", np.linalg.matrix_power(A, 10))
+„
+
+Alle Einträge schrumpfen gegen Null.
+
+2. Instabile Matrix ($\rho > 1$)
+
