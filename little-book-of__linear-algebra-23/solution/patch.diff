+3. Kombinieren Sie Transformationen zu einer Pipeline
+
+„{Python}“
+M = T @ Rz @ S # zuerst skalieren, dann drehen, dann verschieben
+p_transformed = M @ p
+print("Transformierter Punkt:", p_transformed)
+„
+
+4. Robotik: Vorwärtskinematik eines 2-Gelenk-Arms
+
+Jedes Gelenk ist eine Rotation + Translation.
+
+„{Python}“
+def Link(Theta, Länge):
+    return np.array([[np.cos(theta), -np.sin(theta), 0, length*np.cos(theta)],
+                     [np.sin(theta), np.cos(theta), 0, Länge*np.sin(theta)],
+                     [0, 0, 1, 0],
+                     [0, 0, 0, 1]])
+
+Theta1, Theta2 = np.pi/4, np.pi/6
+L1, L2 = 2, 1,5
+
+M1 = Link(Theta1, L1)
+M2 = Link(Theta2, L2)
+
+end_effector = M1 @ M2 @ np.array([0,0,0,1])
+print("Endeffektorposition:", end_effector[:3])
+„
