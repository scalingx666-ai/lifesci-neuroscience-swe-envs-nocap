+fm1 = SpectralModel(aperiodic_mode='fixed')
+
+###################################################################################################
+# Relating Exponents to Power Spectrum Slope
+# ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
+#
+# The 'fixed' mode is equivalent to a linear fit in log-log space
+#
