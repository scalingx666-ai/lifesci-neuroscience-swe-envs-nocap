+              xla_client.ops.ConstantLiteral(c, n_col)),
+    operand_shapes_with_layout=(c.get_shape(events),
+                                c.get_shape(w_mu),
+                                c.get_shape(w_sigma),
+                                c.get_shape(clen),
+                                c.get_shape(seed),
+                                xla_client.Shape.array_shape(np.dtype(np.uint32), (), ()),
+                                xla_client.Shape.array_shape(np.dtype(np.uint32), (), ())),
