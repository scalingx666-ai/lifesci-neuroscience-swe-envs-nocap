diff --git a/tests/test_extra_regressors_empty_run.py b/tests/test_extra_regressors_empty_run.py
new file mode 100644
index 0000000..56080e3
--- /dev/null
+++ b/tests/test_extra_regressors_empty_run.py
@@ -0,0 +1,61 @@
+"""An all-zero extra_regressors matrix for run 1 must not discard the
+regressors of the other runs (matches the per-run handling in the matlab
+GLMestimatemodel.m)."""
+import numpy as np
+
+from glmsingle.hrf.gethrf import getcanonicalhrf
+from glmsingle.hrf.normalisemax import normalisemax
+from glmsingle.ols.glm_estimatemodel import glm_estimatemodel
+
+TR = 1.0
+LENGTHS = (100, 120)
+HRF = normalisemax(getcanonicalhrf(1, TR), dim='global')
+
+
+def make_inputs(seed=0):
+    rng = np.random.default_rng(seed)
+    design, data = [], []
+    for n in LENGTHS:
+        d = np.zeros((n, 2))
+        onsets = np.arange(5, n - 15, 6)
+        d[onsets, np.arange(len(onsets)) % 2] = 1
+        design.append(d)
+        data.append(100 + rng.standard_normal((30, n)))
+    return design, data, rng
+
+
+def fit(design, data, extra):
+    opt = {'extra_regressors': extra, 'maxpolydeg': [2, 2], 'suppressoutput': 1}
+    results = glm_estimatemodel(design, data, 1, TR, 'assume', HRF, 0, opt)[0]
+    return results['betasmd'], opt
+
+
+def test_zero_run1_keeps_other_runs_regressors():
+    design, data, rng = make_inputs()
+    extra = [np.zeros((LENGTHS[0], 3)), rng.standard_normal((LENGTHS[1], 3))]
+
+    betas, opt = fit(design, data, extra)
+
+    # run 2's regressors survive the defaults handling
+    assert opt['extra_regressors'][1] is extra[1]
+
+    # and were actually projected out: betas differ from a fit with no regressors
+    betas_none, _ = fit(design, data, [False])
+    assert not np.allclose(betas, betas_none)
+
+    # and match a fit where run 1 simply has no regressors (None)
+    betas_ref, _ = fit(design, data, [None, extra[1]])
+    assert np.allclose(betas, betas_ref)
+
+
+def test_empty_list_run_matches_none():
+    design, data, rng = make_inputs()
+    extra = rng.standard_normal((LENGTHS[1], 3))
+
+    betas_list, _ = fit(design, data, [[], extra])
+    betas_none, _ = fit(design, data, [None, extra])
+    assert np.allclose(betas_list, betas_none)
+
+    betas_list, _ = fit(design, data, [extra[:LENGTHS[0]], []])
+    betas_none, _ = fit(design, data, [extra[:LENGTHS[0]], None])
+    assert np.allclose(betas_list, betas_none)
diff --git a/tests/test_extra_regressors_models_cd.py b/tests/test_extra_regressors_models_cd.py
new file mode 100644
index 0000000..66d7aac
--- /dev/null
+++ b/tests/test_extra_regressors_models_cd.py
@@ -0,0 +1,69 @@
+"""Models C and D must keep the user's extra regressors, also when no
+GLMdenoise PCs are added (matches matlab GLMestimatesingletrial.m, cvnlab#213).
+"""
+import numpy as np
+import pytest
+
+import glmsingle.glmsingle as gs
+from glmsingle import GLM_single
+
+TR = 1.0
+LENGTHS = (100, 120)
+NREG = 3
+
+
+def make_data(nvox=50, ncond=4, seed=0):
+    rng = np.random.default_rng(seed)
+    design, data = [], []
+    for n in LENGTHS:
+        d = np.zeros((n, ncond))
+        onsets = np.arange(5, n - 15, 6)
+        d[onsets, np.arange(len(onsets)) % ncond] = 1
+        design.append(d)
+        data.append(100 + rng.standard_normal((nvox, n)))
+    return design, data
+
+
+@pytest.fixture
+def calls(monkeypatch):
+    """(wantfracridge, per-run extra regressors) of every multi-run fit."""
+    seen = []
+    real = gs.glm_estimatemodel
+
+    def spy(design, data, *args):
+        opt = args[-1]
+        if isinstance(design, list):
+            seen.append((opt.get('wantfracridge', 0),
+                         list(opt['extra_regressors'])))
+        return real(design, data, *args)
+
+    monkeypatch.setattr(gs, 'glm_estimatemodel', spy)
+    return seen
+
+
+@pytest.mark.parametrize('wantglmdenoise,wantfracridge', [(1, 0), (0, 1), (1, 1)])
+def test_user_regressors_in_models_c_and_d(tmp_path, calls,
+                                           wantglmdenoise, wantfracridge):
+    design, data = make_data()
+    rng = np.random.default_rng(1)
+    regs = [rng.standard_normal((n, NREG)) for n in LENGTHS]
+    opt = {'wantlibrary': 1, 'wantglmdenoise': wantglmdenoise,
+           'wantfracridge': wantfracridge, 'n_pcs': 2,
+           'extra_regressors': regs,
+           'wantfileoutputs': [0, 0, 0, 0], 'wantmemoryoutputs': [0, 0, 0, 1]}
+    GLM_single(opt).fit(design, data, 1, TR,
+                        outputdir=str(tmp_path / 'out'),
+                        figuredir=str(tmp_path / 'fig'))
+
+    assert calls
+    ncols = set()
+    for _, extra in calls:
+        for r, x in enumerate(extra):
+            # the user's regressors come first, any PCs are appended after
+            assert x is not None
+            np.testing.assert_array_equal(x[:, :NREG], regs[r])
+            ncols.add(x.shape[1])
+    # some fit used no PCs at all; before the fix it had no regressors
+    assert NREG in ncols
+    if wantfracridge:
+        assert any(fr for fr, _ in calls)
