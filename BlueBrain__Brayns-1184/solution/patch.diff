+        WORKING_DIRECTORY ${CMAKE_CURRENT_LIST_DIR}/libsonata/extlib/HighFive
+        RESULT_VARIABLE GIT_SUBMOD_RESULT
+        OUTPUT_QUIET)
+    if(NOT GIT_SUBMOD_RESULT EQUAL "0")
+        message(FATAL_ERROR "Could not update libsonata's HighFive dependency")
