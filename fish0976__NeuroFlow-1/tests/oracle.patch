+:root {
+  color-scheme: dark;
+  --bg: #080c0a;
+  --panel: #111815;
+  --panel-soft: #151d19;
+  --line: #28342e;
+  --text: #eef5ef;
+  --muted: #8d9b93;
+  --lime: #baf55a;
+  --cyan: #66dbc8;
+  --orange: #ff9f5c;
+  --red: #ff8875;
+  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+}
+
+* { box-sizing: border-box; }
+body { margin: 0; min-width: 320px; background: radial-gradient(circle at 80% 0, rgba(186, 245, 90, .1), transparent 28rem), var(--bg); color: var(--text); }
+a { color: inherit; }
+.app-shell { min-height: 100vh; }
+.topbar { height: 70px; display: flex; align-items: center; gap: 28px; padding: 0 max(24px, calc((100vw - 1180px) / 2)); border-bottom: 1px solid var(--line); }
+.brand { display: inline-flex; gap: 10px; align-items: center; text-decoration: none; font-weight: 700; letter-spacing: -.02em; }
+.brand-mark { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%; background: var(--lime); color: #10150d; font-weight: 800; }
+.nav-links { display: flex; gap: 18px; margin-left: auto; }
+.nav-links a { color: var(--muted); font-size: 13px; text-decoration: none; }
+.nav-links a:hover, .nav-links a.active { color: var(--lime); }
+.status-label { color: var(--muted); font-size: 12px; white-space: nowrap; }
+.status-label i { display: inline-block; width: 8px; height: 8px; margin-right: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 10px rgba(186, 245, 90, .7); }
+main { width: min(1180px, calc(100% - 48px)); margin: 0 auto; }
+.hero { min-height: 390px; display: grid; grid-template-columns: 1.2fr .8fr; gap: 64px; align-items: center; border-bottom: 1px solid var(--line); }
+.eyebrow { margin: 0 0 14px; color: var(--lime); font-size: 11px; font-weight: 700; letter-spacing: .16em; }
+h1 { margin: 0; max-width: 720px; font-size: clamp(48px, 7vw, 92px); line-height: .94; letter-spacing: -.065em; }
+h2 { margin: 0; font-size: clamp(25px, 3vw, 38px); letter-spacing: -.04em; }
+.hero-copy { max-width: 650px; margin: 28px 0 0; color: var(--muted); font-size: 16px; line-height: 1.75; }
+.shape-card { padding: 28px; background: var(--panel); border: 1px solid var(--line); border-radius: 20px; }
+.shape-card span { color: var(--muted); font-size: 11px; letter-spacing: .15em; }
+.shape-card strong { display: block; margin: 18px 0 8px; color: var(--lime); font: 700 clamp(28px, 4vw, 48px) Consolas, monospace; }
+.shape-card p, .source-note, .empty { margin: 0; color: var(--muted); }
+.controls { min-height: 88px; display: flex; align-items: center; gap: 14px; border-bottom: 1px solid var(--line); }
+label { display: flex; align-items: center; gap: 10px; color: var(--muted); font-size: 13px; }
+select, button { min-height: 40px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--panel-soft); color: var(--text); font: inherit; }
+select { min-width: 230px; }
+button { cursor: pointer; }
+button:hover, button:focus-visible, select:focus-visible { border-color: var(--lime); outline: none; }
+button.secondary { color: var(--muted); }
+.request-status { margin-left: auto; color: var(--muted); font-size: 13px; }
+.source-note { padding: 10px 0 0; font-size: 12px; line-height: 1.6; }
+.source-note span { display: block; color: var(--orange); }
+.telemetry { display: grid; grid-template-columns: 1.35fr 1.25fr repeat(3, 1fr); gap: 1px; margin-top: 22px; background: var(--line); border: 1px solid var(--line); border-radius: 15px; overflow: hidden; }
+.telemetry div { min-width: 0; padding: 15px; background: var(--panel); }
+.telemetry span { display: block; color: var(--muted); font-size: 11px; }
+.telemetry strong { display: block; margin-top: 6px; overflow: hidden; font: 700 13px Consolas, monospace; text-overflow: ellipsis; white-space: nowrap; }
+.layout { display: grid; grid-template-columns: 1.5fr .5fr; gap: 20px; margin-top: 20px; }
+.panel { padding: 22px; border: 1px solid var(--line); border-radius: 17px; background: var(--panel); }
+.section-title { display: flex; align-items: end; justify-content: space-between; gap: 12px; }
+.section-title span { color: var(--muted); font: 12px Consolas, monospace; }
+.chart-shell { height: 410px; margin-top: 20px; padding: 14px; border: 1px solid var(--line); border-radius: 13px; background: linear-gradient(180deg, rgba(255,255,255,.018), transparent); }
+canvas { width: 100%; height: 100%; display: block; }
+.inference-panel h2 { margin-bottom: 18px; }
+.stats { display: grid; gap: 1px; background: var(--line); }
+.stat { padding: 16px; background: var(--panel); }
+.stat span { display: block; color: var(--muted); font-size: 12px; }
+.stat strong { display: block; margin-top: 7px; font: 700 20px Consolas, monospace; }
+.history { margin-top: 18px; }
+.event { display: grid; grid-template-columns: 55px 1fr auto; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 12px; }
+.ok { color: var(--lime); }.bad { color: var(--red); }
+.hardware-path { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1px; margin-top: 22px; background: var(--line); border: 1px solid var(--line); border-radius: 15px; overflow: hidden; }
+.hardware-path div { min-height: 105px; padding: 17px; background: var(--panel); }.hardware-path b { color: var(--cyan); font: 700 11px Consolas, monospace; }.hardware-path strong { display: block; margin: 9px 0 5px; font-size: 14px; }.hardware-path p { margin: 0; color: var(--muted); font-size: 11px; line-height: 1.5; }
+.benchmark { margin: 22px 0 75px; }.bars { display: grid; gap: 12px; margin-top: 20px; }.bar-row { display: grid; grid-template-columns: 130px 1fr 70px; align-items: center; gap: 12px; font-size: 13px; }.track { height: 11px; overflow: hidden; border-radius: 9px; background: #202a25; }.fill { height: 100%; border-radius: 9px; background: var(--lime); }.fill.cyan { background: var(--cyan); }.bar-row strong { font: 700 13px Consolas, monospace; text-align: right; }
+footer { padding: 30px 24px; border-top: 1px solid var(--line); color: var(--muted); font-size: 12px; text-align: center; }
+@media (max-width: 850px) { .hero { grid-template-columns: 1fr; gap: 38px; padding: 64px 0; }.layout { grid-template-columns: 1fr; }.telemetry { grid-template-columns: 1fr 1fr; }.hardware-path { grid-template-columns: 1fr 1fr; }.request-status { width: 100%; margin: 0; }.controls { flex-wrap: wrap; padding: 20px 0; }.chart-shell { height: 330px; } }
+@media (max-width: 560px) { main { width: min(100% - 30px, 1180px); }.nav-links { display: none; }.telemetry, .hardware-path { grid-template-columns: 1fr; }.controls { align-items: stretch; flex-direction: column; }.controls label { justify-content: space-between; }.controls select { width: 100%; }.bar-row { grid-template-columns: 105px 1fr 55px; }.hero { min-height: auto; } }
diff --git a/frontend-vue/src/views/DashboardView.vue b/frontend-vue/src/views/DashboardView.vue
new file mode 100644
index 0000000..cf44c15
--- /dev/null
+++ b/frontend-vue/src/views/DashboardView.vue
@@ -0,0 +1,314 @@
+<script setup>
+import { computed, onBeforeUnmount, onMounted, ref } from "vue";
+
+const palette = ["#baf55a", "#66dbc8", "#ff9f5c"];
+const maxPoints = 640;
+const canvas = ref(null);
+const sourceItems = ref([]);
+const selectedSource = ref("physionet_replay");
+const status = ref("等待选择数据源");
+const socket = ref(null);
+const buffers = ref([[], [], []]);
+const events = ref([]);
+const sequence = ref(0);
+const prediction = ref("—");
+const actual = ref("—");
+const latency = ref("—");
+const benchmark = ref(null);
+const telemetry = ref({
+  source: "—",
+  deviceId: "—",
+  connection: "—",
+  sampling: "—",
+  packetLoss: "—",
+});
+
+const currentSource = computed(() =>
+  sourceItems.value.find((item) => item.id === selectedSource.value),
+);
+
+const benchmarkRows = computed(() => {
+  const summary = benchmark.value?.summary;
+  if (!summary) return [];
+  return [
+    { label: "CSP Accuracy", value: summary.csp_accuracy.mean, tone: "lime" },
+    { label: "CSP Macro-F1", value: summary.csp_f1.mean, tone: "lime" },
+    { label: "EEGNet Accuracy", value: summary.eegnet_accuracy.mean, tone: "cyan" },
+    { label: "EEGNet Macro-F1", value: summary.eegnet_f1.mean, tone: "cyan" },
+  ];
+});
+
+function setStatus(message) {
+  status.value = message;
+}
+
+function resizeCanvas() {
+  if (!canvas.value) return;
+  const ratio = window.devicePixelRatio || 1;
+  const rect = canvas.value.getBoundingClientRect();
+  canvas.value.width = Math.max(1, Math.floor(rect.width * ratio));
+  canvas.value.height = Math.max(1, Math.floor(rect.height * ratio));
+  const context = canvas.value.getContext("2d");
+  context.setTransform(ratio, 0, 0, ratio, 0, 0);
+}
+
+function drawChart() {
+  if (!canvas.value) return;
+  resizeCanvas();
+  const context = canvas.value.getContext("2d");
+  const width = canvas.value.clientWidth;
+  const height = canvas.value.clientHeight;
+  const laneHeight = height / 3;
+  context.clearRect(0, 0, width, height);
+  context.font = "12px system-ui";
+
+  buffers.value.forEach((data, channelIndex) => {
+    const centerY = laneHeight * (channelIndex + 0.5);
+    context.strokeStyle = "#28342e";
+    context.lineWidth = 1;
+    context.beginPath();
+    context.moveTo(0, centerY);
+    context.lineTo(width, centerY);
+    context.stroke();
+    context.fillStyle = "#8d9b93";
+    context.fillText(["C3", "Cz", "C4"][channelIndex], 10, centerY - 24);
+    if (!data.length) return;
+
+    const scale = Math.max(...data.map((value) => Math.abs(value)), 20);
+    context.strokeStyle = palette[channelIndex];
+    context.lineWidth = 1.1;
+    context.beginPath();
+    data.forEach((value, sampleIndex) => {
+      const x = (sampleIndex / Math.max(data.length - 1, 1)) * width;
+      const y = centerY - (value / scale) * laneHeight * 0.34;
+      if (sampleIndex === 0) context.moveTo(x, y);
+      else context.lineTo(x, y);
+    });
+    context.stroke();
+  });
+}
+
+function resetStreamState() {
+  buffers.value = [[], [], []];
+  events.value = [];
+  sequence.value = 0;
+  prediction.value = "—";
+  actual.value = "—";
+  latency.value = "—";
+  telemetry.value = {
+    source: "—",
+    deviceId: "—",
+    connection: "—",
+    sampling: "—",
+    packetLoss: "—",
+  };
+  drawChart();
+}
+
+function receiveMessage(message) {
+  if (message.type === "status") {
+    setStatus(message.message ? `${message.state} · ${message.message}` : message.state);
+  }
+  if (message.type === "error") setStatus(`错误 · ${message.message}`);
+  if (message.type === "device") {
+    telemetry.value = {
+      source: message.source.name,
+      deviceId: message.device_id,
+      connection: message.connection,
+      sampling: `${message.sampling_rate} Hz · ${message.model_channel_count} ch model`,
+      packetLoss: `${Number(message.packet_loss_percent).toFixed(2)}%`,
+    };
+  }
+  if (message.type === "signal") {
+    message.values_uv.forEach((values, channelIndex) => {
+      if (!buffers.value[channelIndex]) buffers.value[channelIndex] = [];
+      buffers.value[channelIndex].push(...values);
+      if (buffers.value[channelIndex].length > maxPoints) {
+        buffers.value[channelIndex].splice(0, buffers.value[channelIndex].length - maxPoints);
+      }
+    });
+    sequence.value = message.sequence;
+    drawChart();
+  }
+  if (message.type === "prediction") {
+    prediction.value = message.predicted;
+    actual.value = message.actual;
+    latency.value = `${message.latency_ms} ms`;
+    events.value.unshift({
+      trial: message.trial + 1,
+      result: `${message.predicted} / ${message.actual}`,
+      correct: message.correct,
+    });
+    events.value = events.value.slice(0, 8);
+  }
+}
+
+async function loadSources() {
+  try {
+    const response = await fetch("/api/sources");
+    if (!response.ok) throw new Error(`请求失败：${response.status}`);
+    const payload = await response.json();
+    sourceItems.value = payload.items;
+    selectedSource.value = payload.default;
+    setStatus("选择数据源后开始连接");
+  } catch (error) {
+    setStatus(`无法读取数据源：${error.message}`);
+  }
+}
+
+async function loadBenchmark() {
+  try {
+    const response = await fetch("/api/benchmark");
+    if (response.ok) benchmark.value = await response.json();
+  } catch {
+    benchmark.value = null;
+  }
+}
+
+function connect() {
+  stopStream(false);
+  resetStreamState();
+  const protocol = window.location.protocol === "https:" ? "wss" : "ws";
+  const url = `${protocol}://${window.location.host}/ws/stream?source=${encodeURIComponent(selectedSource.value)}`;
+  socket.value = new WebSocket(url);
+  setStatus("正在连接数据源…");
+  socket.value.onmessage = (event) => receiveMessage(JSON.parse(event.data));
+  socket.value.onerror = () => setStatus("连接失败，请确认 FastAPI 服务已启动");
+  socket.value.onclose = () => {
+    if (status.value.includes("running")) setStatus("连接已关闭");
+  };
+}
+
+function stopStream(updateStatus = true) {
+  if (socket.value) {
+    socket.value.close();
+    socket.value = null;
+  }
+  if (updateStatus) setStatus("已停止");
+}
+
+function openLegacy(path) {
+  window.location.href = path;
+}
+
+onMounted(() => {
+  window.addEventListener("resize", drawChart);
+  drawChart();
+  loadSources();
+  loadBenchmark();
+});
+
+onBeforeUnmount(() => {
+  window.removeEventListener("resize", drawChart);
+  stopStream(false);
+});
+</script>
+
+<template>
+  <div class="app-shell">
+    <header class="topbar">
+      <a class="brand" href="/">
+        <span class="brand-mark">N</span>
+        <span>NeuroFlow</span>
+      </a>
+      <nav class="nav-links" aria-label="主导航">
+        <a class="active" href="/">实时推理</a>
+        <a href="/quality">数据质量</a>
+        <a href="/static/real.html">模型对比</a>
+        <a href="/system">系统</a>
+      </nav>
+      <span class="status-label"><i></i> Device-ready</span>
+    </header>
+
+    <main>
+      <section class="hero">
+        <div>
+          <p class="eyebrow">PLUGGABLE EEG STREAM</p>
+          <h1>From electrodes<br />to decisions.</h1>
+          <p class="hero-copy">
+            用同一条 WebSocket 推理链路切换数据源。当前支持 PhysioNet 数据回放和模拟硬件传输，后续可以接入 LSL 或厂商 SDK。
+          </p>
+        </div>
+        <div class="shape-card">
+          <span>PIPELINE</span>
+          <strong>EEG → ML → UI</strong>
+          <p>Vue 3 · FastAPI · CSP + LDA · WebSocket</p>
+        </div>
+      </section>
+
+      <section class="controls">
+        <label for="source">数据源
+          <select id="source" v-model="selectedSource">
+            <option v-for="item in sourceItems" :key="item.id" :value="item.id" :disabled="!item.ready">
+              {{ item.name }}{{ item.ready ? "" : "（待接设备）" }}
+            </option>
+          </select>
+        </label>
+        <button type="button" @click="connect">连接并开始</button>
+        <button class="secondary" type="button" @click="stopStream()">停止</button>
+        <span class="request-status">{{ status }}</span>
+      </section>
+      <p v-if="currentSource" class="source-note">
+        {{ currentSource.description }}
+        <span v-if="currentSource.simulated">当前为传输协议模拟，信号仍来自公开 EEG 数据。</span>
+      </p>
+
+      <section class="telemetry">
+        <div><span>Source</span><strong>{{ telemetry.source }}</strong></div>
+        <div><span>Device ID</span><strong>{{ telemetry.deviceId }}</strong></div>
+        <div><span>Connection</span><strong>{{ telemetry.connection }}</strong></div>
+        <div><span>Sampling</span><strong>{{ telemetry.sampling }}</strong></div>
+        <div><span>Packet loss</span><strong>{{ telemetry.packetLoss }}</strong></div>
+      </section>
+
+      <section class="layout">
+        <div class="panel">
+          <p class="eyebrow">STREAMED SIGNAL</p>
+          <div class="section-title"><h2>C3 · Cz · C4</h2><span>μV</span></div>
+          <div class="chart-shell"><canvas ref="canvas" aria-label="实时 EEG 波形"></canvas></div>
+        </div>
+        <aside class="panel inference-panel">
+          <p class="eyebrow">INFERENCE</p>
+          <h2>在线状态</h2>
+          <div class="stats">
+            <div class="stat"><span>Prediction</span><strong>{{ prediction }}</strong></div>
+            <div class="stat"><span>Actual</span><strong>{{ actual }}</strong></div>
+            <div class="stat"><span>Latency</span><strong>{{ latency }}</strong></div>
+            <div class="stat"><span>Sequence</span><strong>{{ sequence }}</strong></div>
+          </div>
+          <div class="history">
+            <div v-for="event in events" :key="`${event.trial}-${event.result}`" class="event">
+              <span>Trial {{ event.trial }}</span><span>{{ event.result }}</span>
+              <span :class="event.correct ? 'ok' : 'bad'">{{ event.correct ? "正确" : "错误" }}</span>
+            </div>
+            <p v-if="!events.length" class="empty">连接后显示预测记录</p>
+          </div>
+        </aside>
+      </section>
+
+      <section class="hardware-path">
+        <div><b>01</b><strong>电极与放大器</strong><p>安全隔离的 EEG 采集设备</p></div>
+        <div><b>02</b><strong>设备适配器</strong><p>USB、蓝牙、TCP、LSL 或 SDK</p></div>
+        <div><b>03</b><strong>数据缓冲</strong><p>时间戳、丢包检查和 4 秒窗口</p></div>
+        <div><b>04</b><strong>模型推理</strong><p>与硬件通道一致的个人模型</p></div>
+        <div><b>05</b><strong>WebSocket</strong><p>波形、质量与预测送到网页</p></div>
+      </section>
+
+      <section class="panel benchmark">
+        <p class="eyebrow">5-SUBJECT BENCHMARK</p>
+        <h2>跨运行平均性能</h2>
+        <div v-if="benchmarkRows.length" class="bars">
+          <div v-for="row in benchmarkRows" :key="row.label" class="bar-row">
+            <span>{{ row.label }}</span>
+            <div class="track"><div class="fill" :class="row.tone" :style="{ width: `${row.value * 100}%` }"></div></div>
+            <strong>{{ (row.value * 100).toFixed(1) }}%</strong>
+          </div>
+        </div>
+        <p v-else class="empty">暂无基准结果，请先运行多被试实验。</p>
+      </section>
+    </main>
+    <footer>
+      NeuroFlow · research prototype · 不用于医疗诊断或治疗决策
+    </footer>
+  </div>
+</template>
