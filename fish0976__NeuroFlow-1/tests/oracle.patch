diff --git a/run_fullstack.ps1 b/run_fullstack.ps1
index 0a65af9..7d966ae 100644
--- a/run_fullstack.ps1
+++ b/run_fullstack.ps1
@@ -1,3 +1,19 @@
+$frontendRoot = Join-Path $PSScriptRoot "frontend-vue"
+$frontendIndex = Join-Path $frontendRoot "dist\index.html"
+if (-not (Test-Path -LiteralPath $frontendIndex)) {
+    if (-not (Get-Command npm.cmd -ErrorAction SilentlyContinue)) {
+        throw "Node.js/npm not found."
+    }
+    Push-Location $frontendRoot
+    try {
+        npm.cmd install
+        if ($LASTEXITCODE -ne 0) { throw "Vue dependency installation failed." }
+        npm.cmd run build
+        if ($LASTEXITCODE -ne 0) { throw "Vue frontend build failed." }
+    } finally {
+        Pop-Location
+    }
