+
+    Hide the colorbar:
+
+    >>> pl = pv_plot_surface(  # doctest: +SKIP
+    ...     (data_L, data_R),
+    ...     template="fsaverage5",
+    ...     surf="inflated",
+    ...     show_colorbar=False,
+    ... )
+
+    **Colormap and limits:**
+
+    Use different colormaps and set explicit color limits:
+
+    >>> pl = pv_plot_surface(  # doctest: +SKIP
+    ...     (data_L, data_R),
+    ...     template="fsaverage5",
+    ...     surf="inflated",
+    ...     cmap="RdBu_r",  # Reverse red-blue colormap
+    ...     clim=(-3, 3),   # Symmetric limits
+    ... )
+
+    Sequential colormap for positive-only data:
+
+    >>> pl = pv_plot_surface(  # doctest: +SKIP
+    ...     (data_L, data_R),
+    ...     template="fsaverage5",
+    ...     surf="inflated",
+    ...     cmap="plasma",
+    ...     clim=(0, 1),
+    ... )
+
+    **Saving figures:**
+
+    Save as high-resolution PNG:
+
+    >>> pl = pv_plot_surface(  # doctest: +SKIP
+    ...     (data_L, data_R),
