+
+def test_too_many_groups_raises() -> None:
+    """More groups than the categorical palette supports raises ValueError."""
+
+    model = _LinearNet()
+    traces = [tl.log_forward_pass(model, torch.rand(2, 4)) for _ in range(11)]
+    names = [f"t{i}" for i in range(11)]
