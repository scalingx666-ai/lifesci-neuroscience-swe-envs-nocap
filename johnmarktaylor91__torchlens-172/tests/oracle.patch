+# ---------------------------------------------------------------------------
+# Bonus: a couple of internal-consistency checks discovered while writing
+# the spec'd 15 -- helpful for catching regressions later but cheap to run.
+# ---------------------------------------------------------------------------
+
+
+def test_invalid_mode_raises() -> None:
