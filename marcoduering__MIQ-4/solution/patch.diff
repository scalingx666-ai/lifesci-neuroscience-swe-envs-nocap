+        case .uint32:
+            writeBits(UInt32(clamping: Int(value)), at: base, bigEndian: bigEndian, into: &payload)
+        case .float32:
+            writeBits(Float32(value).bitPattern, at: base, bigEndian: bigEndian, into: &payload)
+        case .float64:
