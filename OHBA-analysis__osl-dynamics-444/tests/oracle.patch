+    def build(self, var_list: List[tf.Variable]) -> None:
+        super().build(var_list)
+        base_vars = [v for v in var_list if id(v) not in self.ema_variable_ids]
+        ema_vars = [v for v in var_list if id(v) in self.ema_variable_ids]
