+%       getUnit('mmol/l')  returns 'mol/l', -3
+%       getUnit('pA')      returns 'A', -12
+
+    % SI prefix symbols and corresponding powers of ten
+    prefixes = {'y','z','a','f','p','n','\mu','m','','k','M','G','T','P','E','Z','Y'};
