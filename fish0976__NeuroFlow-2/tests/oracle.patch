+name: Codex contribution
+
+on:
+  workflow_dispatch:
+    inputs:
+      task:
+        description: "让 Codex 完成一个小而可审核的项目任务"
+        required: true
+        default: "为现有 OpenBCI 数据流适配器补充一条回归测试，并在 docs/ 中说明测试场景；不要修改工作流、密钥或删除文件。"
+
+permissions:
+  contents: write
+  pull-requests: write
+
+jobs:
+  codex:
+    name: Run Codex and open a contribution PR
+    runs-on: ubuntu-latest
+    timeout-minutes: 25
+    env:
+      CODEX_BRANCH: codex/contribution-${{ github.run_id }}
+
+    steps:
+      - name: Check out the selected branch
+        uses: actions/checkout@v6
+        with:
+          fetch-depth: 0
+
+      - name: Run Codex
+        uses: openai/codex-action@v1
+        with:
+          openai-api-key: ${{ secrets.OPENAI_API_KEY }}
+          sandbox: workspace-write
+          safety-strategy: drop-sudo
+          prompt: |
+            Make one small, reviewable contribution to this repository.
+
+            Task:
+            ${{ inputs.task }}
+
+            Rules:
+            - Inspect the existing project before editing.
+            - Keep the change limited to the requested task.
+            - Do not edit .github/workflows, secrets, credentials, or deployment settings.
+            - Do not delete files or rewrite unrelated code.
+            - Run the narrowest relevant tests or checks when possible.
+            - Leave the working tree with only the intended changes; do not create a commit.
+
+      - name: Commit Codex changes and open a pull request
+        shell: bash
+        env:
+          GH_TOKEN: ${{ github.token }}
+          BASE_BRANCH: ${{ github.ref_name }}
+        run: |
+          set -euo pipefail
+
+          if git diff --quiet && [ -z "$(git ls-files --others --exclude-standard)" ]; then
+            echo "Codex did not produce any changes."
+            exit 1
+          fi
+
+          git switch -c "$CODEX_BRANCH"
+          git config user.name "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+          git add -A
+          git commit -m "chore: add Codex-assisted contribution"
+          git push --set-upstream origin "$CODEX_BRANCH"
+
+          gh pr create \
+            --base "$BASE_BRANCH" \
+            --head "$CODEX_BRANCH" \
+            --title "Codex-assisted contribution" \
+            --body "This pull request contains one scoped change generated with the official OpenAI Codex GitHub Action. Please review the diff and merge it only after the checks pass."
