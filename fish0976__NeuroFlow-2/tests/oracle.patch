+import unittest
+
+from app.eeg_sources import create_source, list_sources
+
+
+class CytonAdapterTests(unittest.TestCase):
+    def test_cyton_source_is_catalogued_as_live(self) -> None:
+        sources = {item["id"]: item for item in list_sources()}
+        self.assertIn("openbci_cyton", sources)
+        self.assertEqual(sources["openbci_cyton"]["mode"], "live")
+        self.assertFalse(sources["openbci_cyton"]["simulated"])
+
+    def test_cyton_adapter_is_lazy(self) -> None:
+        source = create_source("openbci_cyton")
+        self.assertTrue(source.live)
+        self.assertEqual(source.device_id, "OPENBCI-CYTON")
+        self.assertEqual(len(source.channel_names), 8)
+
+
+if __name__ == "__main__":
+    unittest.main()
+
