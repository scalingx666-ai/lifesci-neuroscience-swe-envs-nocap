+async def _stream_live_eeg(websocket: WebSocket, source: object) -> None:
+    """Forward live packets without pretending the PhysioNet model is calibrated."""
+
+    await asyncio.to_thread(source.connect)
+    sampling_rate = int(source.sampling_rate)
+    all_channels = list(source.channel_names)
+    display_count = min(3, len(all_channels))
+    display_indices = list(range(display_count))
+    display_names = all_channels[:display_count]
+    chunk_size = max(1, sampling_rate // 10)
+    sequence = 0
+
+    device = source.device_status(sampling_rate, display_names)
+    device.update({
+        "model_channel_count": 0,
+        "model_window_seconds": 4.0,
+        "model_status": "not_calibrated",
+        "prediction_available": False,
+    })
+    await websocket.send_json(device)
+    await websocket.send_json({
+        "type": "status",
+        "state": "running",
+        "source_id": source.descriptor.id,
+        "sampling_rate": sampling_rate,
+        "chunk_size": chunk_size,
+        "channels": display_names,
+        "message": "实时 EEG 已连接；当前仅显示和记录，尚未启用 Cyton 专用模型。",
+    })
+
+    try:
+        while True:
+            packet = await asyncio.to_thread(
+                source.read_packet,
+                display_indices,
+                display_names,
+                chunk_size,
+                sequence,
+            )
+            if packet is None:
+                await asyncio.sleep(0.02)
+                continue
+            await websocket.send_json(packet)
+            sequence += 1
+    finally:
+        await asyncio.to_thread(source.close)
+
