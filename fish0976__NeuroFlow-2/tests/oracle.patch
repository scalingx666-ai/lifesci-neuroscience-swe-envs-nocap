+CYTON_SOURCE_ID = "openbci_cyton"
+
+
+def _cyton_channel_names() -> list[str]:
+    configured = os.getenv("NEUROFLOW_CYTON_CHANNELS", "").strip()
+    if configured:
+        names = [item.strip() for item in configured.split(",") if item.strip()]
+        if len(names) == 8:
+            return names
+    return [f"CH{index}" for index in range(1, 9)]
+
+
+def _cyton_descriptor() -> SourceDescriptor:
+    brainflow_installed = importlib.util.find_spec("brainflow") is not None
+    serial_configured = bool(os.getenv("NEUROFLOW_CYTON_SERIAL_PORT", "").strip())
+    ready = brainflow_installed and serial_configured
+    if ready:
+        description = "OpenBCI Cyton 8 通道实时 EEG；通过 BrainFlow 读取串口数据。"
+    elif not brainflow_installed:
+        description = "需要安装可选 BrainFlow 依赖；当前仍未启用真实设备。"
+    else:
+        description = "已安装 BrainFlow，但尚未配置 NEUROFLOW_CYTON_SERIAL_PORT。"
+    return SourceDescriptor(
+        id=CYTON_SOURCE_ID,
+        name="OpenBCI Cyton 实时设备",
+        description=description,
+        transport="BrainFlow / serial",
+        ready=ready,
+        simulated=False,
+        mode="live",
+    )
+
+
+class BrainFlowCytonSource(EEGPacketSource):
+    """Optional OpenBCI Cyton adapter.
+
+    BrainFlow is imported only after connect() is called, so replay and demo
+    installations do not need the optional package. Data is passed through in
+    microvolts; model calibration is intentionally handled elsewhere.
+    """
+
+    descriptor = _cyton_descriptor()
+    device_id = "OPENBCI-CYTON"
+    connection = "BrainFlow / serial"
+    live = True
+    replay_speed = 0.0
+
+    def __init__(self) -> None:
+        self.descriptor = _cyton_descriptor()
+        self.serial_port = os.getenv("NEUROFLOW_CYTON_SERIAL_PORT", "").strip()
+        self.channel_names = _cyton_channel_names()
+        self._board = None
+        self._eeg_channels: list[int] = []
+        self._pending = np.empty((8, 0), dtype=np.float64)
+        self._sample_start = 0
+        self.sampling_rate = 250
+
+    def packet(
+        self,
+        epoch: np.ndarray,
+        display_indices: list[int],
+        display_names: list[str],
+        start: int,
+        chunk_size: int,
+        sequence: int,
+        trial: int,
+        sampling_rate: int,
+    ) -> dict[str, object]:
+        raise RuntimeError("BrainFlowCytonSource uses read_packet(), not replay packet().")
+
+    def connect(self) -> None:
+        if not self.serial_port:
+            raise RuntimeError(
+                "未配置 OpenBCI 串口。请先设置 NEUROFLOW_CYTON_SERIAL_PORT，例如 COM3。"
+            )
+        if importlib.util.find_spec("brainflow") is None:
+            raise RuntimeError(
+                "未安装 BrainFlow。请运行 pip install -r requirements-hardware.txt。"
+            )
+
+        from brainflow.board_shim import BoardIds, BoardShim, BrainFlowInputParams
+
+        params = BrainFlowInputParams()
+        params.serial_port = self.serial_port
+        board = BoardShim(BoardIds.CYTON_BOARD, params)
+        try:
+            board.prepare_session()
+            board.start_stream()
+        except Exception:
+            try:
+                board.release_session()
+            except Exception:
+                pass
+            raise
+
+        self._board = board
+        self._eeg_channels = list(BoardShim.get_eeg_channels(BoardIds.CYTON_BOARD))
+        self.sampling_rate = int(BoardShim.get_sampling_rate(BoardIds.CYTON_BOARD))
+        self._pending = np.empty((len(self._eeg_channels), 0), dtype=np.float64)
+
+    def read_packet(
+        self,
+        display_indices: list[int],
+        display_names: list[str],
+        chunk_size: int,
+        sequence: int,
+    ) -> dict[str, object] | None:
+        if self._board is None:
+            raise RuntimeError("OpenBCI Cyton 尚未连接。")
+
+        incoming = self._board.get_board_data()
+        if incoming.size:
+            eeg = np.asarray(incoming[self._eeg_channels], dtype=np.float64)
+            self._pending = np.concatenate((self._pending, eeg), axis=1)
+
+        if self._pending.shape[1] < chunk_size:
+            return None
+
+        chunk = self._pending[:, :chunk_size]
+        self._pending = self._pending[:, chunk_size:]
+        pairs = [
+            (position, index)
+            for position, index in enumerate(display_indices)
+            if 0 <= index < chunk.shape[0]
+        ]
+        values = chunk[[index for _, index in pairs]]
+        names = [display_names[position] for position, _ in pairs]
+        packet = {
+            "type": "signal",
+            "source_id": self.descriptor.id,
+            "device_id": self.device_id,
+            "sequence": sequence,
+            "transport_sequence": sequence,
+            "sample_start": self._sample_start,
+            "timestamp_ms": round(time() * 1000, 3),
+            "sampling_rate": self.sampling_rate,
+            "channels": names,
+            "values_uv": np.round(values, 3).tolist(),
+            "signal_quality": "good" if np.isfinite(values).all() else "invalid",
+        }
+        self._sample_start += chunk_size
+        return packet
+
+    def device_status(self, sampling_rate: int, channels: list[str]) -> dict[str, object]:
+        status = super().device_status(sampling_rate, channels)
+        status.update({
+            "total_channel_count": len(self.channel_names),
+            "model_status": "not_calibrated",
+            "prediction_available": False,
+        })
+        return status
+
+    def close(self) -> None:
+        if self._board is None:
+            return
+        try:
+            self._board.stop_stream()
+        finally:
+            self._board.release_session()
+            self._board = None
+
