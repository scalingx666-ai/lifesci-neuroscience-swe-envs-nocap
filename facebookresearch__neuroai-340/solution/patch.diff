new file mode 100644
index 000000000..c4317c7ef
--- /dev/null
+++ b/docs/scripts/test_publish_docs.py
@@ -0,0 +1,58 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the license found in the
+# LICENSE file in the root directory of this source tree.
+
+import json
+from pathlib import Path
+
+import pytest
+from publish_docs import publish
+
+_SOURCE = "https://github.com/facebookresearch/neuroai/blob/main/x.py"
+
+
+def _build(path: Path, marker: str) -> Path:
+    for rel in ["index.html", "sub/page.html"]:
+        (path / rel).parent.mkdir(parents=True, exist_ok=True)
+        (path / rel).write_text(
+            f'<html><head></head><a href="{_SOURCE}">{marker}</a></html>'
+        )
+    (path / "objects.inv").write_text(marker)
+    return path
+
+
+def test_publish(tmp_path: Path) -> None:
+    site = tmp_path / "site"
+    (site / "neuralset").mkdir(parents=True)
+    (site / "neuralset/index.html").write_text("legacy")
+    (site / "CNAME").write_text("docs.example.org")
+    publish(site, _build(tmp_path / "main", "main"), "main")
+    assert (site / "neuralset/index.html").read_text() == "legacy", "kept until a release"
+    page = (site / "dev/sub/page.html").read_text()
+    assert 'src="../../version_switcher.js" data-version="dev"' in page
+    assert _SOURCE in page and "noindex" in page
+    publish(site, _build(tmp_path / "v041", "v0.4.1"), "v0.4.1")
+    publish(site, _build(tmp_path / "v032", "v0.3.2"), "v0.3.2")  # backport
+    assert json.loads((site / "versions.json").read_text()) == {
+        "stable": "0.4",
+        "versions": ["dev", "0.4", "0.3"],
+        "tags": {"0.4": "v0.4.1", "0.3": "v0.3.2"},
+    }
+    stable = (site / "stable/index.html").read_text()
+    assert "v0.4.1" in stable, "backport must not replace stable/"
+    assert "blob/v0.4.1/x.py" in stable and "noindex" not in stable
+    assert "../stable/sub/page.html" in (site / "sub/page.html").read_text()
+    legacy = (site / "neuralset/index.html").read_text()
+    assert "../stable/index.html" in legacy, "legacy route missing from stable/ dropped"
+    assert (site / "objects.inv").read_text() == "v0.4.1"
+    assert (site / "dev/index.html").exists(), "root cleanup deleted a version"
+    assert (site / "CNAME").exists(), "root cleanup deleted CNAME"
+    assert (site / "404.html").exists(), "root cleanup deleted 404.html"
+    for ref, error in [
+        ("v0.4.0", "older than the published v0.4.1"),
+        ("v0.5.0rc1", "vX.Y.Z"),
+    ]:
+        with pytest.raises(ValueError, match=error):
+            publish(site, tmp_path / "main", ref)
diff --git a/docs/scripts/version_switcher.js b/docs/scripts/version_switcher.js
new file mode 100644
index 000000000..93497289f
--- /dev/null
+++ b/docs/scripts/version_switcher.js
@@ -0,0 +1,62 @@
+// Version switcher and outdated-version banner, injected by publish_docs.py
+(() => {
+  const script = document.currentScript;
+  if (window.self !== window.top) return; // iframed widgets
+  const current = script.dataset.version; // "dev", "stable" or "X.Y"
+  const root = new URL(script.dataset.root, location.href);
+  const page = (location.origin + location.pathname).slice(
+    new URL(`${current}/`, root).href.length,
+  );
+
+  // same page in `version`, else its index
+  const resolve = async (version) => {
+    const index = new URL(`${version}/`, root);
+    const target = new URL(page, index);
+    const found = await fetch(target, { method: "HEAD" }).then((r) => r.ok, () => false);
+    return found ? target.href + location.search + location.hash : index.href;
+  };
+
+  fetch(new URL("versions.json", root))
+    .then((r) => r.json())
+    .then(({ stable, versions }) => {
+      const shown = current === "stable" ? stable : current;
+      const style = document.createElement("style");
+      style.textContent = `
+        .version-switcher {
+          display: block; margin: 0 auto 1rem; padding: 0.2rem 0.4rem; font: inherit;
+          color: var(--color-foreground-primary); background: var(--color-background-primary);
+          border: 1px solid var(--color-background-border); border-radius: 0.2rem;
+        }
+        .version-banner {
+          padding: 0.5rem 1rem; text-align: center;
+          background: var(--color-announcement-background, #000000dd);
+          color: var(--color-announcement-text, #eeebee);
+        }
+        .version-banner a { color: inherit; text-decoration: underline; }
+      `;
+      document.head.append(style);
+
+      const select = document.createElement("select");
+      select.className = "version-switcher";
+      select.setAttribute("aria-label", "Documentation version");
+      for (const v of versions) {
+        const label = v === "dev" ? "dev (main)" : v === stable ? `${v} (stable)` : v;
+        select.add(new Option(label, v === stable ? "stable" : v, false, v === shown));
+      }
+      select.onchange = async () => {
+        location.href = await resolve(select.value);
+      };
+      const brand = document.querySelector(".sidebar-brand"); // furo
+      brand ? brand.after(select) : document.body.prepend(select);
+
+      if (stable === null || shown === stable) return;
+      const banner = document.createElement("div");
+      banner.className = "version-banner";
+      const what = current === "dev" ? "the development version (main)" : `version ${current}`;
+      banner.innerHTML = `You are reading the documentation of ${what}. <a>Go to the stable version (${stable})</a>.`;
+      const link = banner.querySelector("a");
+      link.href = new URL("stable/", root).href;
+      resolve("stable").then((href) => (link.href = href));
+      document.body.prepend(banner);
+    });
+})();
