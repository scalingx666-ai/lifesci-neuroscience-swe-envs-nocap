new file mode 100644
index 000000000..acd5cfb85
--- /dev/null
+++ b/.github/workflows/docs.yml
@@ -0,0 +1,96 @@
+name: Docs
+# published layout: see docs/scripts/publish_docs.py
+
+permissions:
+  contents: read
+
+concurrency:
+  group: docs-${{ github.event.pull_request.number || inputs.ref || github.ref_name }}
+  cancel-in-progress: true
+
+on:
+  push:
+    branches: [main]
+    tags: ['v[0-9]+.[0-9]+.[0-9]+']
+  pull_request:
+    paths: ['docs/**', '.github/workflows/docs.yml']
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Branch or release tag to build and publish (e.g. v0.4.0)
+        required: true
+        default: main
+
+jobs:
+  # read-only: tutorials and PR code run here
+  build-docs:
+    name: Build documentation
+    # Require 8-core machines (Github Actions Larger Runners) to have more than 14GB disk space
+    runs-on: 8-core-ubuntu  # ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref || github.ref }}
+          persist-credentials: false
+      # publishing scripts from the workflow commit: an old tag may predate them
+      - uses: actions/checkout@v4
+        with:
+          path: publish-tools
+          sparse-checkout: docs/scripts
+          persist-credentials: false
+      - uses: ./.github/actions/setup-python-env
+
+      - name: Test publishing script
+        run: |
+          source .venv/bin/activate
+          pytest publish-tools/docs/scripts/test_publish_docs.py
+
+      - name: Install Sphinx extras
+        run: |
+          source .venv/bin/activate
+          pip install sphinx furo myst_parser sphinx_rtd_theme sphinx-copybutton sphinx-design sphinx-gallery
+
+      - name: Sphinx build
+        run: |
+          source .venv/bin/activate
+          make -C docs html
+
+      - uses: actions/upload-artifact@v4
+        with:
+          name: docs-html
+          path: docs/_build/html
+          retention-days: 14
+
+  publish-docs:
+    name: Publish documentation
+    needs: build-docs
+    if: github.event_name != 'pull_request'
+    runs-on: ubuntu-latest
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          sparse-checkout: docs/scripts
+      - uses: actions/download-artifact@v4
+        with:
+          name: docs-html
+          path: html
+      - name: Push to gh-pages
+        env:
+          REF: ${{ inputs.ref || github.ref_name }}
+        run: |
+          export GIT_AUTHOR_NAME=github-actions[bot] GIT_AUTHOR_EMAIL=41898282+github-actions[bot]@users.noreply.github.com
+          export GIT_COMMITTER_NAME=$GIT_AUTHOR_NAME GIT_COMMITTER_EMAIL=$GIT_AUTHOR_EMAIL
+          # single orphan commit keeps the branch small; the lease retries concurrent deploys
+          for attempt in 1 2 3; do
+            git fetch --depth 1 origin gh-pages
+            lease=$(git rev-parse FETCH_HEAD)
+            git worktree add --force site "$lease"
+            python3 docs/scripts/publish_docs.py site html "$REF"
+            git -C site add --all
+            commit=$(git -C site commit-tree "$(git -C site write-tree)" -m "Publish docs for $REF")
+            git push --force-with-lease="gh-pages:$lease" origin "$commit:refs/heads/gh-pages" && exit 0
+            git worktree remove --force site
+          done
+          exit 1
diff --git a/docs/scripts/404.html b/docs/scripts/404.html
new file mode 100644
index 000000000..3dadf59b6
--- /dev/null
+++ b/docs/scripts/404.html
@@ -0,0 +1,23 @@
+<!DOCTYPE html>
+<html><head><meta charset="utf-8"><title>Page not found</title>
+<script>
+// published by publish_docs.py: retry a missing URL in stable/ then dev/, else a version index
+(async () => {
+  const exists = (url) => fetch(url, { method: "HEAD" }).then((r) => r.ok, () => false);
+  const parts = location.pathname.split("/");
+  for (let i = 1; i < parts.length; i++) {
+    const base = parts.slice(0, i).join("/") + "/";
+    const index = await fetch(base + "versions.json").then((r) => (r.ok ? r.json() : null), () => null);
+    if (index === null) continue;
+    const path = parts.slice(i).join("/");
+    const candidates = ["stable", ...index.versions].includes(parts[i])
+      ? [`${base}${parts[i]}/`]
+      : [`${base}stable/${path}`, `${base}dev/${path}`, `${base}stable/`, `${base}dev/`];
+    for (const url of candidates) {
+      if (await exists(url)) return location.replace(url + location.search + location.hash);
+    }
+    return;
+  }
+})();
+</script>
+</head><body><p>Page not found.</p></body></html>
diff --git a/docs/scripts/publish_docs.py b/docs/scripts/publish_docs.py
new file mode 100644
index 000000000..ec1f8b0da
--- /dev/null
+++ b/docs/scripts/publish_docs.py
@@ -0,0 +1,114 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Publish a Sphinx HTML build into the versioned gh-pages tree: ``dev/`` (main),
+``X.Y/`` (latest vX.Y.* tag), ``stable/`` (copy of the highest X.Y), ``versions.json``,
+redirects from the unversioned root URLs to ``stable/`` and a ``404.html`` retrying
+missing URLs in ``stable/`` then ``dev/``.
+"""
+
+import argparse
+import json
+import re
+import shutil
+from pathlib import Path
+
+_SWITCHER = Path(__file__).with_name("version_switcher.js")
+_NOT_FOUND = Path(__file__).with_name("404.html")
+_KEEP = {".git", ".nojekyll", "CNAME", "robots.txt", "404.html", "versions.json"}
+_BLOB = "https://github.com/facebookresearch/neuroai/blob/"
+_REDIRECT = """<!DOCTYPE html>
+<html><head><meta charset="utf-8"><title>Redirecting</title>
+<meta http-equiv="refresh" content="0; url={target}">
+<script>location.replace("{target}" + location.search + location.hash)</script>
+</head></html>
+"""
+
+
+def _version_dir(ref: str) -> str:
+    if ref == "main":
+        return "dev"
+    match = re.fullmatch(r"v(\d+)\.(\d+)\.\d+", ref)
+    if match is None:
+        raise ValueError(
+            f"Cannot publish docs for ref {ref!r}: expected 'main' or a vX.Y.Z tag"
+        )
+    return f"{match[1]}.{match[2]}"
+
+
+def _number(version: str) -> tuple[int, ...]:
+    return tuple(int(x) for x in re.findall(r"\d+", version))
+
+
+def _copy_build(build: Path, dest: Path, version: str, ref: str) -> None:
+    shutil.rmtree(dest, ignore_errors=True)
+    shutil.copytree(build, dest)
+    for page in dest.rglob("*.html"):
+        root = "../" * len(page.relative_to(dest).parts)
+        tag = f'<script defer src="{root}{_SWITCHER.name}" data-version="{version}" data-root="{root}"></script>'
+        if version != "stable":  # search engines index stable/ only
+            tag += '<meta name="robots" content="noindex">'
+        html = page.read_text(encoding="utf8").replace("</head>", tag + "</head>", 1)
+        if ref != "main":  # source links to the tag (edit links stay on main)
+            html = html.replace(f"{_BLOB}main/", f"{_BLOB}{ref}/")
+        page.write_text(html, encoding="utf8")
+
+
+def _write_root_redirects(site: Path, keep: set[str]) -> None:
+    old = [entry for entry in site.iterdir() if entry.name not in keep]
+    routes = {
+        p.relative_to(site)
+        for entry in old
+        for p in ([entry] if entry.is_file() else entry.rglob("*.html"))
+        if p.suffix == ".html"
+    }
+    for entry in old:
+        shutil.rmtree(entry) if entry.is_dir() else entry.unlink()
+    stable = site / "stable"
+    pages = {p.relative_to(stable) for p in stable.rglob("*.html")}
+    for rel in pages | routes:  # routes missing from stable/ go to its index
+        dest = rel if rel in pages else Path("index.html")
+        target = "../" * (len(rel.parts) - 1) + f"stable/{dest.as_posix()}"
+        (site / rel).parent.mkdir(parents=True, exist_ok=True)
+        (site / rel).write_text(_REDIRECT.format(target=target), encoding="utf8")
+    shutil.copy(stable / "objects.inv", site / "objects.inv")  # intersphinx
+
+
+def publish(site: Path, build: Path, ref: str) -> None:
+    version = _version_dir(ref)
+    index = site / "versions.json"
+    tags = json.loads(index.read_text())["tags"] if index.exists() else {}
+    published = tags.get(version)
+    if version != "dev" and published is not None and _number(published) > _number(ref):
+        raise ValueError(f"{ref} is older than the published {published} of {version}/")
+    _copy_build(build, site / version, version, ref)
+    if version != "dev":
+        tags[version] = ref
+    releases = sorted(
+        (d.name for d in site.iterdir() if re.fullmatch(r"\d+\.\d+", d.name)),
+        key=_number,
+        reverse=True,
+    )
+    versions = (["dev"] if (site / "dev").is_dir() else []) + releases
+    stable = releases[0] if releases else None
+    index.write_text(
+        json.dumps({"stable": stable, "versions": versions, "tags": tags}, indent=2)
+    )
+    shutil.copy(_SWITCHER, site / _SWITCHER.name)
+    shutil.copy(_NOT_FOUND, site / _NOT_FOUND.name)
+    (site / ".nojekyll").touch()
+    if version == stable:
+        _copy_build(build, site / "stable", "stable", ref)
+        _write_root_redirects(site, _KEEP | {_SWITCHER.name, "stable", *versions})
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("site", type=Path, help="gh-pages checkout")
+    parser.add_argument("build", type=Path, help="Sphinx HTML output")
+    parser.add_argument("ref", help="'main' or a vX.Y.Z tag")
+    args = parser.parse_args()
+    publish(args.site, args.build, args.ref)
