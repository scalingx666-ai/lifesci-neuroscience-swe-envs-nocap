+# ============================================================================
+# Backward FLOPs multipliers
+# ============================================================================
+
+BACKWARD_MULTIPLIERS: Dict[str, float] = {
+    # Convolution / linear: dL/dX + dL/dW ≈ 2x forward
+    "conv1d": 2.0,
+    "conv2d": 2.0,
+    "conv3d": 2.0,
+    "conv_transpose1d": 2.0,
+    "conv_transpose2d": 2.0,
