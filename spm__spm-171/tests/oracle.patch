diff --git a/.github/fieldtrip-mex-excludes b/.github/fieldtrip-mex-excludes
index cbd7f8ea5..71672d752 100644
--- a/.github/fieldtrip-mex-excludes
+++ b/.github/fieldtrip-mex-excludes
@@ -9,6 +9,12 @@
 #           mexmaci64  macOS Intel 64-bit
 #           mexw64     Windows 64-bit
 #
+# Protected: bem_*.mexmaca64, SPM's own Apple Silicon build of external/bemcp,
+#           which FieldTrip does not ship, survives --delete. Upstream copies
+#           would still update it. Other mexmaca64 files follow upstream,
+#           deletions included. Remove once FieldTrip ships bem_*.mexmaca64
+#           (fieldtrip/fieldtrip#2496).
+#
 # Excluded: mexw32     Windows 32-bit (end-of-life)
 #           mexglx     Linux 32-bit (end-of-life)
 #           mexlx      Linux legacy (end-of-life)
@@ -17,6 +23,7 @@
 #           mexmaci    macOS Intel 32-bit (end-of-life; mexmaci64 is kept)
 #           *.mex      bare suffix — local build artifact with no platform tag
 # ─────────────────────────────────────────────────────────────────────────────
+P bem_*.mexmaca64
 - *.mexw32
 - *.mexglx
 - *.mexlx
diff --git a/.github/fieldtrip-sync-filters b/.github/fieldtrip-sync-filters
index df32e5792..885f13054 100644
--- a/.github/fieldtrip-sync-filters
+++ b/.github/fieldtrip-sync-filters
@@ -40,6 +40,20 @@
 merge .github/fieldtrip-mex-excludes
 
 
+# ── Apple Silicon MEX files missing from FieldTrip's folder copies ───────────
+# FieldTrip copies each MEX file from src/ into the folders that use it, but
+# leaves out mexmaca64 in these folders while shipping mexa64, mexmaci64 and
+# mexw64 there. SPM copies FieldTrip's src/ build in; "P" keeps the copy
+# through --delete, and upstream copies would still update it. Anchored to
+# external/fieldtrip/, so other folders follow upstream, deletions included.
+# Remove a line once FieldTrip ships that file or drops its folder.
+P /connectivity/private/ft_getopt.mexmaca64
+P /fileio/private/ft_getopt.mexmaca64
+P /fileio/private/read_16bit.mexmaca64
+P /inverse/private/ft_getopt.mexmaca64
+P /utilities/ft_getopt.mexmaca64
+
+
 # ── external/: only sync packages already present in SPM ────────────────────────
 # FieldTrip ships many third-party packages in external/; The following are synced to fieldtrip/external.
 # Some are synced directly to SPM's external/ (See sync_fieldtrip.yml)
