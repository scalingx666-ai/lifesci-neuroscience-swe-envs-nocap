-                # Train discriminator, inference and generator model
-                discriminator_loss = train_discriminator(
-                    alpha_posterior,
-                    alpha_prior,
-                )
-                generator_loss = self.model.train_on_batch(batch, [batch, real])
-
-                if verbose:
