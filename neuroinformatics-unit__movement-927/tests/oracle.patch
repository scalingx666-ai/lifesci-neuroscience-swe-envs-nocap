+    """
+    roi = _napari_shape_to_roi(ellipse_yx, "ellipse")
+    # centre (5, 5), semi_x=2, semi_y=3
+    # bounds: (5-2, 5-3, 5+2, 5+3)
+    assert roi.region.bounds == pytest.approx((3.0, 2.0, 7.0, 8.0), abs=0.01)
