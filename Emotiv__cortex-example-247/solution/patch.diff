diff --git a/octave/functions/cortexMarker.m b/octave/functions/cortexMarker.m
new file mode 100644
index 0000000..5a78550
--- /dev/null
+++ b/octave/functions/cortexMarker.m
@@ -0,0 +1,58 @@
+function [cortex, result] = cortexMarker(cortex, action, varargin)
+% cortexMarker  Inject an instance marker or update it to an interval marker.
+%   [cortex, result] = cortexMarker(cortex, 'inject', label, value, ...)
+%   Optional inject name/value pairs: time (epoch milliseconds), port, extras.
+%   [cortex, result] = cortexMarker(cortex, 'update', markerId, endTime, ...)
+%   Optional update name/value pair: extras. Markers require an active record.
+
+result = [];
+try
+    if ~isstruct(cortex) || ~isfield(cortex, 'isConnected') || ~cortex.isConnected || ...
+            ~isfield(cortex, 'isRecording') || ~cortex.isRecording || ...
+            ~isfield(cortex, 'manager') || isempty(cortex.manager)
+        error('cortex:markerFailed', 'Start a record before using marker operations.');
+    end
+    if ~ischar(action)
+        error('cortex:markerFailed', 'action must be ''inject'' or ''update''.');
+    end
+
+    marker = cortex.manager.getMarker();
+    switch lower(action)
+        case 'inject'
+            if numel(varargin) < 2
+                error('cortex:markerFailed', 'Inject requires a label and value.');
+            end
+            label = varargin{1};
+            value = varargin{2};
+            options = parseOptions(varargin(3:end), struct('time', [], 'port', 'Software', 'extras', struct()));
+            result = marker.inject(label, value, options.time, options.port, options.extras);
+        case 'update'
+            if numel(varargin) < 2
+                error('cortex:markerFailed', 'Update requires a markerId and endTime.');
+            end
+            markerId = varargin{1};
+            endTime = varargin{2};
+            options = parseOptions(varargin(3:end), struct('extras', struct()));
+            result = marker.update(markerId, endTime, options.extras);
+        otherwise
+            error('cortex:markerFailed', 'action must be ''inject'' or ''update''.');
+    end
+catch failure
+    if strcmp(failure.identifier, 'cortex:markerFailed'), rethrow(failure); end
+    error('cortex:markerFailed', 'Marker operation failed: %s', failure.message);
+end
+end
+
+function options = parseOptions(arguments, options)
+if mod(numel(arguments), 2) ~= 0
+    error('cortex:markerFailed', 'Marker options must be supplied as name/value pairs.');
+end
+for index = 1:2:numel(arguments)
+    name = arguments{index};
+    if ~ischar(name) || ~isfield(options, name)
+        error('cortex:markerFailed', 'Unknown marker option.');
+    end
+    options.(name) = arguments{index + 1};
+end
+end
+
diff --git a/octave/functions/cortexRecord.m b/octave/functions/cortexRecord.m
new file mode 100644
index 0000000..b42391f
--- /dev/null
+++ b/octave/functions/cortexRecord.m
@@ -0,0 +1,47 @@
+function [cortex, result] = cortexRecord(cortex, action, varargin)
+% cortexRecord  Start or stop a record for the active Cortex session.
+%   [cortex, result] = cortexRecord(cortex, 'start', title, description, tags)
+%   [cortex, result] = cortexRecord(cortex, 'stop')
+%   Starting updates cortex.isRecording and cortex.recordId. The result is the
+%   Cortex result struct: record and sessionId.
+
+result = [];
+try
+    if ~isstruct(cortex) || ~isfield(cortex, 'isConnected') || ~cortex.isConnected || ...
+            ~isfield(cortex, 'manager') || isempty(cortex.manager)
+        error('cortex:recordFailed', 'Connect to Cortex before using record operations.');
+    end
+    if ~ischar(action)
+        error('cortex:recordFailed', 'action must be ''start'' or ''stop''.');
+    end
+
+    record = cortex.manager.getRecord();
+    switch lower(action)
+        case 'start'
+            if isempty(varargin) || numel(varargin) > 3
+                error('cortex:recordFailed', 'Start requires title and accepts optional description and tags.');
+            end
+            title = varargin{1};
+            description = '';
+            tags = {};
+            if numel(varargin) >= 2, description = varargin{2}; end
+            if numel(varargin) >= 3, tags = varargin{3}; end
+            result = record.create(title, description, tags);
+        case 'stop'
+            if ~isempty(varargin)
+                error('cortex:recordFailed', 'Stop does not accept additional arguments.');
+            end
+            result = record.stop();
+        otherwise
+            error('cortex:recordFailed', 'action must be ''start'' or ''stop''.');
+    end
+
+    context = cortex.manager.getContext();
+    cortex.isRecording = context.isRecording;
+    cortex.recordId = context.recordId;
+catch failure
+    if strcmp(failure.identifier, 'cortex:recordFailed'), rethrow(failure); end
+    error('cortex:recordFailed', 'Record operation failed: %s', failure.message);
+end
+end
+
diff --git a/octave/functions/cortexSession.m b/octave/functions/cortexSession.m
new file mode 100644
index 0000000..3fb52f6
--- /dev/null
+++ b/octave/functions/cortexSession.m
@@ -0,0 +1,75 @@
+function cortex = cortexSession(cortex, headsetId, varargin)
+% cortexSession  Connect a headset and create or reuse its active Cortex session.
+%   cortex = cortexSession(cortex, 'INSIGHT-XXXXXXXX') creates one session for the headset.
+%   Calling it again for the same active headset reuses that session; another headset
+%   cannot be connected until the current Cortex connection is closed.
+%   Optional name/value pairs: autoRescan (true), queryInterval (3 seconds),
+%   and scanTimeout (30 seconds).
+
+options = struct('autoRescan', true, 'queryInterval', 3, 'scanTimeout', 30);
+if mod(numel(varargin), 2) ~= 0
+    error('cortex:sessionFailed', 'Options must be supplied as name/value pairs.');
+end
+for index = 1:2:numel(varargin)
+    name = varargin{index};
+    if ~ischar(name) || ~isfield(options, name)
+        error('cortex:sessionFailed', 'Unknown headset session option.');
+    end
+    options.(name) = varargin{index + 1};
+end
+
+if ~isstruct(cortex) || ~isfield(cortex, 'isConnected') || ~cortex.isConnected || ...
+        ~isfield(cortex, 'manager') || isempty(cortex.manager)
+    error('cortex:sessionFailed', 'Connect and authorize Cortex before creating a headset session.');
+end
+if ~ischar(headsetId) || isempty(headsetId)
+    error('cortex:sessionFailed', 'headsetId must be a non-empty character vector.');
+end
+
+manager = cortex.manager;
+context = manager.getContext();
+if ~isempty(context.sessionId)
+    if ~strcmp(context.headsetId, headsetId)
+        error('cortex:sessionFailed', ...
+            'A session for headset %s is already active. Disconnect before selecting headset %s.', ...
+            context.headsetId, headsetId);
+    end
+    cortex = syncSessionState(cortex, context);
+    return;
+end
+
+headset = [];
+try
+    headset = manager.getHeadset();
+    headset.scanHeadset(options.autoRescan, options.queryInterval);
+
+    if ~headset.waitForHeadset(headsetId, options.scanTimeout)
+        error('CortexHeadset:notFound', 'Headset %s was not found within %g seconds.', ...
+            headsetId, options.scanTimeout);
+    end
+
+    [ok, message] = headset.connectToHeadset(headsetId, {});
+    if ~ok
+        error('CortexHeadset:connect', '%s', message);
+    end
+
+    cortex = syncSessionState(cortex, manager.getContext());
+catch failure
+    if ~isempty(headset)
+        try
+            headset.stopScan();
+        catch
+        end
+    end
+    error('cortex:sessionFailed', 'Could not create a headset session: %s', failure.message);
+end
+end
+
+function cortex = syncSessionState(cortex, context)
+cortex.headsetId = context.headsetId;
+cortex.sessionId = context.sessionId;
+cortex.streams = context.subscribedStreams;
+cortex.isSubscribed = ~isempty(context.subscribedStreams);
+cortex.isRecording = context.isRecording;
