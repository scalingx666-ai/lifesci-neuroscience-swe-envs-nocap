+            data, fs=data.sampling_rate, nw=3, num_tapers=9, peak_resolution=1)
+        freqs2, cross_spec2 = elephant.spectral.multitaper_cross_spectrum(
+            data, fs=data.sampling_rate, nw=3, num_tapers=9)
