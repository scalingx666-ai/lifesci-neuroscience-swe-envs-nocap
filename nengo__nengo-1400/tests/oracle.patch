diff --git a/.pylintrc b/.pylintrc
index 4ab2e24c6a..61417406e5 100644
--- a/.pylintrc
+++ b/.pylintrc
@@ -10,6 +10,7 @@ disable = all,
           import-error,
           reimported,
 enable = anomalous-backslash-in-string,
+         bad-mcs-classmethod-argument,
          bad-super-call,
          bad-whitespace,
          bare-except,
@@ -29,6 +30,11 @@ enable = anomalous-backslash-in-string,
 max-line-length = 79
 
 
+[CLASSES]
+
+valid-metaclass-classmethod-first-arg = metacls
+
+
 [REPORTS]
 
 reports = no
diff --git a/nengo/utils/magic.py b/nengo/utils/magic.py
index da4ffc873f..db01c7a596 100644
--- a/nengo/utils/magic.py
+++ b/nengo/utils/magic.py
@@ -83,9 +83,9 @@ class ObjectProxyMeta(type):
     implementation for them in all derived classes.
     """
 
-    def __new__(cls, name, bases, dictionary):
+    def __new__(metacls, name, bases, dictionary):
         dictionary.update(vars(ObjectProxyMethods))
-        return type.__new__(cls, name, bases, dictionary)
+        return type.__new__(metacls, name, bases, dictionary)
 
 
 class ObjectProxy(with_metaclass(ObjectProxyMeta)):
@@ -270,7 +270,7 @@ class DocstringInheritor(type):
     a variation on Paul McGuire's code at
     https://groups.google.com/group/comp.lang.python/msg/26f7b4fcb4d66c95
     '''
-    def __new__(meta, name, bases, clsdict):
+    def __new__(metacls, name, bases, clsdict):
         if not('__doc__' in clsdict and clsdict['__doc__']):
             for mro_cls in (
                     mro_cls for base in bases for mro_cls in base.mro()):
@@ -287,4 +287,4 @@ def __new__(meta, name, bases, clsdict):
                     if doc:
                         attribute.__doc__ = doc
                         break
-        return type.__new__(meta, name, bases, clsdict)
+        return type.__new__(metacls, name, bases, clsdict)
