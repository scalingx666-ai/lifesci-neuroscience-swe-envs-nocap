diff --git a/nitorch/tests/test_svf_backward.py b/nitorch/tests/test_svf_backward.py
index 26908d23..e487f399 100644
--- a/nitorch/tests/test_svf_backward.py
+++ b/nitorch/tests/test_svf_backward.py
@@ -58,3 +58,31 @@ def test_exp_backward_hessian(dim):
     g2, h2 = spatial.exp_backward(v, G, H, steps=4)
