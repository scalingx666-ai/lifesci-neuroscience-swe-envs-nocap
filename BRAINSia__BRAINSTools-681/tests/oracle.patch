diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 083556bd8..c1010c484 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -297,7 +297,7 @@ jobs:
 
       - name: Restore compiler cache
         id: restore-ccache
-        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
         with:
           path: ${{ runner.temp }}/ccache
           key: ccache-v2-${{ steps.itk.outputs.keytag }}${{ runner.os }}-${{ steps.toolchain.outputs.image }}-${{ matrix.config.cxx }}${{ steps.toolchain.outputs.compiler_major }}-${{ github.sha }}
@@ -316,7 +316,7 @@ jobs:
       # The path is workspace-relative because actions/cache hashes the literal path into the
       # entry's version, so an absolute runner path would never restore across Linux and macOS.
       - name: Restore ExternalData object store
-        uses: actions/cache/restore@caa296126883cff596d87d8935842f9db880ef25 # v5
+        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
         with:
           path: .ExternalData
           key: externaldata-v2-${{ hashFiles('**/*.sha512') }}
diff --git a/.github/workflows/populate-externaldata-cache.yml b/.github/workflows/populate-externaldata-cache.yml
index 431666e52..3f1351021 100644
--- a/.github/workflows/populate-externaldata-cache.yml
