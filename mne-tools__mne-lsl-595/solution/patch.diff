+            "Cz": [0.0, 0.0, 0.1],
+            "Pz": [0.0, -0.07, 0.07],
+            "Oz": [0.0, -0.1, 0.03],
+        },
+        coord_frame="head",
+    )
+    info_ref.set_montage(montage)
+    with info_ref._unlock():
+        info_ref["highpass"] = 0.5
+        info_ref["lowpass"] = 120.0
