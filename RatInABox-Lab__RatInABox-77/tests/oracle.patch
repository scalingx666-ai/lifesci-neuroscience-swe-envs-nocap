+      ]
+     },
+     "metadata": {},
+     "output_type": "display_data"
+    }
+   ],
+   "source": [
+    "Env = Environment()\n",
+    "Env.add_object(object = np.array([0.25,0.25]), type = 0)\n",
+    "Env.add_object(object = np.array([0.5,0.75]), type = 0)\n",
+    "Env.add_object(object = np.array([0.75,0.25]), type = 1)\n",
+    "\n",
+    "Env.add_wall([[0.5,0],[0.5,0.5]])\n",
+    "\n",
+    "#See the environment\n",
+    "fig, ax = Env.plot_environment(); fig.suptitle(\"An environment with three objects of two different types\")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "### Basic `ObjectVectorCells` and `BoundaryVectorCells` \n",
+    "\n",
+    "- `ObjectVectorCell` : Fires when they detect an object in their tuning distance and angles \n",
+    "- `BoundaryVectorCell` : These detect the walls in the Envirnoment\n",
+    "\n",
+    "By default each cell (BVC or OVC) has a random distance and angle tuning. OVCs (but obviously not BVCs) have an additional preference parameter specifying the type of object (`OVCs.tuning_types`) they respond to.\n",
+    "\n",
+    "We can visualise the cells rate maps with the `plot_rate_maps` function. Notice how OVCs respond to objects whereas BVCs respond to walls; each responds preferably at a given angle and tuning distance. "
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 5,
+   "metadata": {},
+   "outputs": [
+    {
+     "name": "stdout",
+     "output_type": "stream",
+     "text": [
+      "Figure saved to /Users/tomgeorge/Documents/RatInABox/figures/21_08_23/ObjectVectorCell_ratemaps_2134.png  & .svg\n",
+      "Figure saved to /Users/tomgeorge/Documents/RatInABox/figures/21_08_23/BoundaryVectorCells_ratemaps_2134.png  & .svg\n"
+     ]
+    },
+    {
+     "data": {
+      "text/plain": [
+       "Text(0.5, 0.98, 'Boundary Vector Cells')"
+      ]
+     },
+     "execution_count": 5,
+     "metadata": {},
+     "output_type": "execute_result"
+    },
+    {
+     "data": {
