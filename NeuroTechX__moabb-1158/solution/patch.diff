+    """Private subsampling must not pre-consume the caller-owned RNG stream."""
+    y = np.array([0, 1] * 100)
+    groups = np.repeat(np.arange(5), 40)
+    kwargs = {
+        "data_size": {"policy": "per_class", "value": [2, 5, 10]},
