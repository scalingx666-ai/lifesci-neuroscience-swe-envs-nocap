+    """Both policies honor vector counts, nesting, grouping, and RNG modes."""
+    y = np.array([0, 1] * 100)
+    groups = np.repeat(np.arange(5), 40)
+    kwargs = {
+        "data_size": {"policy": policy, "value": values},
