diff --git a/.github/workflows/ci-docker.yml b/.github/workflows/ci-docker.yml
index 297548863..61a59e772 100644
--- a/.github/workflows/ci-docker.yml
+++ b/.github/workflows/ci-docker.yml
@@ -29,11 +29,11 @@ jobs:
     steps:
       -
         name: Checkout
-        uses: actions/checkout@v4
+        uses: actions/checkout@v6
       -
         name: Docker meta
         id: meta
-        uses: docker/metadata-action@v5
+        uses: docker/metadata-action@v6
         with:
           images: ${{ env.DOCKER_REPO }}
       -
@@ -70,7 +70,7 @@ jobs:
             echo "DOCKER_TAGS=${DOCKER_TAGS}" >> "$GITHUB_ENV"
       -
         name: Build and load (PR) or push (commit/tag)
-        uses: docker/build-push-action@v5
+        uses: docker/build-push-action@v7
         with:
             context: .
             push: ${{ github.event_name != 'pull_request' }}
@@ -86,7 +86,7 @@ jobs:
       -
         name: Upload PR Docker image as artifact
         if: github.event_name == 'pull_request'
-        uses: actions/upload-artifact@v4
+        uses: actions/upload-artifact@v7
         with:
             name: ants-docker-image
             path: ants_image.tar
