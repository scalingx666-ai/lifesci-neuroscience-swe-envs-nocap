+        )
+        _delay, slope, r_value = conn.group_delay(frequencies_of_interest=[10, 90])
+
+        off_diagonal = ~np.eye(3, dtype=bool)
+        assert (np.abs(r_value[..., off_diagonal]) > 0.9).all()  # premise: linear phase
