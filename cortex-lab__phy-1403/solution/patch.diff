+def test_cluster_view_formats_multiple_values(qtbot, gui):
+    cv = ClusterView(
+        gui,
+        data=[{'id': 1, 'n_spikes': 10, 'tags': ['tag_a', 'tag_b']}],
+        columns=['tags'],
