+function u = url(fname)
+%-File URL scheme
+if ispc, s='/'; else s=''; end
+u = ['file://' s strrep(fname,'\','/')];
+e = ' ';
+for i=1:length(e)
+    u = strrep(u,e(i),['%' dec2hex(e(i))]);
+end
+% u = ['file://./' spm_file(u,'filename')];
+end
