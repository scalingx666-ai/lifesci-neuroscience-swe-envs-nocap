+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "### Bonus:`AgentVectorCells` \n",
+    "\n",
+    "\n",
+    "To show the true extendible nature of these vector cells, the repository has a `AgentVectorCells`. These type of cells are similar to the `ObjectVectorCells` but with 1 main difference that instead of detecting an object in the environment they detect another agent that might be present in the environment. \n",
+    "\n",
+    "\n",
+    "The folowing cell shows how to initialize Tom detecting Jerry and vice-a-versa."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 2,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "from ratinabox.Neurons import AgentVectorCells\n",
+    "\n",
+    "Env = Environment()\n",
+    "\n",
+    "dt = 0.01\n",
+    "tom = Agent(Env, params={'name': 'tom', 'dt': dt})\n",
+    "jerry = Agent(Env, params={'name': 'jerry', 'dt': dt})\n",
+    "\n",
+    "# create a Agent Vector Cell for 'tom' that detect 'jerry' \n",
+    "agent_vector_cells_tom_2_jerry = AgentVectorCells(tom , jerry, params={ \"name\":\"agent_vcs\",\n",
+    "                                                                        \"distance_range\": [0.01, 0.4],  # min and max distances the agent can \"see\"\n",
+    "                                                                        \"angle_range\": [0,90,],  # angluar FoV in degrees (will be symmetric on both sides, so give range in 0 (forwards) to 180 (backwards)\n",
+    "                                                                        \"spatial_resolution\": 0.06,  # resolution of each BVC tiling FoV, behaves a bit differently in diverging_manifold\n",
+    "                                                                        \"cell_arrangement\": \"diverging_manifold\",\n",
+    "                                                                        \"reference_frame\": \"egocentric\",\n",
+    "                                                                        })\n",
+    "\n",
+    "# create a Agent Vector Cell for 'jerry' that detect 'tom'\n",
+    "agent_vector_cells_jerry_2_tom = AgentVectorCells(jerry , tom , params={\"name\":\"agent_vcs\",\n",
+    "                                                                        \"distance_range\": [0.01, 0.4],  # min and max distances the agent can \"see\"\n",
+    "                                                                        \"angle_range\": [0,90,],  # angluar FoV in degrees (will be symmetric on both sides, so give range in 0 (forwards) to 180 (backwards)\n",
+    "                                                                        \"spatial_resolution\": 0.06,  # resolution of each BVC tiling FoV, behaves a bit differently in diverging_manifold\n",
+    "                                                                        \"cell_arrangement\": \"diverging_manifold\",\n",
+    "                                                                        \"reference_frame\": \"egocentric\",\n",
+    "                                                                        })\n",
+    "\n",
+    "\n",
+    "# Run the simulation for 30 seconds\n",
+    "for i in range(int(30/tom.dt)):\n",
+    "    tom.update()\n",
+    "    jerry.update()\n",
+    "    agent_vector_cells_tom_2_jerry.update()\n",
+    "    agent_vector_cells_jerry_2_tom.update()"
+   ]
+  },
