+def _stim_row(etype: str, filepath: Path, start: float) -> dict:
+    return {
+        "type": etype,
+        "start": start,
+        "duration": 0.2,
+        "timeline": "tl_0",
+        "subject": "01",
+        "filepath": str(filepath),
