+def _masked_quantile(x, q, dim, mask):
+    """Quantiles over the last `dim` axes, using only voxels where mask > 0.
+    Returns a (*batch, *ones, K) tensor."""
+    batch = torch.broadcast_shapes(x.shape[:-dim], mask.shape[:-dim])
