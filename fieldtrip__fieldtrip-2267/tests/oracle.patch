diff --git a/specest/ft_specest_mtmfft.m b/specest/ft_specest_mtmfft.m
index a089289134..6a08b2e1aa 100644
--- a/specest/ft_specest_mtmfft.m
+++ b/specest/ft_specest_mtmfft.m
@@ -98,9 +98,9 @@
 if isempty(pad) % if no padding is specified padding is equal to current data length
   pad = dattime;
 end
-postpad    = ceil((pad - dattime) * fsample);
-endnsample = round(pad * fsample);  % total number of samples of padded data
-endtime    = pad;                   % total time in seconds of padded data
+endnsample = round(pad * fsample);    % total number of samples of padded data
+postpad    = endnsample - ndatsample; % number of samples for zero padding
+endtime    = pad;                     % total time in seconds of padded data
 
 % Set freqboi and freqoi
 freqoiinput = freqoi;
diff --git a/test/test_issue2265.m b/test/test_issue2265.m
new file mode 100644
index 0000000000..984a97903d
--- /dev/null
+++ b/test/test_issue2265.m
@@ -0,0 +1,24 @@
+function test_issue2265
+
+% WALLTIME 00:10:00
+% MEM 3gb
+% DEPENDENCY ft_freqanalysis ft_specest_mtmfft
+
+data = [];
+data.trial{1} = randn(1,481);
+data.time{1}  = linspace(-0.2, 0.6, 481);
+data.label    = {'chan01'};
+
+cfg        = [];
+cfg.method = 'mtmfft';
+cfg.output = 'fourier';
+cfg.taper  = 'hanning';
+cfg.pad    = 1;
+freq       = ft_freqanalysis(cfg, data);
+
+% the original issue is that due to numeric rounding error the estimated
+% number of padding samples was one too many, causing a mismatch between
+% the actual returned frequency bins, and the specified bins in the
+% freq.freq axis. This could be evaluated by observing a complex-valued
+% fourier coefficient at the Nyquist frequency bin.
+assert(abs(imag(freq.fourierspctrm(end)))<100*eps);
