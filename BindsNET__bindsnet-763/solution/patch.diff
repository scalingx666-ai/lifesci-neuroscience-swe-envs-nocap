+        stride=connection.stride,
+        padding=connection.padding,
+        dilation=connection.dilation,
+    )
+    return grad_fn(p_plus, connection.w.shape, target_s, **kw) + grad_fn(
+        source_s, connection.w.shape, p_minus, **kw
+    )
