index 0000000000..47f8318fa3
--- /dev/null
+++ b/changelog.d/pr-7971.md
@@ -0,0 +1,8 @@
+### 🐛 Bug Fixes
+
+- Close a subprocess's stdout/stderr pipes as soon as the reader thread sees
+  EOF, so a consumer that stops reading early (e.g. `GitRepo.is_with_annex()`)
+  no longer leaks file descriptors until garbage collection.  Fixes
+  [#7932](https://github.com/datalad/datalad/issues/7932) via
+  [PR #7971](https://github.com/datalad/datalad/pull/7971)
+  (by [@syahra712](https://github.com/syahra712))
diff --git a/datalad/runner/runnerthreads.py b/datalad/runner/runnerthreads.py
index 8b11e3fe4b..087d0d293f 100644
--- a/datalad/runner/runnerthreads.py
+++ b/datalad/runner/runnerthreads.py
@@ -206,7 +206,12 @@ def read(self) -> Optional[bytes]:
             # try to close it and indicate EOF.
             _try_close(self.source)
             return None
-        return data or None
+        if not data:
+            # EOF: release the pipe now rather than when the consumer of the
+            # results gets around to it, which it might never do (gh-7932)
+            _try_close(self.source)
+            return None
+        return data
 
     def write(self,
               data: bytes
diff --git a/datalad/runner/tests/test_generatormixin.py b/datalad/runner/tests/test_generatormixin.py
index 937fa0757f..f66a540b6b 100644
--- a/datalad/runner/tests/test_generatormixin.py
+++ b/datalad/runner/tests/test_generatormixin.py
@@ -141,3 +141,27 @@ def __init__(self) -> None:
     except CommandError:
         return
     assert_equal(2, 3)
+
+
+def test_abandoned_generator_releases_pipes() -> None:
+    # gh-7932: a consumer that stops early (any(), next(), break) never sends
+    # the EOF events that close the pipes, so the reader threads must do it.
+    result_generator = run_command(
+        py2cmd("print('a', flush=True); print('b', flush=True)"),
+        protocol=TestProtocol,
+        stdin=None,
+    )
+    assert isinstance(result_generator, _ResultGenerator)
+    runner = result_generator.runner
+    process = runner.process
+    assert process is not None
+    next(result_generator)
+    # ... and is abandoned here
+    process.wait()
+    for thread in (runner.stdout_enqueueing_thread,
+                   runner.stderr_enqueueing_thread):
+        assert thread is not None
+        thread.join(timeout=10)
+    assert process.stdout is not None and process.stdout.closed
+    assert process.stderr is not None and process.stderr.closed
+
