+    "import os\n",
+    "import numpy as np\n",
+    "import siibra\n",
+    "from tvb.simulator.lab import *"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 2,
+   "id": "ade53945-629d-4270-ba4b-888afa80f811",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "# Add an EBRAINS token\n",
+    "os.environ['HBP_AUTH_TOKEN'] = ''"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 3,
+   "id": "a9ad309d-28ed-45a9-bfb2-f842d7cb7abe",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "# get desired brain parcellation\n",
+    "atlas = siibra.atlases[\"human\"]\n",
+    "jubrain = atlas.get_parcellation(\"julich 2.9\")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
