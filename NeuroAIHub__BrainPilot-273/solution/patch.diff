+/* ── #272 — ask_user composer takeover (Codex-style picker) ─────────── */
+.ask-user-composer {
+  display: grid;
+  gap: 10px;
+  padding: 12px 14px;
+  border-radius: var(--radius-lg, 12px);
+  border: 1px solid color-mix(in srgb, var(--color-accent) 45%, var(--color-border));
+  background: var(--color-accent-soft);
+  outline: none;
+}
+.ask-user-composer__head {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.ask-user-composer__icon { flex: none; color: var(--color-accent); }
+.ask-user-composer__question {
