diff --git a/Modules/Loadable/Sequences/Logic/vtkSlicerSequencesLogic.cxx b/Modules/Loadable/Sequences/Logic/vtkSlicerSequencesLogic.cxx
index a97b60e51fb..8f0b98b2cd2 100644
