+                        row += rows;
+                    if (row < first_row || row > last_row)
+                        throw new BrainFlowError ((int)BrainFlowExitCodes.INVALID_ARGUMENTS_ERROR);
+                    fixed (double* source = &data[row, 0])
+                    {
+                        Buffer.MemoryCopy (source, destination + i * cols, row_bytes, row_bytes);
+                    }
+                }
+            }
+            return packed;
+        }
