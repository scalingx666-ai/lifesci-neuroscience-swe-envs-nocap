+                        if ii:
+                            data = np.concatenate(
+                                [sources[ii - 1][chunk], this_inst.get_data()[extra]]
+                            )
+                            fig.mne.inst = RawArray(
+                                data,
+                                fig.mne.info,
+                                first_samp=this_inst.first_samp,
+                                verbose=False,
