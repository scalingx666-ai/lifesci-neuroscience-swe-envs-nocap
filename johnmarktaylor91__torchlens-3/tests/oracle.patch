+            'module_passes_entered': [],
+            'is_submodule_input': False,
+            'modules_exited': [],
+            'module_passes_exited': [],
+            'is_submodule_output': False,
+            'is_bottom_level_submodule_output': False,
+            'bottom_level_submodule_pass_exited': None,
+            'module_entry_exit_thread': []
