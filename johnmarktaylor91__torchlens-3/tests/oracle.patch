-def flex_equal(a, b):
-    """
-    If a==b returns just one value return that, if it returns an array call "all" on it.
-    """
-    eq_check = a == b
-    if type(eq_check) in [np.ndarray, torch.Tensor, torch.nn.Parameter]:
-        return eq_check.all()
-    elif eq_check in [True, False]:
-        return eq_check
-    else:
-        return all(eq_check)
