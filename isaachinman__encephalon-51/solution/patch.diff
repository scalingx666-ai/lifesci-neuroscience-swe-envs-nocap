+{
+  phase:
+    | 'preflight'
+    | 'recordPublication'
+    | 'cachePreparation'
+    | 'instructionApplication'
+    | 'operationCleanup',
+  canonicalCommitted: boolean,
+  committedRecordIds: string[],
+  committedInstructionFiles: Array<{
