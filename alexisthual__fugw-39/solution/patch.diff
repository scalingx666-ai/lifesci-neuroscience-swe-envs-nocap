+                .T.detach()
+                .cpu()
+            )
+        else:
+            transformed_data = (
+                (
+                    pi.T
+                    @ source_features_tensor.T
+                    / pi.sum(dim=0).reshape(-1, 1)
+                )
+                .T.detach()
+                .cpu()
+            )
 
         # Free allocated GPU memory
         del pi, source_features_tensor
