@@ -312,11 +318,39 @@ def transform(self, source_features, device="auto"):
         source_features_tensor = _make_tensor(source_features, device=device)
 
         # Transform data
-        transformed_data = (
-            (pi.T @ source_features_tensor.T / pi.sum(dim=0).reshape(-1, 1))
-            .T.detach()
-            .cpu()
