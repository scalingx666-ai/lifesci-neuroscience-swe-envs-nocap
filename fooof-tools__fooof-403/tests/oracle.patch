+def copy_func_docstring(source):
+    """Decorator that copies docstring from source.
+
+    Parameters
+    ----------
+    source : function
+        Source function to copy docstring from.
+
+    Returns
+    -------
+    wrapper : function
+        The decorated function, with updated docs.
+    """
+
+    def wrapper(func):
+
+        func.__doc__ = deepcopy(source.__doc__)
+
+        return func
+
+    return wrapper
+
