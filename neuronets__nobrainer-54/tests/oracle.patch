+    original_shape = x.shape
+    required_shape = resize_features_to
+    must_resize = False
+    if x.shape != required_shape:
+        must_resize = True
+        if verbose:
+            click.echo("Resizing volume from shape {} to shape {}".format(x.shape, required_shape))
+        x = skimage.transform.resize(
