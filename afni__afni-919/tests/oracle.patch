+
+        bins = get_hist_bins(ss.y, bf.histbin, bf.histwidth)
+        pp.hist( ss.y,
+                 bins=bins,
+                 density=bf.hist_density,
+                 color=ss.color,
+                 alpha=0.75,
+                 edgecolor='white',
+                 label=ss.leglabel )
+
+        for vv in bf.vlines:
+            pp.axvline(x=vv, c='0.2', ls='--', lw=1)
+
+        for vv, lbl in bf.vlines_hl:
