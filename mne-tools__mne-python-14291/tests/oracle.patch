diff --git a/mne/viz/backends/_abstract.py b/mne/viz/backends/_abstract.py
index c5650040b2d..26574deb573 100644
--- a/mne/viz/backends/_abstract.py
+++ b/mne/viz/backends/_abstract.py
@@ -1358,6 +1358,11 @@ def show(self):
     def hide(self):
         pass
 
+    @abstractmethod
+    def remove(self):
+        """Detach and free this widget; unlike hide(), it is gone for good."""
+        pass
+
     @abstractmethod
     def set_enabled(self, state):
         pass
