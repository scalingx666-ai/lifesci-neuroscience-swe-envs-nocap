+    for(nn in names(nl)) {
+      # insert neurons one at a time
+      x[[nn]]=nl[[nn]]
+    }
+  }
+  # NB permute the merged data frame to ensure that it matches
+  data.frame(x)=new.df[names(x),,drop=FALSE]
+  x
+}
