+"[[<-.neuronlistfh" <- function (x, i, j, ..., value) {
+  hash=digest(value)
+  append=FALSE
+  if(is.numeric(i)) {
+    if(i<1 || i > length(x))
+      stop("i must be between 1 and ", length(x), "To append using a string index.")
