+  }
+  attr(x, "keyfilemap")[i]=hash
+  filehash::dbInsert(attr(x, 'db'), hash, value)
+  # add another row to dataframe
+  if(append){
+    # x is a dummy logical vector, key thing is that this sets the name of x[i]
+    x[i]=FALSE
+    attr(x, 'df')[i, ]=NA
+  } else {
+    # nothing to do
+  }
+  x
+}
