+    tied.calculate()
+    assert tied.auc == 0.5
+
+    # Perfectly ordered scores, one gap far narrower than any fixed grid step
+    ordered = Roc(input_values=[1.0, 1.01, 1000.0], binary_outcome=[False, True, True])
