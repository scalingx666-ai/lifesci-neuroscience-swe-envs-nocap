+        logger_id = add_log_file_handler(log_path)
 
     tmp_data_folder = Path(tempfile.mkdtemp(prefix="data_"))
     tmp_output_folder = Path(tempfile.mkdtemp(prefix="output_"))
 
+    error_occurred = False
     try:
