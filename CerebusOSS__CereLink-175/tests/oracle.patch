+    print(f"  Mean Δ:    {np.mean(ptp):+.2f} ms")
+    print(f"  Median Δ:  {np.median(ptp):+.2f} ms")
+    print(f"  Std Δ:     {np.std(ptp):.2f} ms")
+    print(f"  Range Δ:   [{np.min(ptp):+.2f}, {np.max(ptp):+.2f}] ms")
+    print()
