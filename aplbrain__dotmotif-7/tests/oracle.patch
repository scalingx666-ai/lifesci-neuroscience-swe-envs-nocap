+uniedge(A, B) {
+    A -> B
+    B !> A
+}
+
+fourcycle(x, y, z, a) {
+    uniedge(x, y)
+    uniedge(y, z)
+    uniedge(z, a)
+    uniedge(a, x)
+}
+
+fourcycle(x, y, z, a)
+fourcycle(x, y, z, b)
+
+-------------------------------------------------
