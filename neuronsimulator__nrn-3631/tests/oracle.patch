diff --git a/test/nmodl/transpiler/usecases/morphology/two_radii_implicit_diam_area.mod b/test/nmodl/transpiler/usecases/morphology/two_radii_implicit_diam_area.mod
new file mode 100644
index 0000000000..ada374a7ef
--- /dev/null
+++ b/test/nmodl/transpiler/usecases/morphology/two_radii_implicit_diam_area.mod
@@ -0,0 +1,26 @@
+NEURON {
+    SUFFIX two_radii_implicit_diam_area
+    NONSPECIFIC_CURRENT il
+    RANGE inv
+}
+
+ASSIGNED {
+    il
+    inv
+}
+
+INITIAL {
+    inv = 1.0 / (square_diam() + area)
+}
+
+BREAKPOINT {
+    il = (square_diam() + area) * 0.001 * (v - 20.0)
+}
+
+FUNCTION square_diam() {
+    square_diam = diam * diam
+}
+
+FUNCTION square_area() {
+    square_area = area * area
+}
