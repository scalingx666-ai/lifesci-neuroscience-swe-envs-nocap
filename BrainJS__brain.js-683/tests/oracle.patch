+
+      let calls = 0;
+
+      const net = new NeuralNetwork();
+      net.train(data, {
+        iterations: iters,
+        callbackPeriod: period,
+        callback: (res) => {
+          expect(res.iterations % period === 0).toBeTruthy();
+          calls++;
+        },
+      });
+      expect(target === calls).toBeTruthy();
+    });
