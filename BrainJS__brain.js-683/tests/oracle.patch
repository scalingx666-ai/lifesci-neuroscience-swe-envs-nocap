-  into(ast?: Node | any) {
-    if (!ast) return;
-    if (Array.isArray(ast)) {
-      for (let i = 0; i < ast.length; i++) {
-        this.into(ast[i]);
-      }
-      return;
-    }
-    switch (ast.type) {
-      case 'Program':
-        this.into(ast.body);
