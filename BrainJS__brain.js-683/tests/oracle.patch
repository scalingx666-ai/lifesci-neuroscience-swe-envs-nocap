-        break;
-      case 'ObjectPattern':
-      case 'ObjectExpression':
-        this.into(ast.properties);
-        break;
-      case 'ExpressionStatement':
-        this.into(ast.expression);
-        break;
-      case 'SequenceExpression':
-        this.into(ast.expressions);
-        break;
-      case 'NewExpression':
