+def test_studyset_from_dataset_materialized_preserves_point_values_and_coordinate_metadata():
+    """Materialized Studysets should preserve coordinate-side data through NIMADS points."""
+    source = {
+        "study1": {
+            "contrasts": {
+                "contrast1": {
+                    "coords": {
+                        "space": "MNI",
