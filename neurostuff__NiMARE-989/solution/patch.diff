+                    },
+                    "metadata": {"sample_sizes": [20]},
+                }
+            }
+        }
+    }
+
+    dataset = Dataset(source)
+    studyset = nimads.Studyset.from_dataset(dataset, materialize=True)
+    lazy_studyset = nimads.Studyset.from_dataset(dataset, materialize=False)
