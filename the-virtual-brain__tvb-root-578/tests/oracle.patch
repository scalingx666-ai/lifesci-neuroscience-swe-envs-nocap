+        Method for deep copying a HasTraits object correctly, event when its attributes are of type HasTraits as well.
+        """
+        cls = type(self)
+        copied = cls()
+        for k in cls.declarative_attrs:
+            attr = getattr(self, k)
+            if isinstance(attr, (HasTraits, self.TYPES_TO_DEEPCOPY)):
