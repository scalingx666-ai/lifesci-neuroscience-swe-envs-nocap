+def test_get_readout_valid():
+    aff = torch.eye(4, dtype=torch.double)
+    assert topup_main.get_readout('ap', aff, [4, 5, 6]) == -2
+    assert topup_main.get_readout('lr', aff, [4, 5, 6]) == 0
