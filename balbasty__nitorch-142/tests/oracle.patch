diff --git a/nitorch/spatial/_affine.py b/nitorch/spatial/_affine.py
index 31291f02..3d066489 100644
--- a/nitorch/spatial/_affine.py
+++ b/nitorch/spatial/_affine.py
@@ -2666,11 +2666,16 @@ def fov_max(mat, affines, shapes, pad=0, pad_unit='%'):
     mn, mx = compute_fov(mat, affines, shapes, pad=pad, pad_unit=pad_unit)
 
     # make it integer and adapt orientation matrix
-    mx = torch.ceil(mx)
-    mn = torch.floor(mn)
+    # (with some tolerance, so that round-off errors -- or the
+    # approximate `affine_mean` -- do not add a voxel)
+    tol = 1e-2
+    mx = torch.ceil(mx - tol)
+    mn = torch.floor(mn + tol)
     shape = (mx - mn + 1).long()
-    # M = mn - 1
-    M = mn
+    # `compute_fov` uses one-based voxel coordinates (corners are at
+    # 1 and N), so the first voxel of the bounding box is at `mn - 1`
+    # in zero-based coordinates.
+    M = mn - 1
     M = torch.cat((torch.eye(dim, **backend), M[:, None]), dim=1)
     M = affine_make_homogeneous(as_euclidean(M))
     mat = torch.matmul(mat, M)
diff --git a/nitorch/tests/test_compute_fov.py b/nitorch/tests/test_compute_fov.py
index c87481b7..aeb551bd 100644
--- a/nitorch/tests/test_compute_fov.py
+++ b/nitorch/tests/test_compute_fov.py
@@ -26,3 +26,22 @@ def test_compute_fov_shared_shape():
     mn, mx = compute_fov(mat, affs, shape)
     assert torch.allclose(mn, torch.full([3], 1.).double())
     assert torch.allclose(mx, torch.full([3], 14.).double())
+
+
+def test_fov_max_single_space_is_identity():
+    """The bounding box of a single space, in that space, is itself:
+    it used to be shifted by one voxel (and could gain a voxel through
+    round-off errors)."""
+    from nitorch.spatial import fov_max, mean_space
+    mat = torch.eye(4, dtype=torch.double)
+    shape = (10, 12, 1)
+    out, oshape = fov_max(mat, mat[None], [shape])
+    assert oshape == shape
+    assert torch.allclose(out, mat)
+
+    aff = torch.as_tensor([[0.8, 0, 0, -30.], [0, 1.2, 0, 10.],
+                           [0, 0, 2., 5.], [0, 0, 0, 1]], dtype=torch.double)
+    shape = (20, 16, 8)
+    out, oshape = mean_space(aff[None], [shape])
+    assert oshape == shape
+    assert torch.allclose(out, aff, atol=1e-3)  # affine_mean is approximate
