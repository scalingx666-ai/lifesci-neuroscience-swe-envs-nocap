+  var getNodeSet = function(stackViewer) {
+    return stackViewer.getLayersOfType(CATMAID.TracingLayer).reduce(function (set, tracingLayer) {
+      return set.addAll(Object.keys(tracingLayer.tracingOverlay.nodes));
