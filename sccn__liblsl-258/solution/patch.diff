+void api_config::load_from_content(const std::string &content) {
+	// load the content into an INI object
+	INI pt;
+	if (!content.empty()) {
+		std::istringstream content_stream(content);
+		pt.load(content_stream);
+	}
+	api_config::load(pt);
+	LOG_F(INFO, "Configuration loaded from content");
