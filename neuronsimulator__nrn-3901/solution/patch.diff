     auto sym = hoc_table_lookup(name, obj->ctemplate->symtable);
     if (!obj->ctemplate->is_point_) {
-        hoc_pushs(sym);
-        // put the pointer for the memory location on the stack
-        obj->ctemplate->steer(obj->u.this_pointer);
-        hoc_pushpx(hoc_pxpop() + i);
