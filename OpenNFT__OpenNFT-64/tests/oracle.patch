+class ROIiGLM(dataProcess):
+    def __init__(self,nROIs,nVols, nSkipVols):
+        super().__init__(nROIs,autostart=False)
+
+        self.nROIs = nROIs
+        self.nVols = nVols
+
+        self.rtdata = RawArray('d',[0]*self.nROIs*self.nVols)
