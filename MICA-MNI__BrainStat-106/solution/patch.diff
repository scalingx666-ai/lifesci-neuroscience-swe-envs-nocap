+def _make_contiguous(Y):
+    """Makes values of Y contiguous integers
+
+    Parameters
+    ----------
+    Y : numpy.array
+        Array with uncontiguous numbers.
+
+    Returns
+    -------
+    numpy.array
+        Array Y converted to contiguous numbers in range(np.unique(Y).size).
+    """
+    val = np.unique(Y)
+    for i in range(val.size):
+        Y[Y == val[i]] = i
+    return Y
