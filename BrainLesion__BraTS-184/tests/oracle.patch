+++ b/docs/stylesheets/extra.css
@@ -0,0 +1,187 @@
+/*
+ * Tokyo Night color schemes for Material for MkDocs.
+ *
+ * The built-in scheme names are kept (`default` = light, `slate` = dark) and
+ * only the relevant CSS variables are overridden. This retains Material's
+ * scrollbars, `color-scheme` handling and dark-image logic.
+ */
+
+/* ------------------------------------------------------------------------- */
+/* Tokyo Night Light                                                          */
+/* ------------------------------------------------------------------------- */
+
+[data-md-color-scheme="default"] {
+  color-scheme: light;
+
+  /* Primary (header / tabs) */
+  --md-primary-fg-color: #343b58;
+  --md-primary-fg-color--light: #565a6e;
+  --md-primary-fg-color--dark: #1f2335;
+  --md-primary-bg-color: #d5d6db;
+  --md-primary-bg-color--light: rgba(213, 214, 219, 0.7);
+
+  /* Accent (links / interactive) */
+  --md-accent-fg-color: #34548a;
+  --md-accent-fg-color--transparent: rgba(52, 84, 138, 0.1);
+  --md-accent-bg-color: #d5d6db;
+  --md-accent-bg-color--light: rgba(213, 214, 219, 0.7);
+
+  /* Default foreground / background */
+  --md-default-fg-color: #343b58;
+  --md-default-fg-color--light: rgba(52, 59, 88, 0.75);
+  --md-default-fg-color--lighter: rgba(52, 59, 88, 0.45);
+  --md-default-fg-color--lightest: rgba(52, 59, 88, 0.12);
+  --md-default-bg-color: #d5d6db;
+  --md-default-bg-color--light: rgba(213, 214, 219, 0.7);
+  --md-default-bg-color--lighter: rgba(213, 214, 219, 0.3);
+  --md-default-bg-color--lightest: rgba(213, 214, 219, 0.12);
+
+  /* Code */
+  --md-code-fg-color: #343b58;
+  --md-code-bg-color: #cbccd1;
+  --md-code-bg-color--light: rgba(203, 204, 209, 0.7);
+  --md-code-bg-color--lighter: rgba(203, 204, 209, 0.3);
+
+  --md-code-hl-color: #34548a;
+  --md-code-hl-color--light: rgba(52, 84, 138, 0.1);
+
+  --md-code-hl-number-color: #82431d;
+  --md-code-hl-special-color: #5a4a78;
+  --md-code-hl-function-color: #34548a;
+  --md-code-hl-constant-color: #5a4a78;
+  --md-code-hl-keyword-color: #5a4a78;
+  --md-code-hl-string-color: #2c5a4f;
+  --md-code-hl-name-color: #343b58;
+  --md-code-hl-operator-color: #4c4f69;
+  --md-code-hl-punctuation-color: #4c4f69;
+  --md-code-hl-comment-color: #4c4f69;
+  --md-code-hl-generic-color: #4c4f69;
+  --md-code-hl-variable-color: #454a6b;
+
+  /* Typeset */
+  --md-typeset-color: var(--md-default-fg-color);
+  --md-typeset-a-color: #34548a;
+  --md-typeset-del-color: rgba(140, 67, 81, 0.15);
+  --md-typeset-ins-color: rgba(51, 99, 92, 0.15);
+  --md-typeset-kbd-color: #dfe2f1;
+  --md-typeset-kbd-accent-color: #ffffff;
+  --md-typeset-kbd-border-color: #9699a3;
+  --md-typeset-mark-color: rgba(143, 94, 21, 0.5);
+  --md-typeset-table-color: rgba(52, 59, 88, 0.12);
+  --md-typeset-table-color--light: rgba(52, 59, 88, 0.035);
+
+  /* Admonitions */
+  --md-admonition-fg-color: var(--md-default-fg-color);
+  --md-admonition-bg-color: var(--md-default-bg-color);
+
+  /* Warning */
+  --md-warning-fg-color: #343b58;
+  --md-warning-bg-color: #e0af68;
+
+  /* Footer */
+  --md-footer-fg-color: #c0caf5;
+  --md-footer-fg-color--light: rgba(192, 202, 245, 0.7);
+  --md-footer-fg-color--lighter: rgba(192, 202, 245, 0.45);
+  --md-footer-bg-color: #1f2335;
+  --md-footer-bg-color--dark: #16161e;
+
+  /* Shadows */
+  --md-shadow-z1:
+    0 0.25rem 0.625rem rgba(52, 59, 88, 0.05),
+    0 0 0.0625rem rgba(52, 59, 88, 0.1);
+  --md-shadow-z2:
+    0 0.25rem 0.625rem rgba(52, 59, 88, 0.1),
+    0 0 0.0625rem rgba(52, 59, 88, 0.25);
+  --md-shadow-z3:
+    0 0.25rem 0.625rem rgba(52, 59, 88, 0.2),
+    0 0 0.0625rem rgba(52, 59, 88, 0.35);
+}
+
+/* ------------------------------------------------------------------------- */
+/* Tokyo Night Storm                                                          */
+/* ------------------------------------------------------------------------- */
+
+[data-md-color-scheme="slate"] {
+  /* Primary (header / tabs) */
+  --md-primary-fg-color: #1f2335;
+  --md-primary-fg-color--light: #292e42;
+  --md-primary-fg-color--dark: #16161e;
+  --md-primary-bg-color: #c0caf5;
+  --md-primary-bg-color--light: rgba(192, 202, 245, 0.7);
+
+  /* Accent (links / interactive) */
+  --md-accent-fg-color: #7aa2f7;
+  --md-accent-fg-color--transparent: rgba(122, 162, 247, 0.1);
+  --md-accent-bg-color: #1f2335;
+  --md-accent-bg-color--light: rgba(31, 35, 53, 0.7);
+
+  /* Default foreground / background */
+  --md-default-fg-color: #c0caf5;
+  --md-default-fg-color--light: rgba(192, 202, 245, 0.75);
+  --md-default-fg-color--lighter: rgba(192, 202, 245, 0.45);
+  --md-default-fg-color--lightest: rgba(192, 202, 245, 0.12);
+  --md-default-bg-color: #24283b;
+  --md-default-bg-color--light: rgba(36, 40, 59, 0.7);
+  --md-default-bg-color--lighter: rgba(36, 40, 59, 0.3);
+  --md-default-bg-color--lightest: rgba(36, 40, 59, 0.12);
+
+  /* Code */
+  --md-code-fg-color: #c0caf5;
+  --md-code-bg-color: #1f2335;
+  --md-code-bg-color--light: rgba(31, 35, 53, 0.7);
+  --md-code-bg-color--lighter: rgba(31, 35, 53, 0.3);
+
+  --md-code-hl-color: #7aa2f7;
+  --md-code-hl-color--light: rgba(122, 162, 247, 0.1);
+
+  --md-code-hl-number-color: #ff9e64;
+  --md-code-hl-special-color: #bb9af7;
+  --md-code-hl-function-color: #7aa2f7;
+  --md-code-hl-constant-color: #bb9af7;
+  --md-code-hl-keyword-color: #bb9af7;
+  --md-code-hl-string-color: #9ece6a;
+  --md-code-hl-name-color: #c0caf5;
+  --md-code-hl-operator-color: #89ddff;
+  --md-code-hl-punctuation-color: #89ddff;
+  --md-code-hl-comment-color: #8a91bd;
+  --md-code-hl-generic-color: #8a91bd;
+  --md-code-hl-variable-color: #c0caf5;
+
+  /* Typeset */
+  --md-typeset-color: var(--md-default-fg-color);
+  --md-typeset-a-color: #7aa2f7;
+  --md-typeset-del-color: rgba(247, 118, 142, 0.15);
+  --md-typeset-ins-color: rgba(158, 206, 106, 0.15);
+  --md-typeset-kbd-color: #292e42;
+  --md-typeset-kbd-accent-color: #414868;
+  --md-typeset-kbd-border-color: #414868;
+  --md-typeset-mark-color: rgba(224, 175, 104, 0.5);
+  --md-typeset-table-color: rgba(192, 202, 245, 0.12);
+  --md-typeset-table-color--light: rgba(192, 202, 245, 0.035);
+
+  /* Admonitions */
+  --md-admonition-fg-color: var(--md-default-fg-color);
+  --md-admonition-bg-color: var(--md-default-bg-color);
+
+  /* Warning */
+  --md-warning-fg-color: #24283b;
+  --md-warning-bg-color: #e0af68;
+
+  /* Footer */
+  --md-footer-fg-color: #c0caf5;
+  --md-footer-fg-color--light: rgba(192, 202, 245, 0.7);
+  --md-footer-fg-color--lighter: rgba(192, 202, 245, 0.45);
+  --md-footer-bg-color: #1f2335;
+  --md-footer-bg-color--dark: #16161e;
+
+  /* Shadows */
+  --md-shadow-z1:
+    0 0.25rem 0.625rem rgba(0, 0, 0, 0.05),
+    0 0 0.0625rem rgba(0, 0, 0, 0.1);
+  --md-shadow-z2:
+    0 0.25rem 0.625rem rgba(0, 0, 0, 0.1),
+    0 0 0.0625rem rgba(0, 0, 0, 0.25);
+  --md-shadow-z3:
+    0 0.25rem 0.625rem rgba(0, 0, 0, 0.2),
+    0 0 0.0625rem rgba(0, 0, 0, 0.35);
+}
