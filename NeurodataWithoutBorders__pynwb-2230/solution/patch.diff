@@ -52,3 +54,27 @@ def get_nwb_version(builder: Builder, include_prerelease=False) -> Tuple[int, ..
         prerelease_info = nwb_version[nwb_version.index("-")+1:]
         version_list.append(prerelease_info)
     return tuple(version_list)
