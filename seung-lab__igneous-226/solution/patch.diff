+def create_single_object_thinning_tasks(
+  src_cloudpath:str,
+  dest_cloudpath:str,
+  labels:list[int],
+  mip:int,
+  radius:bool = True,
+  cross_sectional_area:bool = False,
+  cross_sectional_area_smoothing_window:int = 6,
+  timestamp:Optional[int] = None,
+  progress:bool = False,
+  threads:int = 1,
+  dry_run:bool = False,
+  format:Literal['ostd', 'swc', 'precomputed'] = 'ostd',
+):
+  
+  cv = CloudVolume(src_cloudpath, mip=mip)
+
+  bboxes = {}
+  for subset in sip(labels, 20):
+    meshes = cv.mesh.get(subset)
+    for label, mesh in meshes.items():
+      bounds = Bbox.from_points(mesh.vertices // cv.resolution)
+      bounds.grow(1)
+      bboxes[label] = bounds
+  meshes = {}
+
+  def ThinWholeObjectTaskIterator():
+    for label in labels:
+      bbox = bboxes[label]
+      yield partial(ThinWholeObjectTask, 
+        src_cloudpath=src_cloudpath,
+        dest_cloudpath=dest_cloudpath,
+        label=label,
+        mip=mip,
+        radius=bool(radius),
+        cross_sectional_area=cross_sectional_area,
+        cross_sectional_area_smoothing_window=cross_sectional_area_smoothing_window,
+        timestamp=timestamp,
+        threads=threads,
+        bbox=bbox.to_list(),
+        dry_run=bool(dry_run),
+        format=format,
+        progress=progress,
+      )
+
+  return ThinWholeObjectTaskIterator()
+
+
