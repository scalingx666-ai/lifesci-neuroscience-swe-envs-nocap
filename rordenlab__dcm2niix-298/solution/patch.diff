+                tinydir_close(&dir);
+                return -1;
+            }
+            count += subdirectoryCount;
+        } else if (file.is_reg && strlen(file.name) > 0 && file.name[0] != '.' && strcicmp(file.name,"DICOMDIR") != 0 && isDICOMfile(sourcePathPtr)) {
