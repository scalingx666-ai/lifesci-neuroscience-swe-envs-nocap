+                            printMessage("Copying %s -> %s\n", sourcePathPtr, targetPath.c_str());
+                    } else {
+                        printWarning("Unable to copy to path %s\n", targetPath.c_str());
+                    }
+				}
+			}
+        }
+    }
+    return count;
+}
