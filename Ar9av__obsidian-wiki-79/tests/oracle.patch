+.obsidian/workspace-mobile.json
+.obsidian/cache
+.trash/
+GITIGNORE
+      echo "✅  Created .gitignore in vault"
+    fi
+    # Add or update remote
+    if git -C "$VAULT_PATH" remote get-url origin &>/dev/null 2>&1; then
