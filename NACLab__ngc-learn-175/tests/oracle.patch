+from .hebbianAttentionPatchedSynapse import HebbianAttentionPatchedSynapse
+from .scoreAttentionPatchedSynapse import ScoreAttentionPatchedSynapse
diff --git a/ngclearn/components/synapses/attention/attentionPatchedSynapse.py b/ngclearn/components/synapses/attention/attentionPatchedSynapse.py
