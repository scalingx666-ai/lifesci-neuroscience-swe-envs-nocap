diff --git a/frontend/javascripts/viewer/view/right_border_tabs/segments_tab/mesh_file_compatibility_modal.tsx b/frontend/javascripts/viewer/view/right_border_tabs/segments_tab/mesh_file_compatibility_modal.tsx
