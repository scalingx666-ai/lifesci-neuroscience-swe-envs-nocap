+    assert np.allclose(res.affine[:3, 3], AFFINE[:3, 3])
+    last = res.affine[:3, :3] @ (np.array(expected) - 1)
+    in_last = AFFINE[:3, :3] @ (np.array([8, 8, 8]) - 1)
+    assert np.all(last <= in_last + 1e-5)
