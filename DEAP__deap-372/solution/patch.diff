+ax.set_ylabel("$f_2(\mathbf{x})$", fontsize=15)
+ax.set_zlabel("$f_3(\mathbf{x})$", fontsize=15)
+ax.view_init(elev=11, azim=-25)
+ax.autoscale(tight=True)
+plt.legend()
+plt.tight_layout()
+
+plt.show()
