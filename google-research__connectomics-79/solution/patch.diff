+"""Metadata utilities."""
+
+import getpass
+import sys
+from typing import Any, MutableMapping, Optional
+
+
+def get_run_log(comment: Optional[str] = None) -> MutableMapping[str, Any]:
+  log = dict(argv=sys.argv, user=getpass.getuser())
+  if comment is not None:
+    log['comment'] = comment
+  return log
