-        "pred_f = h5py.File('pred.h5', 'r')\n",
-        "\n",
-        "aff_map = pred_f['/aff']\n",
-        "seg = pred_f['/seg']\n",
-        "seg_1, seg_2, seg_3 = seg[0], seg[1], seg[2]\n",
-        "\n",
