-        "import os\n",
-        "\n",
-        "os.chdir('./pytorch_connectomics/')\n",
-        "\n",
-        "\n",
-        "def ngLayer(data, res, oo=[0, 0, 0], tt='segmentation'):\n",
-        "    return neuroglancer.LocalVolume(data,\n",
