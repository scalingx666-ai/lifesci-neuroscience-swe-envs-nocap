+
+
+def model_fn(features,
+             labels,
+             mode,
+             params):
+    """MeshNet model function.
+
+    Args:
+        features: 5D float `Tensor`, input tensor. This is the first item
+            returned from the `input_fn` passed to `train`, `evaluate`, and
