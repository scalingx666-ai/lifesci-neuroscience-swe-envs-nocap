+      activity_regularizer=activity_regularizer,
+      kernel_constraint=kernel_constraint,
+      bias_constraint=bias_constraint,
+      trainable=trainable,
+      name=name,
+      dtype=inputs.dtype.base_dtype,
+      _reuse=reuse,
+      _scope=name)
