+% --------------------------------------------------------------------
+function enableDisableButtons(handles, enable)
+handles.pushbuttonAddColumn.Enable = enable;
+handles.pushbuttonDeleteColumn.Enable = enable;
+handles.pushbuttonEditColumns.Enable = enable;
+
