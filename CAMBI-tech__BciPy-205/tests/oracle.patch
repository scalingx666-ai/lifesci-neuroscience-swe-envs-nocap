+        for i in count:
+            if i is not None:
+                self.assertTrue(num_target_inquiries <= count[i] <= num_target_inquiries + 1)
+
+        # make sure all inquries are non-target inquiries
+        self.assertEqual(count[None], stim_number,
+                         'Should have produced all non-target positions.')
+
