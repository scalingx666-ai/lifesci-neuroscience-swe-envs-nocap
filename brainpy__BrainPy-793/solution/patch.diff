-    "        EL=-54.387 * u.mV, gL=0.03 * u.mS / u.cm ** 2,\n",
-    "        V_th=20. * u.mV,\n",
-    "        C=1.0 * u.uF / u.cm ** 2\n",
-    "    ):\n",
