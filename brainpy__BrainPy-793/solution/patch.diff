+                            f'Error: {e}'
+                        ) from e
+                else:
+                    try:
+                        init = init + out
+                    except Exception as e:
+                        raise ValueError(
+                            f'Error in current input value {key}: {out}\n'
+                            f'Error: {e}'
+                        ) from e
+                    self._current_inputs.pop(key)
+        return init
