-   "source": [
-    "## 定义模型\n",
-    "我们使用`brainstate`来定义一个简单的多层感知机(MLP)模型。"
-   ]
-  },
-  {
-   "cell_type": "code",
-   "execution_count": 19,
-   "id": "d090d2e3",
-   "metadata": {},
-   "outputs": [],
-   "source": [
-    "class MLP(brainstate.nn.Module):\n",
-    "    def __init__(self, din: int, dmid: int, dout: int):\n",
-    "        super().__init__()\n",
-    "        self.dense1 = brainstate.nn.Linear(din, dmid)\n",
-    "        self.dense2 = brainstate.nn.Linear(dmid, dout)\n",
-    "\n",
-    "    def __call__(self, x: jax.Array) -> jax.Array:\n",
-    "        x = self.dense1(x)\n",
-    "        x = jax.nn.relu(x)\n",
-    "        x = self.dense2(x)\n",
-    "        return x"
-   ]
-  },
