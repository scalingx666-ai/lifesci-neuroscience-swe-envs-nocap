+void Classifier::ResetOnSessionStart()
+{
+	uint32 num;
+
+	// reset some nodes
+	num = GetNumNodes();
+	for (uint32_t i = 0; i < num; i++) {
+		Node* n = GetNode(i);
+		if (n->GetType() == FileWriterNode::TYPE_ID || n->GetNodeType() == OutputNode::NODE_TYPE)
+			n->Reset();
+	}
+}
 
