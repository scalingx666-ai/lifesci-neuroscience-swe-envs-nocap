-.left-method-chips { display: flex; gap: 5px; padding: 0 12px 10px; }
+/* Wraps because the row is no longer five short words: at the 280px minimum sidebar width seven
+   chips leave ~32px each, and OPTIONS needs ~42px at 10px mono. `flex: 1 1 auto` with a basis of
+   the label lets a short row still fill the width while a long one spills onto a second line
+   instead of clipping "OPTIONS" to "OPTIO". */
+.left-method-chips { display: flex; flex-wrap: wrap; gap: 5px; padding: 0 12px 10px; }
