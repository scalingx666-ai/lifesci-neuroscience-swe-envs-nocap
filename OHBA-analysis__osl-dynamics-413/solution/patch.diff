+
+        ax.imshow(img)
+        ax.set_axis_off()
+
+        label = labels[idx]
+        prob = probs[idx]
+        ax.set_title(
+            f"ICA{idx:03d}: {label} ({prob:.2f})",
+            fontsize=16,
+            color="red",
+            fontweight="bold",
+        )
+
+    # Hide unused axes
+    for i in range(n_excluded, n_rows * n_cols):
+        row, col = divmod(i, n_cols)
+        axes[row, col].set_axis_off()
