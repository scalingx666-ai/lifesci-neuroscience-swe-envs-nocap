+        # produces ~90-105. Threshold at 125 sits in the middle.
+        assert median_r > 125, (
+            f"VolumeRGB α=0.5 brain pixels have median R={median_r:.0f}; "
+            "expected ~150. R<125 indicates Package is double-premultiplying "
