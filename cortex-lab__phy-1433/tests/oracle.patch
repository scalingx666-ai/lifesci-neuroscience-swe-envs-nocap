index 8322ffbea..97d96dbf6 100644
--- a/phy/apps/_utils.py
+++ b/phy/apps/_utils.py
@@ -24,3 +24,129 @@ def _close_trace_reader(traces):
     close = getattr(reader, 'close', None)
     if callable(close):
         close()
