diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 96ad18525..88e1db696 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -29,6 +29,12 @@ on:
       - 'Utilities/misc/**'
       - 'legal/**'
       - 'docs/**'
+  # Weekly build of main keeps the ccache inside GitHub's 7-day eviction
+  # window and surfaces runner-image or compiler upgrades on main instead
+  # of on an unrelated PR.  Runs after the 06:00 UTC cache sweep.
+  schedule:
+    - cron: '0 8 * * 1'
+  workflow_dispatch:
 
 concurrency:
   group: '${{ github.workflow }}@${{ github.head_ref || github.ref }}'
@@ -170,6 +176,18 @@ jobs:
           choco install ninja ccache --yes
 
       # ── Compiler cache (ccache) ────────────────────────────────────────────────
+      - name: Record runner image and compiler
+        id: toolchain
+        shell: bash
+        run: |
+          # ImageOS/ImageVersion are set on GitHub-hosted runners (e.g. ubuntu24, 20251019.1).
+          IMAGE="${ImageOS:-unknown}"
+          COMPILER_MAJOR=$(${{ matrix.config.cxx }} -dumpversion 2>/dev/null | cut -d. -f1)
+          echo "image=${IMAGE}"                     >> "$GITHUB_OUTPUT"
+          echo "compiler_major=${COMPILER_MAJOR:-0}" >> "$GITHUB_OUTPUT"
+          echo "Runner image: ${IMAGE} ${ImageVersion:-}"
+          ${{ matrix.config.cxx }} --version | head -1
+
       - name: Configure ccache
         shell: bash
         run: |
@@ -186,9 +204,9 @@ jobs:
         uses: actions/cache/restore@v5
         with:
           path: ${{ runner.temp }}/ccache
-          key: ccache-v1-${{ runner.os }}-${{ matrix.config.cxx }}-${{ github.sha }}
+          key: ccache-v2-${{ runner.os }}-${{ steps.toolchain.outputs.image }}-${{ matrix.config.cxx }}${{ steps.toolchain.outputs.compiler_major }}-${{ github.sha }}
           restore-keys: |
-            ccache-v1-${{ runner.os }}-${{ matrix.config.cxx }}-
+            ccache-v2-${{ runner.os }}-${{ steps.toolchain.outputs.image }}-${{ matrix.config.cxx }}${{ steps.toolchain.outputs.compiler_major }}-
 
       - name: Show ccache config and stats
         shell: bash
@@ -312,7 +330,7 @@ jobs:
         uses: actions/cache/save@v5
         with:
           path: ${{ runner.temp }}/ccache
-          key: ccache-v1-${{ runner.os }}-${{ matrix.config.cxx }}-${{ github.sha }}
+          key: ccache-v2-${{ runner.os }}-${{ steps.toolchain.outputs.image }}-${{ matrix.config.cxx }}${{ steps.toolchain.outputs.compiler_major }}-${{ github.sha }}
 
       - name: Show ccache statistics
         if: always()
diff --git a/Utilities/Maintenance/PruneSupersededCiCaches.py b/Utilities/Maintenance/PruneSupersededCiCaches.py
index 66155fc43..b6bc5dfdc 100755
--- a/Utilities/Maintenance/PruneSupersededCiCaches.py
+++ b/Utilities/Maintenance/PruneSupersededCiCaches.py
@@ -2,7 +2,7 @@
 """Prune superseded GitHub Actions caches for the BRAINSTools repository.
 
 The CI workflow seeds ccache via cache keys of the form
-``ccache-v1-<OS>-<compiler>-<sha>``. Each new push produces a new cache
+``ccache-v2-<OS>-<image>-<compiler><major>-<sha>``. Each new push produces a new cache
 with a fresh SHA suffix, while ``actions/cache`` ``restore-keys`` falls
 back to the most recent prefix match. Older SHA-suffixed entries are
 therefore dead weight: they consume the per-repository 10 GB cache
