diff --git a/CMake/SlicerCPack.cmake b/CMake/SlicerCPack.cmake
index e9031c14469..a4e8b798b5e 100644
--- a/CMake/SlicerCPack.cmake
+++ b/CMake/SlicerCPack.cmake
@@ -20,6 +20,14 @@ if(UNIX)
     if(NOT DEFINED CPACK_DMG_FORMAT)
       set(CPACK_DMG_FORMAT "ULFO")
     endif()
+    # Retry detaching the temporary disk image. CPack does not retry, and the
+    # detach fails if another process (e.g Finder in a logged-in GUI session)
+    # is still accessing the newly attached volume.
+    # Quotes are not used since CPack does not escape them when writing the
+    # CPack configuration file, and directories with spaces are not supported.
+    if(NOT DEFINED CPACK_COMMAND_HDIUTIL)
+      set(CPACK_COMMAND_HDIUTIL "/bin/sh ${Slicer_CMAKE_DIR}/SlicerCPackHdiutil.sh")
+    endif()
   endif()
 elseif(WIN32)
   set(CPACK_GENERATOR "NSIS")
diff --git a/CMake/SlicerCPackHdiutil.sh b/CMake/SlicerCPackHdiutil.sh
new file mode 100755
index 00000000000..6eb3e5bf8f8
--- /dev/null
+++ b/CMake/SlicerCPackHdiutil.sh
@@ -0,0 +1,32 @@
+#!/bin/sh
+#
+# Wrapper around hdiutil used by the CPack DragNDrop generator.
+#
+# CPack runs "hdiutil detach" only once after attaching the temporary disk image.
+# If another process is still accessing the newly attached volume, for example
+# Finder in a logged-in GUI session, the detach fails with "Resource busy" and
+# packaging fails, leaving the volume mounted.
+#
+# This wrapper retries "detach" a few times before forcing it. All other hdiutil
+# commands are run unchanged.
+
+hdiutil=/usr/bin/hdiutil
+
+if [ "$1" != "detach" ]; then
+  exec "$hdiutil" "$@"
+fi
+
+attempts=10
+attempt=1
+while [ "$attempt" -le "$attempts" ]; do
+  if "$hdiutil" "$@"; then
+    exit 0
+  fi
+  echo "SlicerCPackHdiutil: 'hdiutil detach' failed (attempt $attempt of $attempts), retrying in $attempt second(s)" >&2
+  sleep "$attempt"
+  attempt=$((attempt + 1))
+done
+
+echo "SlicerCPackHdiutil: 'hdiutil detach' failed after $attempts attempts, forcing detach" >&2
+shift
+exec "$hdiutil" detach -force "$@"
