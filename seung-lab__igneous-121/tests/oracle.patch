+      slice(offset.y, offset.y + data.shape[1]),
+      slice(offset.z, offset.z + data.shape[2]),
+    )
+
+    mirror_data = np.zeros(shape, dtype=data.dtype, order="F")
+    mirror_data[slices] = data
