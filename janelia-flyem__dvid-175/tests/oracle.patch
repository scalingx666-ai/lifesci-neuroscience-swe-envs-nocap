+	// Submit the split sparsevol
+	url = fmt.Sprintf("%snode/%s/%s/split/%d?splitlabel=150", server.WebAPIPath, uuid, "bodies", 100)
+	data = server.TestHTTP(t, "POST", url, buf)
+	jsonVal := make(map[string]uint64)
