+    "        raise ValueError(msg.format(a.ndim))\n",
+    "\n",
+    "\n",
+    "def get_blocks(a, block_shape):\n",
+    "    \"\"\"\n",
+    "    Examples\n",
+    "    --------\n",
+    "    >>> arr = np.ones((4*4)).reshape(4, 4)\n",
+    "    >>> blocks = get_blocks(arr, (2, 2))\n",
