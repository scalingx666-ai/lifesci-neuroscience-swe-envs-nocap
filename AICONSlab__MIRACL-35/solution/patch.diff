-    rm fiji-linux64.zip
+    rm fiji-linux64.zip && \
+    ln -s /opt/fiji/ImageJ-linux64 /opt/fiji/Fiji
 
-ENV PATH ${ANTSPATH}:/opt/fiji/bin:${PATH}
+ENV PATH ${ANTSPATH}:/opt/fiji:${PATH}
 
