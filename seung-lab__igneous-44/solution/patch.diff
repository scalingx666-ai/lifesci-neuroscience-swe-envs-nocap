-def validate_factor(array, factor):
-  factor = np.array(factor, dtype=np.int32)
-  if np.any(factor <= 0):
-    raise ValueError("Factors less than one don't make sense. Factor: {}".format(factor))
-
-  factor = list(factor)
-  while len(factor) < len(array.shape):
-    factor += [ 1 ]
-
-  return tuple(factor)
