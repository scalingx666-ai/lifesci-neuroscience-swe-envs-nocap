+            if event.inaxes not in axes:  # another plot sharing the figure
                 return
 
             # pop up channel name on hover
@@ -656,10 +660,12 @@ def _on_hover(event):
             blit_manager.update()
 
         def _rm_cursor(event):
-            for ax in axes:
