               scriptdir=$(python -c 'import sysconfig; print(sysconfig.get_path("scripts"))')
+              # Use the wheel's binary rather than its Python console script:
+              # faster, and coverage does not start for every git-annex call.
+              bindir=$(python -c 'import git_annex, os.path as op; print(op.dirname(git_annex.__file__))')
