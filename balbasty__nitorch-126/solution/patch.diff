+                out1 = out1 + val
+        out.append(out1.squeeze(1))
+    out = torch.stack(out, -1)
+
+    mask = nd.inbounds_mask(extrapolate, x, shape)
+    if mask is not None:
+        out = out * mask.squeeze(1).unsqueeze(-1)
+    if w is not None:
+        # the histogram is linear in w
+        out = out * w.unsqueeze(-1)
+    return out
+
