diff --git a/neurovault/utils.py b/neurovault/utils.py
new file mode 100644
index 00000000..f7efc2eb
--- /dev/null
+++ b/neurovault/utils.py
@@ -0,0 +1,8 @@
+def strip(value):
+    if not value:
+        return value
+    return value.strip()
+
+
+def logical_xor(a, b):
+    return bool(a) ^ bool(b)
