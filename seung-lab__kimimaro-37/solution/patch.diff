-// Here, y is assumed to contain one 64-bit value repeated.
-// https://stackoverflow.com/a/28827013
-static inline __m128i libdivide_mullhi_u64_vector(__m128i x, __m128i y) {
-    __m128i lomask = _mm_set1_epi64x(0xffffffff);
