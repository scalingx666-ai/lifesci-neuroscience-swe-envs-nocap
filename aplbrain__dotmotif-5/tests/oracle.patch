+                | comment
+
+// A "hypothetical" edge that forms a subgraph structure.
+edge_macro      : node_id relation node_id
+
+
+
+
+// A macro is called like a function: foo(args).
+macro_call      : word "(" arglist ")"
+?macro_call_re  : word "(" arglist ")"
