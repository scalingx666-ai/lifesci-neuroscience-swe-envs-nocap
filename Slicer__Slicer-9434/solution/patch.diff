+#-----------------------------------------------------------------------------
+# Set libraries to leave untouched during macOS bundle fixup and re-signing
+#-----------------------------------------------------------------------------
+if(APPLE)
+  if(NOT DEFINED Slicer_CPACK_BUNDLE_FIXUP_IGNORE_LIBRARY_REGEXES)
