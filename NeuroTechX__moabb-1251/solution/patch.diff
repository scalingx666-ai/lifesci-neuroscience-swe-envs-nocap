diff --git a/moabb/evaluations/utils.py b/moabb/evaluations/utils.py
index 601fb62744..96aa5b898a 100644
--- a/moabb/evaluations/utils.py
+++ b/moabb/evaluations/utils.py
@@ -14,6 +14,7 @@
 from sklearn.metrics import check_scoring
 from sklearn.model_selection import GridSearchCV
 from sklearn.pipeline import Pipeline
+from sklearn.utils.metaestimators import available_if
 
 
 log = logging.getLogger(__name__)
@@ -321,6 +322,17 @@ def _quiet_init(self, *args, **kwargs):
     class OptunaSearchCVClassifier(_BaseOptunaSearchCV, ClassifierMixin):
         _estimator_type = "classifier"
 
+        # optuna-integration defines decision_function unconditionally, so
+        # ROC-AUC scorers call it on predict_proba-only estimators (skorch nets,
+        # GaussianNB) and crash. Guard it like scikit-learn's BaseSearchCV.
+        @available_if(
+            lambda self: hasattr(
+                getattr(self, "best_estimator_", self.estimator), "decision_function"
+            )
+        )
+        def decision_function(self, X, **kwargs):
+            return super().decision_function(X, **kwargs)
+
         def __sklearn_tags__(self):  # scikit-learn >=1.7 tag override
             tags = super().__sklearn_tags__()
 
diff --git a/moabb/tests/test_evaluations.py b/moabb/tests/test_evaluations.py
index 02a1d8d5a8..7491ed8f2a 100644
--- a/moabb/tests/test_evaluations.py
+++ b/moabb/tests/test_evaluations.py
@@ -439,6 +439,31 @@ def test_eval_grid_search(self):
         # We should have 9 columns in the results data frame
         assert len(results[0].keys()) == _expected_result_key_count()
 
+    def test_optuna_search_roc_auc_without_decision_function(self):
+        if not optuna_available:
+            pytest.skip("Optuna is not installed")
+        from optuna.distributions import CategoricalDistribution
+        from sklearn.metrics import get_scorer
+        from sklearn.naive_bayes import GaussianNB
+
+        from moabb.evaluations.utils import check_search_available
+
+        search_methods, _ = check_search_available()
+        rng = np.random.default_rng(0)
+        X = rng.standard_normal((40, 3))
+        y = np.tile([0, 1], 20)
+        search = search_methods["optuna"](
+            GaussianNB(),
+            {"var_smoothing": CategoricalDistribution([1e-9, 1e-8])},
+            n_trials=2,
+            cv=2,
+        )
+        search.fit(X, y)
+        # GaussianNB has predict_proba but no decision_function: the search must
+        # not advertise one, so ROC-AUC falls back to predict_proba.
+        assert not hasattr(search, "decision_function")
+        assert 0.0 <= get_scorer("roc_auc")(search, X, y) <= 1.0
+
     def test_eval_grid_search_optuna(self):
         if not optuna_available:
             pytest.skip("Optuna is not available")
