+          set -o pipefail
+          for attempt in 1 2 3; do
+            if response=$(git ls-remote https://gin.g-node.org/NeuralEnsemble/elephant-data.git HEAD); then
+              # Cut out the hash, and do a sanity check on the hash
+              if hash=$(echo "$response" | awk '{print $1}') && [[ "$hash" =~ ^[0-9a-f]{40}$ ]]; then
+                echo "dataset_hash=$hash" >> "$GITHUB_OUTPUT"
+                exit 0
+              fi
+            fi
+            echo "ls-remote failed (attempt $attempt)"
+            # Don't sleep after the last attempt
+            if [ "$attempt" -lt 3 ]; then
+              echo "retrying ..."; sleep $((attempt * 30))
+            fi
+          done
+          echo "::error::Could not get elephant-data HEAD from GIN"; exit 1
 
       - uses: actions/cache@v5
         # Loading cache of elephant-data
         id: cache-datasets
         with:
-          path: ~/elephant-data
+          # Relative to $GITHUB_WORKSPACE, so the cache version matches across OSs.
+          # The leading dot in '.ci-data' keeps pytest from collecting the data
+          path: .ci-data/elephant-data
           key: datasets-${{ steps.elephant-data.outputs.dataset_hash }}
           enableCrossOsArchive: true
 
