+      >>> output = m(inp)
+      >>> output.shape
+      (32, 25)
+      >>> # With non-default parameters
+      >>> m = Flatten(0, 2)
+      >>> output = m(inp)
+      >>> output.shape
+      (160, 5)
   """
 
