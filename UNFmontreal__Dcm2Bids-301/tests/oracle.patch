     sh = logging.StreamHandler(sys.stdout)
     sh.setLevel(log_level)
-    sh_fmt = logging.Formatter(fmt="%(levelname)-8s| %(message)s")
+    sh_fmt = CustomFormatter(fmt="%(levelname)-8s| %(message)s")
     sh.setFormatter(sh_fmt)
 
