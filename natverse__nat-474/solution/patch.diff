+
+# Private function returns a list of segments
+topntail_list <- function(x) {
+  if(use_natcpp()) {
+    return(natcpp::c_topntail_list(x))
+  }
+  topntailseg<-function(x) if(length(x)==1) x else x[c(1,length(x))]
+  # just get head and tail of each segment
