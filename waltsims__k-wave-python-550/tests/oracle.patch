+def cosd(angle_in_degrees):
+    """Compute cosine of angle in degrees."""
+    return np.cos(np.radians(angle_in_degrees))
+
+
+def sind(angle_in_degrees):
+    """Compute sine of angle in degrees."""
+    return np.sin(np.radians(angle_in_degrees))
