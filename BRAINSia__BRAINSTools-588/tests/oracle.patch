-  EXPECT_THROWS(BRAINSTools::safe_stod("3.14.15"), std::invalid_argument);
-
-  // Embedded space -- digit then space then digit is not a single number
-  EXPECT_THROWS(BRAINSTools::safe_stoi("4 2"), std::invalid_argument);
