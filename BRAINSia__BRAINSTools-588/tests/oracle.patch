-  // Trailing non-whitespace characters must still throw
-  EXPECT_THROWS(BRAINSTools::safe_stod("3.14abc"), std::invalid_argument);
-  EXPECT_THROWS(BRAINSTools::safe_stof("1.0f"), std::invalid_argument);
