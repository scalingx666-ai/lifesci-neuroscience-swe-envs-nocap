+    """
+    archive_basename = file_basename(archive)
+
+    # now we simply need to go through every file in that archive and
+    lgr.info(
+        "Adding content of the archive %s into annex %s", archive, annex
+    )
+    earchive = annexarchive.cache[key_rpath]
+
+    delete_after_rpath = None
+
+    prefix_dir = basename(tempfile.mkdtemp(prefix=".datalad",
+                                           dir=annex.path)) \
+        if delete_after \
+        else None
+
+    # dedicated stats for this archive, added to the overall ones at the end
+    stats = ActivityStats()
+
+    # paths added by this archive, merged into `prior_paths` only once we are
+    # through with it.  With --delete-after every archive extracts into its own
+    # temporary directory, so no two of them can ever collide and there is
+    # nothing to keep track of.
+    added_paths = {}
+    track_added = overwrite_prior_check != 'ignore' and not delete_after
+    if not track_added:
