         Relative modularity for each community
+
+    See Also
+    --------
+    netneurotools.modularity.get_modularity_z
+    netneurotools.modularity.get_modularity_sig
     """
 
     adjacency, comm = np.asarray(adjacency), np.asarray(comm)
