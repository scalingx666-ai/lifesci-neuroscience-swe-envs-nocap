diff --git a/src/csfft_OMP.c b/src/csfft_OMP.c
index b749c27c94..f42ef677bc 100644
--- a/src/csfft_OMP.c
+++ b/src/csfft_OMP.c
@@ -13,6 +13,17 @@
   ***** I'm not actually sure these functions work -- BEWARE !! :( *****
 
   ***** Instead ... try using the contents of file fftn_OMP.c *****
+
+  Fix (Oct 2026): fft_3dec_OMP, fft_4dec_OMP, and fft_5dec_OMP share one
+  twiddle-factor workspace (CFO_cs[rec][ithr]) but previously maintained
+  independent cache markers (CFO_rmold3/4/5).  A call through one radix
+  could overwrite the shared table without invalidating the other markers,
+  causing a subsequent call through a different radix to skip regeneration
+  and use twiddle factors computed for the wrong N.  The fix cross-invalidates
+  the other two radix markers whenever any radix regenerates the shared table,
+  forcing correct regeneration on the next call.
+  See GitHub issue #987 for the full diagnosis and test cases.
+
 ******************************************************************************/
 
 #include "mrilib.h"   /* AFNI package library header */
@@ -72,9 +83,13 @@ static int      *CFO_sclinv =NULL ;  /* per-thread inverse scaling flag */
 static int      *CFO_recC   =NULL ;  /* per-thread recursion level for csfft_cox_OMP */
 static int      *CFO_recX   =NULL ;  /* per-thread recursion level for decimaion funcs */
 
-static int *CFO_rmold3[RMAX] ;       /* per-thread, per-recursion last M value used */
-static int *CFO_rmold4[RMAX] ;       /* for decimation by 3, 4, 5 functions */
-static int *CFO_rmold5[RMAX] ;
+/* All three radix routines share one workspace (CFO_cs[rec][ithr]); when
+   any radix regenerates the table it zeros the other two markers so they
+   are forced to regenerate rather than reading stale factors.  0 is a safe
+   sentinel: no valid FFT sub-transform length M is ever 0.                   */
+static int *CFO_rmold3[RMAX] ;  /* per-thread, per-recursion last M used by fft_3dec */
+static int *CFO_rmold4[RMAX] ;  /* per-thread, per-recursion last M used by fft_4dec */
+static int *CFO_rmold5[RMAX] ;  /* per-thread, per-recursion last M used by fft_5dec */
 
 static int     *nCFO_aa[RMAX] ;      /* per-thread, per-recursion temp arrays */
 static int     *nCFO_bb[RMAX] ;      /* nCFO_aa[r][i] is the size of the 'aa' */
@@ -2511,13 +2526,18 @@ static void fft_4dec_OMP( int mode , int idim , complex *xc )
    CFO_assign(cc,M) ;
    CFO_assign(dd,M) ;
 
-   mold = CFO_rmold4[rec][ithr] ;  /* what was done before at this recursion level */
+   mold = CFO_rmold4[rec][ithr] ;  /* last M used by fft_4dec at this [rec][ithr] */
 
   { if( M != mold ){
+      /* The cs workspace at this [rec][ithr] slot is shared by all
+         three radix routines; regenerating it here invalidates any
+         table a different radix may have left behind, so zero their
+         markers to force them to regenerate when next called.        */
       double th = (2.0*PI/N) ;
       cs[0].r = 1.0 ; cs[0].i = 0.0 ;
       for( k=1 ; k < M3 ; k++ ){ cs[k].r = cos(k*th); cs[k].i = sin(k*th); }
       CFO_rmold4[rec][ithr] = M ;
+      CFO_rmold3[rec][ithr] = CFO_rmold5[rec][ithr] = 0 ;
   }}
 
    /*-- load subarrays, and FFT each one --*/
@@ -2666,13 +2686,18 @@ static void fft_3dec_OMP( int mode , int idim , complex *xc )
    CFO_assign(bb,M) ;
    CFO_assign(cc,M) ;
 
-   mold = CFO_rmold3[rec][ithr] ;  /* what was done before at this recursion level */
+   mold = CFO_rmold3[rec][ithr] ;  /* last M used by fft_3dec at this [rec][ithr] */
 
   { if( M != mold ){
+      /* The cs workspace at this [rec][ithr] slot is shared by all
+         three radix routines; regenerating it here invalidates any
+         table a different radix may have left behind, so zero their
+         markers to force them to regenerate when next called.        */
       double th = (2.0*PI/N) ;
       cs[0].r = 1.0 ; cs[0].i = 0.0 ;
       for( k=1 ; k < M2 ; k++ ){ cs[k].r = cos(k*th); cs[k].i = sin(k*th); }
       CFO_rmold3[rec][ithr] = M ;
+      CFO_rmold4[rec][ithr] = CFO_rmold5[rec][ithr] = 0 ;
    }}
 
    /*-- load subarrays, and FFT each one --*/
@@ -2794,13 +2819,18 @@ static void fft_5dec_OMP( int mode , int idim , complex *xc )
    CFO_assign(dd,M) ;
    CFO_assign(ee,M) ;
 
-   mold = CFO_rmold5[rec][ithr] ;  /* what was done before at this recursion level */
+   mold = CFO_rmold5[rec][ithr] ;  /* last M used by fft_5dec at this [rec][ithr] */
 
   { if( M != mold ){           /* new M? */
+      /* The cs workspace at this [rec][ithr] slot is shared by all
+         three radix routines; regenerating it here invalidates any
+         table a different radix may have left behind, so zero their
+         markers to force them to regenerate when next called.        */
       double th = (2.0*PI/N) ;
       cs[0].r = 1.0 ; cs[0].i = 0.0 ;
       for( k=1 ; k < M4 ; k++ ){ cs[k].r = cos(k*th); cs[k].i = sin(k*th); }
       CFO_rmold5[rec][ithr] = M ;
+      CFO_rmold3[rec][ithr] = CFO_rmold4[rec][ithr] = 0 ;
    }}
 
    /*-- load subarrays, and FFT each one --*/
diff --git a/src/src_notes/test_01_3dClustSim.tcsh b/src/src_notes/test_01_3dClustSim.tcsh
new file mode 100644
index 0000000000..cbc5ac3206
--- /dev/null
+++ b/src/src_notes/test_01_3dClustSim.tcsh
@@ -0,0 +1,176 @@
+#!/bin/tcsh
+
+# file for testing old/new 3dClustSim
+
+# 2026-10/26 : [pt] test new radix table updates, which only apply in
+#              some specific cases. Hence, we need a mask dset dimension
+#              of a given size (for particular acf and voxel size), to make
+#              a comparison case; for these specific input voxel dims and
+#              padded matrix, the padded dims should end up being: 120x120x80
+# 
+# ===========================================================================
+
+set prog = 3dClustSim
+set idx  = 01
+
+# ---------------------------------------------------------------------------
+# set locations of old and new program versions, for comparisons
+
+set path_old = ${HOME}/afni_build_ORIG
+set path_old = ${path_old}/src/linux_ubuntu_16_64_glw_local_shared/
+set path_new = ${HOME}/afni_build/src/linux_ubuntu_16_64_glw_local_shared
+
+set prog_old = ${path_old}/${prog}
+set prog_new = ${path_new}/${prog}
+
+# output dir for results and a text file
+
+set dir_test = odir_test-${idx}-${prog}
+set txt_diff = ${dir_test}/all_diffs.txt
+# ---------------------------------------------------------------------------
+
+# ---------------------------------------------------------------------------
+# generic checks to be able to run testing
+
+if ( ! -f ${prog_old} ) then
+    echo "** ERROR: cannot find prog old:"
+    echo "   ${prog_old}"
+    exit -1
+endif
+
+if ( ! -f ${prog_new} ) then
+    echo "** ERROR: cannot find prog new:"
+    echo "   ${prog_new}"
+    exit -1
+endif
+
+if ( -d ${dir_test} ) then
+    echo ""
+    echo "** ERROR: already have output testing dir."
+    echo "   Consider running the following to remove it:"
+    echo ""
+    echo "     \\rm -rf ${dir_test}"
+    echo ""
+    exit -1
+endif
+
+echo "++++ Passed first checks to be able to run test. Continuing."
+# ---------------------------------------------------------------------------
+
+# ===========================================================================
+# extra checks, specific to this dset
+
+# test data 1: findable?
+
+if ( ! -f mask.auto.nii.gz ) then
+    echo "** ERROR: cannot find output mask"
+    echo "   Is this being run in: ~/AFNI_data6/afni/ ? It should be..."
+    exit -1
+else
+    echo "++ Found input mask"
+    echo "   ... just proceeding with comparison"
+endif
+
+if ( ! -f _tmp_pad_mask.auto.nii.gz ) then
+    echo "++ Making zeropadded mask for this test, to have a particular"
+    echo "   dimension/size"
+
+    3dZeropad                                             \
+        -overwrite                                        \
+        -prefix     _tmp_pad_mask.auto.nii.gz             \
+        -I          10                                    \
+        mask.auto.nii.gz
+else
+    echo "++ Found padded input mask"
+    echo "   ... just proceeding with comparison"
+endif
+
+### in case you want to test single
+# setenv OMP_NUM_THREADS 1
+
+# ===========================================================================
+
+# ---------------------------------------------------------------------------
+# make output dir for test results (and init/clear a text file of diffs)
+
+\mkdir -p ${dir_test}
+printf '' > ${txt_diff}
+# ---------------------------------------------------------------------------
+
+# ===========================================================================
+
+# all tests are basically the same, just need to index by 2-digit code
+set all_ii = `count_afni -digits 2 1 1`
+
+foreach ii ( ${all_ii} )
+
+    set bname   = ${dir_test}/test-${ii}
+
+    set out_old = ${bname}-old_csim 
+    set out_new = ${bname}-new_csim
+    set out_log = ${bname}-plot-log.txt
+
+    # special things done when running here:
+    # + want to record time of each, so this records time values as
+    #   integers that count milliseconds: date +%s%3N
+    # + the acf values used here come from the Bootcamp processed data,
+    #   just to be realistic examples
+
+    set time0 = `date +%s%3N`
+    ${prog_old}                              \
+        -prefix  ${out_old}                  \
+        -mask    _tmp_pad_mask.auto.nii.gz   \
+        -acf     0.738202  3.2154  11.9615   \
+        -iter    10000
+    set time1 = `date +%s%3N`
+    @ time_ms_old = ${time1} - ${time0}
+
+    set time0 = `date +%s%3N`
+    ${prog_new}                              \
+        -prefix  ${out_new}                  \
+        -mask    _tmp_pad_mask.auto.nii.gz   \
+        -acf     0.738202  3.2154  11.9615   \
+        -iter    10000
+    set time1 = `date +%s%3N`
+    @ time_ms_new = ${time1} - ${time0}
+
+    @ time_diff_ms = ${time_ms_new} - ${time_ms_old}
+
+    set time_diff_frac = `echo "scale = 1; 100.0*(${time_ms_new} - ${time_ms_old})/(1.0*${time_ms_old}) " | bc`
+
+cat <<EOF
+
+++ Time info (number of ms) for run: ${ii} 
+   old  : ${time_ms_old}
+   new  : ${time_ms_new}
+   diff : ${time_diff_ms}
+   perc : ${time_diff_frac} %
+
+EOF
+
+cat <<EOF
+---------------------------
+++ And check out these dsets:
+    
+   meld ${out_old}.NN2_bisided.1D \
+        ${out_new}.NN2_bisided.1D
+
+   Hopefully:
+    + integer part of values is similar, esp. as p-values decrease
+
+EOF
+
+
+end
+
+# ===========================================================================
+
+echo "++ DONE.  Check diffs file:"
+echo "-------------------------------------------------"
+cat ${txt_diff}
+echo "-------------------------------------------------"
+
+exit 0
+
+
+
