diff --git a/jsx/form/NumberInput.tsx b/jsx/form/NumberInput.tsx
new file mode 100644
index 0000000000..ef60a18ac9
--- /dev/null
+++ b/jsx/form/NumberInput.tsx
@@ -0,0 +1,38 @@
+import React, {forwardRef} from 'react';
+import {useFieldControl} from 'jsx/form/Field';
+
+type NumberInputProps = Omit<
+  React.ComponentPropsWithoutRef<'input'>,
+  'type' | 'value' | 'onChange'
+> & {
+  // The current value, as typed
+  value: string;
+  // Called with the new value, as typed
+  onChange: (value: string) => void;
+  // Whether the input holds an invalid value
+  invalid?: boolean;
+};
+
+/**
+ * Number input React component
+ * Takes any input attribute. Inside a Field, it takes its id, required,
+ * disabled and invalid state from the Field.
+ */
+const NumberInput = forwardRef<HTMLInputElement, NumberInputProps>(
+  function NumberInput({value, onChange, invalid, className, ...props}, ref) {
+    const control = useFieldControl({...props, invalid});
+    return (
+      <input
+        {...props}
+        {...control}
+        ref={ref}
+        type="number"
+        className={className ? 'form-control ' + className : 'form-control'}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+      />
+    );
+  }
+);
+
+export default NumberInput;
diff --git a/jsx/form/TextareaInput.tsx b/jsx/form/TextareaInput.tsx
new file mode 100644
index 0000000000..e7028ae0b6
--- /dev/null
+++ b/jsx/form/TextareaInput.tsx
@@ -0,0 +1,43 @@
+import React, {forwardRef} from 'react';
+import {useFieldControl} from 'jsx/form/Field';
+
+type TextareaInputProps = Omit<
+  React.ComponentPropsWithoutRef<'textarea'>,
+  'value' | 'onChange' | 'onBlur'
+> & {
+  // The current text
+  value: string;
+  // Called with the new text
+  onChange: (value: string) => void;
+  // Called with the text when the textarea loses focus
+  onBlur?: (value: string) => void;
+  // Whether the textarea holds an invalid value
+  invalid?: boolean;
+};
+
+/**
+ * Multiline text input React component
+ * Takes any textarea attribute. Inside a Field, it takes its id, required,
+ * disabled and invalid state from the Field.
+ */
+const TextareaInput = forwardRef<HTMLTextAreaElement, TextareaInputProps>(
+  function TextareaInput(
+    {value, onChange, onBlur, invalid, className, ...props},
+    ref,
+  ) {
+    const control = useFieldControl({...props, invalid});
+    return (
+      <textarea
+        {...props}
+        {...control}
+        ref={ref}
+        className={className ? 'form-control ' + className : 'form-control'}
+        value={value}
+        onChange={(e) => onChange(e.target.value)}
+        onBlur={(e) => onBlur?.(e.target.value)}
+      />
+    );
+  }
+);
+
+export default TextareaInput;
