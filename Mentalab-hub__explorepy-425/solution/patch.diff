+CALIB_LENGTH_STR = "calib"
+WINDOW_STR = "window"
+REC_TIME_STR = "t"
+
+EEGPREP_STR = "eegprep"
+CALIBRATION_DATA_STR = "calibdata"
+FILTERED_STR = "filtered"
+ASR_CLEANED_STR = "asrcleaned"
