+   "outputs": [
+    {
+     "data": {
+      "text/plain": [
+       "array([ 2.03219939,  2.5261983 ,  1.9998798 ,  2.53002688,  1.51648434,\n",
+       "        1.50259231,  2.52335528,  2.01688269,  1.51448427,  2.52317579])"
