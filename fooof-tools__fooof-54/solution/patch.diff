+  },
+  {
+   "cell_type": "code",
+   "execution_count": 8,
+   "metadata": {
+    "collapsed": true
+   },
+   "outputs": [],
+   "source": [
+    "# Extract slope data from group results\n",
+    "sls = fg.get_all_data('background_params', 1)"
