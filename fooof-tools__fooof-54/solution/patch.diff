+    "# Loop through the problem fits, checking the plots, and saving out reports, to check later. \n",
+    "for ind, fm in enumerate(to_check):\n",
+    "    fm.plot()\n",
+    "    fm.save_report('Report_ToCheck_#' + str(ind))"
+   ]
+  },
