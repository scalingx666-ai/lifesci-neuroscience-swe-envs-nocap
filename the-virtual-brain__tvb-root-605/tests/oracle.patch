+        pre = self.cmin + \
+              (self.cmax - self.cmin) / (1.0 + numpy.exp(self.r * (self.midpoint - (x_j[:, 0] - x_j[:, 1]))))
         return pre[:, numpy.newaxis]
 
     def post(self, gx):
