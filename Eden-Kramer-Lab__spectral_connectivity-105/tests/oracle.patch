+    signals = np.random.default_rng(3).standard_normal((512, 10, 5))
+    signals[1:, :, 1] += 0.6 * signals[:-1, :, 0]
+    signals[2:, :, 3] += 0.4 * signals[:-2, :, 4]
+
+    def compute():
