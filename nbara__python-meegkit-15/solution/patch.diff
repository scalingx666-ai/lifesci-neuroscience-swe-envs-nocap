+    """Test yulewalk filter."""
+    rawp = raw.copy()
+    n_chan_orig = rawp.shape[0]
+    rawp = np.random.randn(n_chans, n_chan_orig) @ rawp
+    raw_filt, iirstate = yulewalk_filter(rawp, sfreq)
+
