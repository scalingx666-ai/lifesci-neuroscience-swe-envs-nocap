+def test_channels_tsv_nirs_types(tmp_path):
+    """Optical density and hemoglobin channels get their BIDS types."""
+    ch_names = ["S1_D1 760", "S1_D1 850", "S1_D1 hbo", "S1_D1 hbr"]
+    ch_types = ["fnirs_od", "fnirs_od", "hbo", "hbr"]
