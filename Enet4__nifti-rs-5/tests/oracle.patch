+            .into_volume();
+        assert_eq!(volume.data_type(), dtype);
+
+        let data = volume.to_ndarray::<T>().unwrap();
+        for (idx, val) in data.iter().enumerate() {
+            assert_eq!(idx.as_::<T>(), *val);
+        }
+    }
 }
