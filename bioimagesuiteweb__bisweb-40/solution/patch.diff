+    
+    globalParams.brainmesh[index] = new THREE.Mesh(globalParams.braingeom[index],material);
+    globalParams.brainmesh[index].visible=true;
+    globalParams.internal.subviewers[3].scene.add(globalParams.brainmesh[index]);
