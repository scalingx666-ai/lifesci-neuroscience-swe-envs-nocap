diff --git a/.github/workflows/R-CMD-check.yaml b/.github/workflows/R-CMD-check.yaml
index 091b59eb..63edb774 100644
--- a/.github/workflows/R-CMD-check.yaml
+++ b/.github/workflows/R-CMD-check.yaml
@@ -81,14 +81,6 @@ jobs:
           extra-packages: any::rcmdcheck
           needs: check
 
-      # On Windows, with ITK's default thread pool the tests pass but R never
-      # exits afterwards; the Platform threader keeps no persistent worker
-      # threads, so the process can shut down.
-      - name: Use ITK Platform threader - WINDOWS
-        if: runner.os == 'Windows'
-        shell: bash
-        run: echo "ITK_GLOBAL_DEFAULT_THREADER=Platform" >> "$GITHUB_ENV"
-
       # On Windows the install R CMD build does before building vignettes
       # hangs until the 6h job limit, even though the install above succeeds,
       # so skip vignettes there; other platforms still build them.
diff --git a/tests/testthat.R b/tests/testthat.R
index eeff64bb..894ba851 100644
--- a/tests/testthat.R
+++ b/tests/testthat.R
@@ -1,3 +1,14 @@
+# On Windows, with ITK's default thread pool the tests pass but R never exits
+# afterwards (seen in R CMD check on GitHub Actions; r-universe and CRAN
+# checks run the same way). The Platform threader keeps no persistent worker
+# threads, so the process can shut down. ITK reads this when it first creates
+# its threader, so it must be set before ANTsR/ANTsRCore are loaded; an
+# existing setting is respected.
+if (.Platform$OS.type == "windows" &&
+  !nzchar(Sys.getenv("ITK_GLOBAL_DEFAULT_THREADER"))) {
+  Sys.setenv(ITK_GLOBAL_DEFAULT_THREADER = "Platform")
+}
+
 library(methods)
 library(testthat)
 library(ANTsR)
