diff --git a/doc/changes/dev/14361.newfeature.rst b/doc/changes/dev/14361.newfeature.rst
new file mode 100644
index 00000000000..1057aa59b8b
--- /dev/null
+++ b/doc/changes/dev/14361.newfeature.rst
@@ -0,0 +1,3 @@
+Add timing metadata to GIFTI files written by
+:meth:`mne.SourceEstimate.save_as_surface`, allowing readers to recover the
+original time axis, by `Peter Molfese`_.
diff --git a/mne/source_estimate.py b/mne/source_estimate.py
index bd224ca5f0b..20c9525c270 100644
--- a/mne/source_estimate.py
+++ b/mne/source_estimate.py
@@ -2138,6 +2138,11 @@ def save_as_surface(self, fname, src, *, scale=1, scale_rr=1e3):
 
         Notes
         -----
+        .. versionchanged:: 1.14
+            The time-series GIFTI files store ``TimeStart`` and ``TimeStep`` in
+            seconds as image metadata. Each data array also stores its zero-based
+            sample index and time value in seconds.
+
         .. versionadded:: 1.7
         """
         nib = _import_nibabel()
@@ -2175,17 +2180,34 @@ def save_as_surface(self, fname, src, *, scale=1, scale_rr=1e3):
             # Make the Time Series data arrays
             ts = []
             data = getattr(self, f"{hemi}_data") * scale
-            ts = [
-                nib.gifti.gifti.GiftiDataArray(
-                    data=data[:, idx].astype(np.float32),
-                    intent="NIFTI_INTENT_POINTSET",
-                    datatype="NIFTI_TYPE_FLOAT32",
+            image_meta = nib.gifti.GiftiMetaData(
+                {
+                    "TimeStart": repr(float(self.tmin)),
+                    "TimeStep": repr(float(self.tstep)),
+                    "TimeUnits": "s",
+                    "TimeSamples": str(len(self.times)),
+                }
+            )
+            for idx, time in enumerate(self.times):
+                array_meta = nib.gifti.GiftiMetaData(
+                    {
+                        "TimeIndex": str(idx),
+                        "TimeValue": repr(float(time)),
+                        "TimeUnits": "s",
+                        "Name": f"{time:g} s",
+                    }
+                )
+                ts.append(
+                    nib.gifti.GiftiDataArray(
+                        data=data[:, idx].astype(np.float32),
+                        intent="NIFTI_INTENT_POINTSET",
+                        datatype="NIFTI_TYPE_FLOAT32",
+                        meta=array_meta,
+                    )
                 )
-                for idx in range(data.shape[1])
-            ]
 
             # save the time series
-            ts_gi = nib.gifti.gifti.GiftiImage(darrays=ts)
+            ts_gi = nib.gifti.GiftiImage(darrays=ts, meta=image_meta)
             nib.save(ts_gi, f"{fname}-{hemi}.time.gii")
 
     def expand(self, vertices):
