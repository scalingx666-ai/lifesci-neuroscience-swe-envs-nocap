+        noiselevel = 1,
+        return_epoched = true,
+    )
+
+    # time expanded
+    m = fit(
+        UnfoldModel,
+        [Any => (@formula(0 ~ 1 + condition), firbasis((-0.1, 1), 100))],
+        evts,
+        data;
+    )
+    m_e = fit(
+        UnfoldModel,
+        [Any => (@formula(0 ~ 1 + condition), 1:size(data_e, 1))],
+        evts,
+        data_e;
+    )
+    _r2 = Unfold.r2(m, data)
+    @test length(_r2) == 1
+    @test isapprox(_r2[1], 0.74, atol = 0.01)
