+def _accumulate_csr_log_sums(ma_values, log_sums):
+    """Accumulate ALE log-sums from a CSR matrix into an existing buffer."""
+    if ma_values.nnz:
+        log_sums += np.bincount(
+            ma_values.indices,
+            weights=np.log1p(-ma_values.data),
+            minlength=ma_values.shape[1],
+        )
