diff --git a/frontend/javascripts/libs/async/latest_task_executor.ts b/frontend/javascripts/libs/async/latest_task_executor.ts
index a893ee31cc6..d9b249d9202 100644
--- a/frontend/javascripts/libs/async/latest_task_executor.ts
+++ b/frontend/javascripts/libs/async/latest_task_executor.ts
@@ -62,14 +62,25 @@ export default class LatestTaskExecutor<T> {
     });
     // @ts-expect-error ts-migrate(2322) FIXME: Type '{ task: Task<T>; deferred: Deferred<T, Error... Remove this comment to see the full error message
     this.taskQueue = [latestTask];
-    // Start the latest task
-    const promise = task();
-    // @ts-expect-error ts-migrate(7006) FIXME: Parameter 'result' implicitly has an 'any' type.
-    promise.then((result) => {
-      this.taskQueue.shift();
-      deferred.resolve(result);
-
-      this.__executeLatestPromise();
-    });
+    // Start the latest task. A synchronous exception of task() is treated
+    // like a rejection so that the queue always advances.
+    let promise: Promise<T>;
+    try {
+      promise = task();
+    } catch (error) {
+      promise = Promise.reject(error);
+    }
+    promise
+      .then(
+        (result) => {
+          this.taskQueue.shift();
+          deferred.resolve(result);
+        },
+        (error) => {
+          this.taskQueue.shift();
+          deferred.reject(error);
+        },
+      )
+      .then(() => this.__executeLatestPromise());
   }
 }
diff --git a/frontend/javascripts/test/libs/latest_task_executor.spec.ts b/frontend/javascripts/test/libs/latest_task_executor.spec.ts
index a5899c909fa..b0d4d2a5935 100644
--- a/frontend/javascripts/test/libs/latest_task_executor.spec.ts
+++ b/frontend/javascripts/test/libs/latest_task_executor.spec.ts
@@ -59,4 +59,38 @@ describe("LatestTaskExecutor", () => {
     const result3 = await scheduledPromise3;
     expect(result3).toBe(3);
   });
+
+  it("a rejected task rejects its caller and the next task still runs", async () => {
+    const executor = new LatestTaskExecutor<number>();
+    const deferred1 = new Deferred<number, unknown>();
+    const deferred2 = new Deferred<number, unknown>();
+    const scheduledPromise1 = executor.schedule(() => deferred1.promise());
+    const scheduledPromise2 = executor.schedule(() => deferred2.promise());
+    deferred1.reject(new Error("task 1 failed"));
+    await expect(scheduledPromise1).rejects.toThrowError("task 1 failed");
+
+    deferred2.resolve(2);
+    expect(await scheduledPromise2).toBe(2);
+    expect(executor.taskQueue.length).toBe(0);
+  });
+
+  it("a synchronously throwing task rejects its caller and the next task still runs", async () => {
+    const executor = new LatestTaskExecutor<number>();
+    const scheduledPromise1 = executor.schedule(() => {
+      throw new Error("sync failure");
+    });
+    const scheduledPromise2 = executor.schedule(() => Promise.resolve(2));
+    await expect(scheduledPromise1).rejects.toThrowError("sync failure");
+    expect(await scheduledPromise2).toBe(2);
+    expect(executor.taskQueue.length).toBe(0);
+  });
+
+  it("recovers from a rejection when tasks are scheduled afterwards", async () => {
+    const executor = new LatestTaskExecutor<number>();
+    await expect(executor.schedule(() => Promise.reject(new Error("failed")))).rejects.toThrowError(
+      "failed",
+    );
+    expect(await executor.schedule(() => Promise.resolve(3))).toBe(3);
+    expect(executor.taskQueue.length).toBe(0);
+  });
 });
