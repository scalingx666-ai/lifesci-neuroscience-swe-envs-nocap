+  cdef uint64_t[:] ysum = np.zeros( (labels.size,), dtype=np.uint64)
+  cdef uint32_t[:] labelct = np.zeros( (labels.size,), dtype=np.uint32)
+
+  cdef size_t sx, sy
+  sx = labels.shape[0]
+  sy = labels.shape[1]
+
+  cdef size_t x, y
+  cdef uint32_t label = 0
+
+  for x in range(sx):
+    for y in range(sy):
+      label = labels[x,y]
+      if label == 0:
+        continue
+
+      xsum[label] += x 
+      ysum[label] += y 
+      labelct[label] += 1
+
