+      dist2 = cornerness( x,  y, sx, sy)
+      if dist2 < dist1:
+        return (x, y)
+      elif dist1 == dist2:
+        dist1 = edgeness(px, py, sx, sy)
+        dist2 = edgeness( x,  y, sx, sy)
+        if dist2 < dist1:
