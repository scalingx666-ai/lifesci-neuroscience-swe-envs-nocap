+  assert np.all(skel.vertices[:,1] == 129)
+  assert np.all(skel.vertices[:,2] == 129)
+
+def test_fix_borders_y():
+  labels = np.zeros((256, 256, 256), dtype=np.uint8)
+  labels[ 64:196, :, 64:196 ] = 128
+
+  skels = kimimaro.skeletonize(
+    labels,
