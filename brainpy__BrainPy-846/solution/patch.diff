+
+            set_default_fdeint('l1')
+            intg2 = fdeint(alpha=0.8, num_memory=20, inits=[1.], f=lambda y, t: -y)
+            self.assertIsInstance(intg2, bp.fde.CaputoL1Schema)
+        finally:
