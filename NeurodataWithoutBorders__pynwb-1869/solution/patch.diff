+
+class TestSpatialSeriesIO(AcquisitionH5IOMixin, TestCase):
+
+    def setUpContainer(self):
+        """ Return the test TimeSeries to read/write """
+        return SpatialSeries(
+            name='test_sS',
+            data=np.ones((3, 2)),
+            bounds=[(-1,1),(-1,1),(-1,1)],
+            reference_frame='reference_frame',
+            timestamps=[1., 2., 3.]
+        )
