+        if (!pts.count(tri.at(2))) {
+            pts.emplace(tri.at(2), idx++);
+        }
+    }
+
+    robin_hood::unordered_flat_map<uint32_t, PositionType> ipts;
+    for (auto it : pts) {
+      ipts[it.second] = it.first;
