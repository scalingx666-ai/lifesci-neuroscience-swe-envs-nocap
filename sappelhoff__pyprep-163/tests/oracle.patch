-# axs[0, 0].set_ylabel('Channel Number', fontsize=14)
-cb = fig.colorbar(im, ax=axs, fraction=0.05, pad=0.04)
-cb.set_label("\u03bcVolt", fontsize=14)
-
-EEG_new_matlab = sio.loadmat(fname_mat2)
