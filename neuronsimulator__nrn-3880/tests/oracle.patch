diff --git a/.github/workflows/neuron-ci.yml b/.github/workflows/neuron-ci.yml
index 9f5510db09..2ca5508052 100644
--- a/.github/workflows/neuron-ci.yml
+++ b/.github/workflows/neuron-ci.yml
@@ -87,7 +87,9 @@ jobs:
               cmake_option: -DNRN_ENABLE_CORENEURON=ON -DNRN_ENABLE_INTERVIEWS=OFF
                 -DNRN_ENABLE_RX3D=OFF
               sanitizer: address
-          - os: macOS-14
+          # arm64 (3-core M1). macOS-15-intel above is the separate x86_64 image.
+          # macos-14 retires 2026-11-02; macos-15 is the same runner class.
+          - os: macOS-15
             config:
               build_mode: cmake
               # TODO: investigate rxd test timeouts in this build and re-enable them
@@ -121,7 +123,8 @@ jobs:
           brew unlink mpich
           brew install openmpi
           brew install --cask xquartz
-          if [[ "${{matrix.os}}" == "macOS-14" ]]; then
+          # arm64 only. Prefer Homebrew CMake over actions-setup-cmake (#3585).
+          if [[ "${{matrix.os}}" == "macOS-15" ]]; then
             brew uninstall cmake || echo "CMake was not pre-installed"
             brew install cmake
             echo "$(brew --prefix)/opt/cmake/bin" >> $GITHUB_PATH
