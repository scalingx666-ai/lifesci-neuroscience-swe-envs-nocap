+/* small helper function. Take 3 integers are arguments, and return
+   the index of the smallest one (if there is a tie, return the leftmost) */
+int smallest_dim3(int D0, int D1, int D2 )
+{
+   if ( D0 <= D1 && D0 <= D2 )
+      return 0;
+   
+   if ( D1 <= D2 )
+      return 1;
+
+   return 2;
+}
