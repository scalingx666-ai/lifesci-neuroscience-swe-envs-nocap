+  /^[a-z][a-z0-9+.-]*:\//i.test(value)
+
+const isRecognizedFilesystemError = (error: unknown) => {
+  if (!isRecord(error)) {
+    return false
+  }
+  return typeof error.code === 'string' && FILESYSTEM_ERROR_CODES.has(error.code)
+}
+
+const isRecognizedSQLiteError = (error: unknown) => {
+  if (!isRecord(error)) {
