@@ -232,6 +272,10 @@ PROFILE_DIR="$OUT_DIR/profile"
 BASE_URL="http://${HOST}:${PORT}"
 RESULT_JSONL="$OUT_DIR/bench_runs.jsonl"
 : > "$RESULT_JSONL"
+# Separate sink for the optional COLD full-round (BENCH_COLD_FINAL=1); kept apart
