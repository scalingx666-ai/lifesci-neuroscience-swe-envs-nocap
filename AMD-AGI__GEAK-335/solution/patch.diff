+: > "$COLD_JSONL"
 
 # export everything the adapter reads
 export MODEL HOST PORT TP GPU MEM_FRACTION EXTRA_SERVER_ARGS EXTRA_ENV OVERLAY_PYTHONPATH
@@ -253,11 +297,29 @@ echo
 
 SERVER_PID=""
 cleanup() {
