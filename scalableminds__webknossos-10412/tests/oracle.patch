-	size_t index = 0;
-	const size_t window_size = rle_windows.size();
-
-	for (size_t i = 0; i < window_size; i++) {
-		block = rle_windows[i];
-		if (block & 1) {
-			index += (block >> 1);
-		}
-		else {
-			windows.at(index) = block >> 1;
-			index++;
-		}
-	}
-
-	return windows;
