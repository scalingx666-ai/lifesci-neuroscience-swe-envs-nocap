-					WINDOW value = window_values.at(windows[block]);
-					boundaries[iv] = (value >> offset) & 0b1;
-				}
-			}
-			else {
-				for (size_t x = 0; x < sx; x++) {
-					size_t iv = x + sx * y + sxy * z;
-					xblock = x / xstep;
-					xoffset = x % xstep;
-
-					size_t block = xblock + yblock + zblock;
-					size_t offset = xoffset + yoffset + zoffset;
-
-					WINDOW value = window_values.at(windows[block]);
