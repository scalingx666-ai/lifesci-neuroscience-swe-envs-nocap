diff --git a/doc/changes/dev/14457.bugfix.rst b/doc/changes/dev/14457.bugfix.rst
new file mode 100644
index 00000000000..7e74c698bb7
--- /dev/null
+++ b/doc/changes/dev/14457.bugfix.rst
@@ -0,0 +1 @@
+Fix bug in :func:`mne.preprocessing.regress_artifact` where passing ``betas`` caused the ``picks_artifact`` value to be passed as ``exclude`` and the default ``picks_artifact="eog"`` to be used instead, by `Johannes Herforth`_.
diff --git a/mne/preprocessing/_regress.py b/mne/preprocessing/_regress.py
index fc796c50586..6d1bb216c06 100644
--- a/mne/preprocessing/_regress.py
+++ b/mne/preprocessing/_regress.py
@@ -106,7 +106,9 @@ def regress_artifact(
         picks_artifact = _picks_to_idx(inst.info, picks_artifact)
         want_betas_shape = (len(picks), len(picks_artifact))
         _check_option("betas.shape", betas.shape, (want_betas_shape,))
-        model = EOGRegression(picks, picks_artifact, proj=proj)
+        model = EOGRegression(
+            picks=picks, exclude=exclude, picks_artifact=picks_artifact, proj=proj
+        )
         model.info_ = inst.info.copy()
         model.coef_ = betas
     return model.apply(inst, copy=copy), model.coef_
