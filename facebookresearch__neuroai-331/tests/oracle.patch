diff --git a/neuralbench-repo/neuralbench/test_cli.py b/neuralbench-repo/neuralbench/test_cli.py
index f471b6af8..bbffbe721 100644
--- a/neuralbench-repo/neuralbench/test_cli.py
+++ b/neuralbench-repo/neuralbench/test_cli.py
@@ -88,6 +88,22 @@ def test_cluster_config_wires_all_infra_clusters(
     assert raw["data"]["target"]["infra"]["cluster"] == cluster
 
 
+@pytest.mark.parametrize(("account", "qos"), [("my_account", "my_qos"), ("", "")])
+def test_slurm_account_and_qos_wire_training_infra_only(
+    patch_config: Callable[..., None], account: str, qos: str
+) -> None:
+    """SLURM_ACCOUNT/SLURM_QOS reach the training infra (empty means None); the
+    feature-extraction cache infras keep Slurm's default account and QoS."""
+    patch_config(SLURM_ACCOUNT=account, SLURM_QOS=qos)
+    raw = load_yaml_config(DEFAULTS_DIR / "config.yaml")
+    assert raw is not None
+    assert raw["infra"]["slurm_account"] == (account or None)
+    assert raw["infra"]["slurm_qos"] == (qos or None)
+    for infra in (raw["data"]["neuro"]["infra"], raw["data"]["target"]["infra"]):
+        assert "slurm_account" not in infra
+        assert "slurm_qos" not in infra
+
+
 @pytest.mark.parametrize("cluster", [None, "slurm"])
 def test_task_configs_do_not_override_infra_cluster(
     patch_config: Callable[..., None], cluster: str | None
diff --git a/neuralbench-repo/neuralbench/test_config_manager.py b/neuralbench-repo/neuralbench/test_config_manager.py
index a608cf5ec..32d758bc6 100644
--- a/neuralbench-repo/neuralbench/test_config_manager.py
+++ b/neuralbench-repo/neuralbench/test_config_manager.py
@@ -54,3 +54,21 @@ def test_cluster_resolves_to_configured_value(
     """A non-null CLUSTER value is surfaced verbatim."""
     patch_config(CLUSTER="slurm")
     assert config_manager.CLUSTER == "slurm"
+
+
+@pytest.mark.parametrize("key", ["SLURM_ACCOUNT", "SLURM_QOS"])
+def test_slurm_account_and_qos_resolve_to_configured_value(
+    patch_config: Callable[..., None], key: str
+) -> None:
+    patch_config(**{key: "my_value"})
+    assert getattr(config_manager, key) == "my_value"
+
+
+@pytest.mark.parametrize("key", ["SLURM_ACCOUNT", "SLURM_QOS"])
+@pytest.mark.parametrize("value", ["", None])
+def test_slurm_account_and_qos_unset_resolve_to_none(
+    patch_config: Callable[..., None], key: str, value: str | None
+) -> None:
+    """Empty or null values leave SLURM's per-user default instead of ``--qos=``."""
+    patch_config(**{key: value})
+    assert getattr(config_manager, key) is None
