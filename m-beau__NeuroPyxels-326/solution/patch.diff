+@contextlib.contextmanager
+def redirect_stdout_fd(file):
+    stdout_fd = sys.stdout.fileno()
+    stdout_fd_dup = os.dup(stdout_fd)
+    os.dup2(file.fileno(), stdout_fd)
+    file.close()
+    try:
+        yield
+    finally:
+        os.dup2(stdout_fd_dup, stdout_fd)
+        os.close(stdout_fd_dup)
+
+
