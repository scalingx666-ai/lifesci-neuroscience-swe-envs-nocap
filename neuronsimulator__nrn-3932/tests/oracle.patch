+
+void read_bbcore_token(FILE* fp, char* buf, size_t n) {
+    nrn_assert(fp);
+    nrn_assert(n > 1);
+    buf[0] = '\0';
+    int c = std::fgetc(fp);
+    while (c != EOF && std::isspace(static_cast<unsigned char>(c))) {
+        c = std::fgetc(fp);
+    }
+    size_t i = 0;
+    while (c != EOF && !std::isspace(static_cast<unsigned char>(c))) {
+        if (i + 1 >= n) {
+            buf[i] = '\0';
+            nrn_assert(i + 1 < n);
+        }
+        buf[i++] = static_cast<char>(c);
+        c = std::fgetc(fp);
+    }
+    buf[i] = '\0';
+    nrn_assert(i > 0);
+    while (c != EOF && std::isspace(static_cast<unsigned char>(c))) {
+        c = std::fgetc(fp);
+    }
+    if (c != EOF) {
+        std::ungetc(c, fp);
+    }
+}
 }  // namespace coreneuron
