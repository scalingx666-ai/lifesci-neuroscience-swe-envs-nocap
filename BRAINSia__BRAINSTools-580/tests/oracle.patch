diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index f3138ca6c..43b809cc3 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -336,25 +336,31 @@ jobs:
         run: ctest -D ExperimentalConfigure
 
       - name: "Inner Build: Compile BRAINSTools (CTest dashboard build)"
+        id: inner_build
         working-directory: build/BRAINSTools-Release-EPRelease-build
         shell: bash
         run: ctest -D ExperimentalBuild -j ${{ matrix.config.parallel }}
 
       - name: "Inner Build: Run tests and collect results"
+        # Disallow build: do not run tests when the build step failed.
+        # ctest -D ExperimentalBuild exits non-zero when compilation errors
+        # occur; skipping the test step avoids misleading CDash "0 tests passed"
+        # submissions that obscure the real problem.
+        if: steps.inner_build.outcome == 'success'
         working-directory: build/BRAINSTools-Release-EPRelease-build
         shell: bash
         # continue-on-error: test failures must not block ExperimentalSubmit —
         # CDash is most useful when it receives failure data.
         continue-on-error: true
         run: |
-          # Exclude BCD (BRAINSConstellationDetector) tests: all exceed 5 minutes
-          # on GitHub-hosted runners and collectively consumed 4–75 minutes each
-          # in the 2026-04-05 Ubuntu run (job 69973921651).  Worst offender:
-          #   BCDTestForLandmarkCompare  4531 s  (75 min)
-          #   BCDTest_ForceACPoint       3000 s  (50 min, timed out)
-          #   BCDTest_rVN4-rpc-rac-rmpj  1303 s  (21 min)
-          # These tests are valuable locally but are too slow for CI runners
-          # that share limited compute time across all branches.
+          # Exclude BCD (BRAINSConstellationDetector) tests via -E as a
+          # belt-and-suspenders guard alongside CTEST_CUSTOM_TESTS_IGNORE in
+          # CMake/CTestCustom.cmake.in.  CTEST_CUSTOM_TESTS_IGNORE is honoured
+          # by ctest_test() / ctest -D Experimental*; the -E flag ensures
+          # exclusion even before CTestCustom.cmake has been generated (e.g.
+          # on a fresh CMake configure that writes CTestCustom.cmake only after
+          # the first ctest_configure()).  All BCD tests exceeded 5 minutes on
+          # GitHub-hosted runners (worst: BCDTestForLandmarkCompare = 75 min).
           ctest -D ExperimentalTest --schedule-random --output-on-failure \
             -j ${{ matrix.config.parallel }} \
             -E '^BCD'
diff --git a/CMake/CTestCustom.cmake.in b/CMake/CTestCustom.cmake.in
index 0beae623b..d60b15140 100644
--- a/CMake/CTestCustom.cmake.in
+++ b/CMake/CTestCustom.cmake.in
@@ -71,6 +71,48 @@ set(CTEST_CUSTOM_MEMCHECK_IGNORE
 set(CTEST_CUSTOM_MAXIMUM_NUMBER_OF_ERRORS   1000)
 set(CTEST_CUSTOM_MAXIMUM_NUMBER_OF_WARNINGS 1000)
 
+# ---------------------------------------------------------------------------
+# BCD (BRAINSConstellationDetector) tests are excluded from CTest runs that
+# go through CTestCustom because they exceed 5 minutes on any CI runner.
+# Timings measured on GitHub-hosted Ubuntu runner (2026-04-05):
+#
+#   BCDTestForLandmarkCompare       4531 s  (75 min)  — passed
+#   BCDTest_ForceACPoint            3000 s  (50 min)  — failed (timeout)
+#   BCDTest_rVN4-rpc-rac-rmpj       1303 s  (21 min)  — passed
+#   BCDTest_{rVN4,ForceVN4Point,…}  1500 s  (25 min)  — failed (timeout ×20)
+#
+# CTEST_CUSTOM_TESTS_IGNORE is honoured by `ctest -D Experimental*` and any
+# CTest script that calls ctest_test().  It does NOT affect `ctest -R` or
+# `ctest -E` filters added manually on the command line.  Run BCD tests
+# locally with `ctest -R '^BCD'` in the BRAINSTools inner-build directory.
+# ---------------------------------------------------------------------------
+set(CTEST_CUSTOM_TESTS_IGNORE
+  ${CTEST_CUSTOM_TESTS_IGNORE}
+  BCDTestForLandmarkCompare
+  BCDTest_ForceACPoint
+  BCDTest_rescaleIntensityRange
+  BCDTest_rescaleIntensity
+  BCDTest_rVN4
+  BCDTest_ForceVN4Point
+  BCDTest_ForceRPPoint
+  BCDTest_outputUntransformedClippedVolume
+  BCDTest_cutOutHeadInOutputResampledVolume
+  BCDTest_ForcePCPoint
+  BCDTest_rmpj
+  BCDTest_interpolationMode
+  BCDTest_backgroundValue
+  BCDTest_T1_outputResampledVolume
+  BCDTest_trimRescaledIntensities
+  BCDTest_rpc
+  BCDTest_rac
+  BCDTest_otsuThreshold
+  BCDTest_mspLevel
+  BCDTest_cutOutHeadInOutputVolume
+  BCDTest_acLowerBound
+  BCDTest_T1_outputVolume
+  BCDTest_rVN4-rpc-rac-rmpj
+  )
+
 set(CTEST_CUSTOM_WARNING_EXCEPTION
   ${CTEST_CUSTOM_WARNING_EXCEPTION}
   # Ignore zlib fallthrough warnings
