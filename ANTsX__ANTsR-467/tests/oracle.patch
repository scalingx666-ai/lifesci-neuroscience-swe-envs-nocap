+      stop(
+        "image ", f, " has dimensions ", paste(hdr$dimensions, collapse = "x"),
+        " but the mask has ", paste(dim(mask), collapse = "x")
+      )
+    }
+  }
   return(ANTsRCore::imagesToMatrixR(imageList, mask, n))
 }
