+        matrix = np.corrcoef(rng.normal(size=(6, 20)))
+        adj = Adjacency(matrix, matrix_type="similarity")
+        off_diagonal = matrix[~np.eye(6, dtype=bool)]
+        expected = max(abs(off_diagonal.min()), abs(off_diagonal.max()))
