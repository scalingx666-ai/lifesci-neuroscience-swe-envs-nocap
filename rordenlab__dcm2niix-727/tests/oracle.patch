+    FILE *fp_dcmLst = fopen(dicomflst, "w");
+    for (int nDcm = 0; nDcm < (*mrifsStruct_vector)[n].nDcm; nDcm++)
+      fprintf(fp_dcmLst, "%s\n", (*mrifsStruct_vector)[n].dicomlst[nDcm]);
