diff --git a/share/lib/python/neuron/crxd/__init__.py b/share/lib/python/neuron/crxd/__init__.py
index 4a8c4e3168..11afc47c6f 100644
--- a/share/lib/python/neuron/crxd/__init__.py
+++ b/share/lib/python/neuron/crxd/__init__.py
@@ -1,4 +1,10 @@
 import sys
 import neuron.rxd
 
+# neuron.crxd is another name for neuron.rxd. Alias the submodules too: otherwise
+# "from neuron.crxd.rxdmath import ..." loads a second copy, with its own classes.
+for _name, _module in list(sys.modules.items()):
+    if _name.startswith("neuron.rxd."):
+        sys.modules["neuron.crxd" + _name[len("neuron.rxd") :]] = _module
+
 sys.modules[__name__] = sys.modules["neuron.rxd"]
diff --git a/test/rxd/test_arithmeticed.py b/test/rxd/test_arithmeticed.py
index cdf795f092..6163a3711e 100644
--- a/test/rxd/test_arithmeticed.py
+++ b/test/rxd/test_arithmeticed.py
@@ -29,3 +29,13 @@ def test_valid_arith_objects(neuron_nosave_instance):
     assert isinstance(
         rxd.rxdmath._ensure_arithmeticed((ca * (1 - ca))), rxd.rxdmath._Arithmeticed
     )
+
+
+def test_crxd_rxdmath_is_rxdmath(neuron_nosave_instance):
+    """neuron.crxd.rxdmath is neuron.rxd.rxdmath, not a second copy"""
+
+    _, rxd, _ = neuron_nosave_instance
+    from neuron.crxd.rxdmath import _Arithmeticed, vtrap
+
+    assert _Arithmeticed is rxd.rxdmath._Arithmeticed
+    assert isinstance(vtrap(-(rxd.v + 40.0), 10), rxd.rxdmath._Arithmeticed)
