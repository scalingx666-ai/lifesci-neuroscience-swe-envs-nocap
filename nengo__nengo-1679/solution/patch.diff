         return lambda t, x: [t * np.sum(x)] * size_out
 
 
+class QueueProcess(Process):
+    def __init__(self):
+        super().__init__()
+        self.queue = []
+
+    def make_step(self, shape_in, shape_out, dt, rng, state):
+        def step(t, x, queue=self.queue):  # pylint: disable=dangerous-default-value
+            queue.append(x)
+
+        return step
+
+
