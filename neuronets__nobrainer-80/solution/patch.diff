+    def __init__(self):
+        self._n_samples = 0
+        self._current_mean = 0.0
+        self._M = 0.0
+
+    def update(self, value):
+        """Update the statistics with the next value.
+
+        Parameters
+        ----------
+        value: scalar, array-like
+
+        Returns
+        -------
+        Modified instance.
