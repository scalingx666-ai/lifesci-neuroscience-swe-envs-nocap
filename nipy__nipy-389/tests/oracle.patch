 from ..utils import (events, lambdify_t, T, convolve_functions,
                      blocks)
 from ..hrf import glover
@@ -158,3 +158,59 @@ def mk_blk_tc(ev_inds):
     spec_1d = make_recarray(zip(onsets, offsets, fac_1),
