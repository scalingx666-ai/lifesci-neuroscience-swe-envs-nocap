+function DisplayUnits = getDisplayUnits(channel_type)
+    if strcmp(channel_type,'dOD')
+        DisplayUnits = 'delta OD';
+    elseif strcmp(channel_type,'dHb')
+        DisplayUnits = 'mol.l-1';
+    else
+        DisplayUnits = '';
+    end
+end
