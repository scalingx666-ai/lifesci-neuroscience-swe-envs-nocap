+        ret
+    catch err
+        if isa(err, EOFError)
+            @debug "reading the file resulted in an EOF error and \nthe end of the file was read.\nNo more data was available to read from the filestream.\nIt is likely that the file was corrupted or is empty (0 bytes)."
+            rethrow(err)
+        end
+    end 
 end
 
