+% aas_shell that explicitly includes "<fsldir>/bin" :
+
+if (aas_ismac)
+    ENV = vertcat(ENV,{...
+        'PATH', [aap.directory_conventions.fsldir '/bin:$PATH']; ...
+        'FSLDIR', aap.directory_conventions.fsldir; ...
