diff --git a/.github/workflows/docker-build-latest.yml b/.github/workflows/docker-build-latest.yml
index d7c468e1..3b0b736f 100644
--- a/.github/workflows/docker-build-latest.yml
+++ b/.github/workflows/docker-build-latest.yml
@@ -15,7 +15,7 @@ jobs:
         uses: docker/setup-qemu-action@v4
 
       - name: Install GitVersion
-        uses: gittools/actions/gitversion/setup@v4.6.0
+        uses: gittools/actions/gitversion/setup@v4.7.0
         with:
           versionSpec: '6.x'
 
@@ -27,7 +27,7 @@ jobs:
 
       - name: Determine Version
         id:   gitversion # id to later be referenced
-        uses: gittools/actions/gitversion/execute@v4.6.0
+        uses: gittools/actions/gitversion/execute@v4.7.0
         with:
           additionalArguments: /config commit-date-format="yyyy-MM-ddTHH:mm:ss-0000"
 
