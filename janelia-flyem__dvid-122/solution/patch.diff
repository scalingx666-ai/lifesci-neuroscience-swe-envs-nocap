+		}
+
+		if val == nil {
+			return fmt.Errorf("Could not retrieve value")
+		}
+
+		if op != nil && op.Wg != nil {
+			op.Wg.Add(1)
+		}
+
+		tkv := storage.TKeyValue{tk, val}
+		chunk := &storage.Chunk{op, &tkv}
+		if err := f(chunk); err != nil {
+			return err
+		}
+	}
+
+	return err
 }
 
