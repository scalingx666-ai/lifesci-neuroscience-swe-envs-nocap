diff --git a/Utilities/itkN3SharpenFFT.h b/Utilities/itkN3SharpenFFT.h
new file mode 100644
index 000000000..8237fd132
--- /dev/null
+++ b/Utilities/itkN3SharpenFFT.h
@@ -0,0 +1,64 @@
+/*=========================================================================
