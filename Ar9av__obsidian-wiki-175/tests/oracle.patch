+class TestGraphDiff:
+    def test_added_removed(self):
+        old = {"nodes": ["a", "b", "c"], "edges": [["a", "b"]]}
+        new = {"nodes": ["a", "b", "d"], "edges": [["a", "b"], ["a", "d"], ["d", "b"]]}
