+# Generalised winding-number inside test from natcpp (>= 0.3.2) with a bounding
+# box prefilter. Returns NULL when natcpp is unavailable or disabled via
+# options(nat.use_natcpp=FALSE) so that callers can fall back to Rvcg.
+inside_winding <- function(xyz, surf) {
+  if(is.null(surf$it) || !use_natcpp(version='0.3.2'))
+    return(NULL)
+  inbb=contains_points(boundingbox(surf), xyz)
+  res=inbb
+  if(any(inbb))
+    res[inbb]=natcpp::c_pointsinside(xyz[inbb,,drop=FALSE], xyzmatrix(surf),
+                                     t(surf$it))
+  res
+}
+
 contains_points <- function(obj, points, ...) UseMethod("contains_points")
 
