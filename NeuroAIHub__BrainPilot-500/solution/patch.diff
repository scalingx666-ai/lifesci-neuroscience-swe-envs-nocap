+/* #487 demo-mobile-start
+   The collapsed 64px navigation rail leaves 326px for Live Demo at a 390px
+   viewport. Remove the desktop card minimum/padding at that size so the
+   landing content remains inside its grid column instead of overflowing under
+   the rail. */
+@media (max-width: 600px) {
+  .demo-view {
+    width: 100%;
+    max-width: 100%;
+    min-height: 0;
+  }
+
+  .demo-landing {
+    align-items: stretch;
+    justify-content: flex-start;
+    gap: 18px;
+    width: 100%;
+    max-width: 100%;
+    overflow-x: hidden;
+    padding: 24px 16px 32px;
+  }
+
+  .demo-landing__header {
+    width: 100%;
+    max-width: none;
+  }
+
+  .demo-landing__header h1 {
+    font-size: 20px;
+    line-height: 1.3;
+    overflow-wrap: anywhere;
+  }
+
+  .demo-landing__header p {
+    overflow-wrap: anywhere;
+  }
+
+  .demo-landing__cards {
+    width: 100%;
+    min-width: 0;
+    grid-template-columns: minmax(0, 1fr);
+    gap: 12px;
+  }
+
+  .demo-card {
+    min-width: 0;
+    padding: 16px;
+  }
+
+  .demo-card__head,
+  .demo-card__head h2,
+  .demo-card > p,
+  .demo-card__sessions,
+  .demo-session-row,
+  .demo-session-row span,
+  .demo-dropzone {
+    min-width: 0;
+    max-width: 100%;
+  }
+
+  .demo-card__head h2,
+  .demo-card > p,
+  .demo-dropzone__primary,
+  .demo-dropzone__hint {
+    overflow-wrap: anywhere;
+  }
+
+  .demo-session-row {
+    padding-inline: 10px;
+  }
+
+  .demo-dropzone {
+    padding: 22px 12px;
+  }
+
+  .demo-header {
+    align-items: stretch;
+    flex-direction: column;
+    gap: 10px;
+    padding: 12px 14px;
+  }
+
+  .demo-header__title {
+    min-width: 0;
+  }
+
+  .demo-header__title h1,
+  .demo-header__meta {
+    overflow-wrap: anywhere;
+  }
+
+  .demo-header__actions {
+    width: 100%;
+    flex-wrap: wrap;
+  }
+
+  .demo-export,
+  .demo-reselect {
+    min-height: 40px;
+  }
+}
