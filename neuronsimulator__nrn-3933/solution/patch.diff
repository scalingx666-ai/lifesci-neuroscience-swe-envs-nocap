diff --git a/test/hoctests/befstep.mod b/test/hoctests/befstep.mod
new file mode 100644
index 0000000000..0ac764fd4a
--- /dev/null
+++ b/test/hoctests/befstep.mod
@@ -0,0 +1,44 @@
+: Density BEFORE/AFTER counters.
+: RANGE values start at 0. Do not assign them in INITIAL: BEFORE INITIAL
+: runs first and that assignment would wipe the count.
+
+NEURON {
+    SUFFIX befstep
+    RANGE nbi, nai, nbb, nas, nstep, vsave, tsave
+}
+
+ASSIGNED {
+    : nocmodl requires this declaration. v is the node voltage, not a RANGE slot.
+    v (millivolt)
+    nbi
+    nai
+    nbb
+    nas
+    nstep
+    vsave
+    tsave
+}
+
+BEFORE INITIAL {
+    nbi = nbi + 1
+}
+
+AFTER INITIAL {
+    nai = nai + 1
+}
+
+BEFORE BREAKPOINT {
+    nbb = nbb + 1
+}
+
+AFTER SOLVE {
+    nas = nas + 1
+}
+
+BEFORE STEP {
+    : Direct assignment. A PROCEDURE that contains VERBATIM is not thread
+    : safe under nocmodl, so the call would miss this callback's cache.
+    nstep = nstep + 1
+    vsave = v
+    tsave = t
+}
diff --git a/test/hoctests/befstep_pp.mod b/test/hoctests/befstep_pp.mod
new file mode 100644
index 0000000000..6b52c6071b
--- /dev/null
+++ b/test/hoctests/befstep_pp.mod
@@ -0,0 +1,35 @@
+: POINT_PROCESS BEFORE STEP with a POINTER and a VERBATIM _p_ name.
+: p is a double written with setpointer. raw is not: _p_raw is a void* lvalue,
+: and literal_value<void*>() rejects a slot that setpointer stored as double*.
+
+NEURON {
+    POINT_PROCESS BefstepPP
+    POINTER p, raw
+    RANGE n, nverb
+}
+
+ASSIGNED {
+    p
+    raw
+    n
+    nverb
+}
+
+INITIAL {
+    n = 0
+    nverb = 0
+}
+
+BEFORE STEP {
+    n = n + 1
+    p = p + 1
+VERBATIM
+    {
+        void** slot = (void**)(&(_p_raw));
+        if (*slot == (void*)0) {
+            *slot = (void*)1;
+        }
+        nverb = nverb + 1.0;
+    }
+ENDVERBATIM
+}
diff --git a/test/hoctests/tests/test_beforestep.py b/test/hoctests/tests/test_beforestep.py
new file mode 100644
index 0000000000..a0b39d18e4
--- /dev/null
+++ b/test/hoctests/tests/test_beforestep.py
@@ -0,0 +1,48 @@
+# BEFORE/AFTER must run, including a POINT_PROCESS POINTER.
+# Counts are for one segment after h.finitialize(-65) and one h.fadvance().
+# finitialize: BEFORE INITIAL, AFTER INITIAL, one BEFORE BREAKPOINT, one BEFORE STEP.
+# fadvance adds one BEFORE BREAKPOINT, one AFTER SOLVE, and one BEFORE STEP.
+# The point process INITIAL block zeros n, and BEFORE STEP runs after that.
+
+from neuron import h
+
+
+def test_beforestep():
+    s = h.Section("soma")
+    s.nseg = 1
+    s.insert("befstep")
+    mech = s(0.5).befstep
+
+    pp = h.BefstepPP(s(0.5))
+    watched = h.Vector(1)
+    h.setpointer(watched._ref_x[0], "p", pp)
+
+    h.finitialize(-65)
+
+    assert mech.nbi == 1, mech.nbi
+    assert mech.nai == 1, mech.nai
+    assert mech.nbb == 1, mech.nbb
+    assert mech.nas == 0, mech.nas
+    assert mech.nstep == 1, mech.nstep
+    assert mech.vsave == -65, mech.vsave
+    assert mech.tsave == h.t, (mech.tsave, h.t)
+    assert pp.n == 1, pp.n
+    assert pp.nverb == 1, pp.nverb
+    assert watched.x[0] == 1, watched.x[0]
+
+    h.fadvance()
+
+    assert mech.nbi == 1, mech.nbi
+    assert mech.nai == 1, mech.nai
+    assert mech.nbb == 2, mech.nbb
+    assert mech.nas == 1, mech.nas
+    assert mech.nstep == 2, mech.nstep
+    assert mech.vsave == -65, mech.vsave
+    assert mech.tsave == h.t, (mech.tsave, h.t)
+    assert pp.n == 2, pp.n
+    assert pp.nverb == 2, pp.nverb
+    assert watched.x[0] == 2, watched.x[0]
