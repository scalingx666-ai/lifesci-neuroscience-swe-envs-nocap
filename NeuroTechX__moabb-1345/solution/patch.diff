index 0000000000..61efc0acd7
--- /dev/null
+++ b/moabb/tests/test_lazy_imports.py
@@ -0,0 +1,112 @@
+"""Tests for lazy imports across MOABB packages (Issue #1153)."""
+
+import subprocess
+import sys
+
+import pytest
+
+import moabb
+
+
+def _run_python(code: str) -> str:
+    res = subprocess.run(
+        [sys.executable, "-c", code],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    return res.stdout.strip()
+
+
+def test_import_moabb_is_lazy():
+    """Importing top-level moabb should not pull heavy subpackages or third-party libs."""
+    out = _run_python(
+        """
+import sys
+import moabb
+
+eager = [
+    m for m in (
+        "moabb.datasets",
+        "moabb.paradigms",
+        "moabb.evaluations",
+        "moabb.pipelines",
+        "moabb.analysis",
+        "moabb.utils",
+        "sklearn",
+        "pyriemann",
+        "matplotlib",
+    )
+    if m in sys.modules
+]
+print(",".join(eager))
+"""
+    )
+    assert out == ""
+
+
+def test_import_single_dataset_is_lazy():
+    """Importing one dataset must not import all other dataset modules."""
+    out = _run_python(
+        """
+import sys
+from moabb.datasets import BNCI2014_001
+
+eager = [
+    m for m in (
+        "moabb.datasets.physionet_mi",
+        "moabb.datasets.gigadb",
+        "moabb.datasets.schirrmeister2017",
+        "moabb.datasets.compound_dataset",
+        "moabb.paradigms",
+        "moabb.evaluations",
+        "matplotlib",
+    )
+    if m in sys.modules
+]
+print(",".join(eager))
+"""
+    )
+    assert out == ""
+
+
+def test_import_single_paradigm_is_lazy():
+    """Importing LeftRightImagery must not import unrelated paradigms or initialize dataset_list."""
+    out = _run_python(
+        """
+import sys
+from moabb.paradigms import LeftRightImagery
+
+eager = [
+    m for m in (
+        "moabb.paradigms.p300",
+        "moabb.paradigms.ssvep",
+        "moabb.paradigms.cvep",
+        "moabb.datasets.physionet_mi",
+        "moabb.datasets.gigadb",
+    )
+    if m in sys.modules
+]
+print(",".join(eager))
+"""
+    )
+    assert out == ""
+
+
+def test_lazy_attributes_and_dir():
