+function get_image_stem() {
+  local filename=${1##*/}
+
+  # Treat .gz as a compression suffix, then remove the image-format suffix.
+  # This preserves internal periods for both compressed and uncompressed formats.
+  if [[ $filename == *.gz ]]; then
+    filename=${filename%.gz}
+  fi
+  printf '%s\n' "${filename%.*}"
