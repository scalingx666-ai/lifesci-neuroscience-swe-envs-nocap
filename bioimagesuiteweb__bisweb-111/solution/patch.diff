+class bidsDemogr(bidsText):
+
+    def __init__(self):
+        super().__init__()
+        self.taskIntpn = []
+        self.keys = []
+        self.data = {}
+        self.fname = ''
+
+
+    def getKeys(self):
+        return self.keys
+
+
