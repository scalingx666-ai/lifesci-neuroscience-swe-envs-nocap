diff --git a/.coveragerc b/.coveragerc
new file mode 100644
index 0000000000..9221026069
--- /dev/null
+++ b/.coveragerc
@@ -0,0 +1,17 @@
+[report]
+omit =
+    */tests/*
+    */_numba/*
+    */_opencl/*
+    */plot/*
+    */web/static/*
+    */web/templates/*
+    *.tvb-temp*
+    */tvb_bin/*
+    */tvb_data/*
+    **/__init__.py
+
+# Regex expressions for lines excluded from report
+exclude_lines =
+    pragma: no cover
+    if __name__ == .__main__.:y
\ No newline at end of file
