+/* -----------------------------------------------------------------------
+ * Inventory card — on-disk pipeline health. Structurally similar to
+ * .kb-env (chip head, headline, metrics) but with a heavier accent so
+ * users can distinguish "your KB" from "your Python env" at a glance.
+ * ----------------------------------------------------------------------- */
+.kb-inv {
+  display: grid;
+  gap: 12px;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-md);
+  background: var(--color-surface-soft);
+  padding: 12px;
+  margin-bottom: 14px;
+}
+
+.kb-inv--healthy {
+  border-color: var(--color-success-soft, var(--color-border));
+}
+
+.kb-inv--pending {
+  border-color: var(--color-warning-soft, var(--color-border));
+}
+
+.kb-inv__head {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  flex-wrap: wrap;
+}
+
+.kb-inv__head-right {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+
+.kb-inv__sampled-at {
+  color: var(--color-text-muted);
+  font-size: 11px;
+}
+
+.kb-inv__headline {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  border: 1px solid transparent;
+  border-radius: var(--radius-sm);
+  padding: 8px 10px;
+  color: var(--color-text);
+  font-size: 13px;
+}
+
+.kb-inv__headline--ok {
+  border-color: var(--color-success-soft, var(--color-border));
+  background: color-mix(in srgb, var(--color-success, #12b981) 8%, transparent);
+}
+
+.kb-inv__headline--ok svg {
+  color: var(--color-success, #12b981);
+}
+
+.kb-inv__headline--pending {
+  border-color: var(--color-warning-soft, var(--color-border));
+  background: color-mix(in srgb, var(--color-warning, #d97706) 8%, transparent);
+}
+
+.kb-inv__headline--pending svg {
+  color: var(--color-warning, #d97706);
+}
+
+/* Four-cell stage strip — a compact per-stage rollup. Each cell is its
+ * own mini-progress row: label + tiny bar + optional gap-count. */
+.kb-inv__stages {
+  display: grid;
+  grid-template-columns: repeat(4, minmax(0, 1fr));
+  gap: 8px;
+}
+
+.kb-inv__stage {
+  display: grid;
+  gap: 4px;
+  border: 1px solid var(--color-border);
+  border-radius: var(--radius-sm);
+  padding: 8px 9px;
+  background: var(--color-surface);
+}
+
+.kb-inv__stage--ok {
