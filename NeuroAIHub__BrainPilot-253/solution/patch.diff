+        or (file_ocr.get("API_KEY") or "").strip()
+        or (file_sf.get("API_KEY") or "").strip()
+    )
+    return OcrConfig(preset=preset, base_url=base_url, model=model,
+                     prompt=prompt, api_key=api_key)
 
 
