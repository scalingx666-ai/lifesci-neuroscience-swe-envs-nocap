+}
+
+.kb-inv__stage--pending {
+  border-color: color-mix(in srgb, var(--color-warning, #d97706) 40%, var(--color-border));
+}
+
+.kb-inv__stage-head {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+}
+
+.kb-inv__stage-icon {
+  display: inline-flex;
+  align-items: center;
+}
+
+.kb-inv__stage--ok .kb-inv__stage-icon {
+  color: var(--color-success, #12b981);
+}
+
+.kb-inv__stage--pending .kb-inv__stage-icon {
+  color: var(--color-warning, #d97706);
+}
+
+.kb-inv__stage-label {
+  color: var(--color-text);
+  font-size: 12.5px;
+  font-weight: 600;
+}
+
+.kb-inv__stage-bar {
+  height: 4px;
+  overflow: hidden;
+  border-radius: 999px;
+  background: var(--color-surface-soft);
+}
+
+.kb-inv__stage-fill {
+  display: block;
+  height: 100%;
+  border-radius: 999px;
+  transition: width var(--ease-standard);
+}
+
+.kb-inv__stage-fill--ok {
+  background: var(--color-success, #12b981);
+}
+
+.kb-inv__stage-fill--pending {
+  background: var(--color-warning, #d97706);
+}
+
+.kb-inv__stage-count {
+  color: var(--color-text-muted);
+  font-size: 11px;
+  font-variant-numeric: tabular-nums;
+}
+
+/* Metrics grid — dense two-column list of aggregate stats. */
+.kb-inv__metrics {
+  display: grid;
+  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
+  gap: 6px 14px;
+  margin: 0;
+}
+
+.kb-inv__metrics > div {
+  display: grid;
+  grid-template-columns: minmax(0, 1fr) auto;
+  gap: 8px;
+  min-width: 0;
+  padding: 2px 0;
+  border-bottom: 1px dashed var(--color-border);
+}
+
+.kb-inv__metrics dt {
