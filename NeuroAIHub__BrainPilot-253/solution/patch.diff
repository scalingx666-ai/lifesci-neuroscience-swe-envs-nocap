+  border-radius: 3px;
+}
+
+.kb-inv__issue {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  color: var(--color-text);
+  font-size: 12.5px;
+  line-height: 1.45;
+}
+
+.kb-inv__issue svg {
+  color: var(--color-warning, #d97706);
+  flex-shrink: 0;
+}
+
+.kb-inv__issue-stage {
+  color: var(--color-text);
+  font-weight: 600;
+  min-width: 60px;
+}
+
+.kb-inv__hint {
+  margin: 0;
+  color: var(--color-text-muted);
+  font-size: 12px;
+}
