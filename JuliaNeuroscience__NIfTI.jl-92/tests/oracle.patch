+            bytes = read!(io, Array{UInt8}(undef, $sz))
+            hdr = GC.@preserve bytes $(Expr(:new, ty, [:(unsafe_load(convert(Ptr{$(ty.types[i])}, pointer(bytes) + $(packed_offsets[i])))) for i in fields]...))
+            if hdr.sizeof_hdr == ntoh(Int32($sz))
