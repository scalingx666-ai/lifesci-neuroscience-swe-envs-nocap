+            bytes = Vector{UInt8}(undef, $sz)
+            GC.@preserve bytes begin
+                $([:(unsafe_store!(convert(Ptr{$(ty.types[i])}, pointer(bytes) + $(packed_offsets[i])), getfield(x, $i))) for i in fields]...)
