+def _threshold(
+    data: np.ndarray, threshold: Union[int, float], indices: bool = False
+) -> np.ndarray:
+  """Thresholds image."""
+  idxs = np.where(data > threshold)
+  if indices:
+    return idxs
+  else:
+    mask = np.zeros_like(data)
+    mask[idxs] = True
+    return mask
+
