+   "source": [
+    "# Two independent simulator instances with the same fixed initial conditions\n",
+    "# must produce bit-for-bit identical output (deterministic integration).\n",
+    "def _build_sim():\n",
+    "    \"\"\"Create a fresh coupled simulator from scratch.\"\"\"\n",
+    "    jr  = JansenRit()\n",
