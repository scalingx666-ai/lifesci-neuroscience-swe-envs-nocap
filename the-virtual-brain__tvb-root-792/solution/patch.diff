+     ]
+    }
+   ],
+   "source": [
+    "dt              = 0.1    # ms — integration time step\n",
+    "nnodes          = 38     # nodes per subnetwork\n",
+    "simulation_length = 1000.0  # ms\n",
+    "\n",
+    "print(f\"dt={dt} ms | nnodes={nnodes} per subnetwork | length={simulation_length} ms\")"
