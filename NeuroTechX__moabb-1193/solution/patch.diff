+def _named_raw(ch_names, descriptions):
+    raw = mne.io.RawArray(
+        np.zeros((len(ch_names), 100)), mne.create_info(ch_names, 100.0, "eeg")
+    )
+    raw.set_annotations(mne.Annotations([0.1, 0.2, 0.3], 0, descriptions))
+    return raw
+
