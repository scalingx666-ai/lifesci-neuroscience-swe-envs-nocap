+SUBJECTS = list(_FILE_IDS)
+
+# Per-trial class code in the CSV "class" column -> MOABB event code.
+_CLASS_TO_EVENT = {-1: 1, 1: 2}
+
+# Sampling rate (Hz); each trial spans t = -3 s .. +5 s around the cue.
+_SFREQ = 250.0
