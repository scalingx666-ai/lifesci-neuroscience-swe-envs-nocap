+
+    @property
+    def model_device(self) -> torch.device:
+        parameter = next(self.model.parameters(), None)
+        if parameter is not None:
+            return parameter.device
+        buffer = next(self.model.buffers(), None)
+        if buffer is not None:
+            return buffer.device
