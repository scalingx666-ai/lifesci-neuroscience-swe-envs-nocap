+        )
+
+        # fmt:off
+        workflow.connect([
+            (inputnode, ds_surf, [(metric, 'in_file'), ('source_files', 'source_file')]),
+            (ds_surf, outputnode, [('out_file', metric)]),
+        ])
+        # fmt:on
+
+    return workflow
