+        on_failure='ignore',
+        result_renderer='disabled')
+    # Should get an error about the branch switch
+    assert_in_results(res, status='error', action='run')
+    error_results = [r for r in res
+                     if r.get('action') == 'run'
+                     and r.get('status') == 'error']
