-          HBP_AUTH_TOKEN: ${{ secrets.HBP_AUTH_TOKEN }}   # needed for siibra tests
+          HBP_AUTH_TOKEN: ${{ secrets.HBP_AUTH_TOKEN }}   # token or (secret+id) are needed for siibra tests
