+# Read the Docs configuration. Required by readthedocs.com — without it the
+# build fails at the config stage before mkdocs runs.
+version: 2
+
+build:
+  os: ubuntu-24.04
+  tools:
+    python: "3.11"
+  jobs:
+    install:
+      - pip install mkdocs-material
+
+mkdocs:
+  configuration: mkdocs.yml
