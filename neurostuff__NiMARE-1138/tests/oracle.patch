+def test_one_way_is_unchanged_away_from_the_boundary():
+    """The ordinary path must not move."""
+    counts, n = np.array([20, 0, 8]), 30
+    expected = counts.mean()
+    reference = (counts - expected) ** 2 * n / (expected * (n - expected))
