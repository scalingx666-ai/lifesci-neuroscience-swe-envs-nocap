-        params = (j, j_td, tau_m, leak_gamma)
-        _, _z = step_rk2(0., z, _dfz, dt, params)
-    elif integType == 2:
-        params = (j, j_td, tau_m, leak_gamma)
-        _, _z = step_rk4(0., z, _dfz, dt, params)
-    else:
