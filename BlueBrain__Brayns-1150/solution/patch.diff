diff --git a/python/testapi/render.py b/python/testapi/render.py
index 9a026bcef..2675f7ea6 100644
--- a/python/testapi/render.py
+++ b/python/testapi/render.py
@@ -156,7 +156,10 @@ def _validate_data(
     test: bytes, ref: bytes, threshold: float = DEFAULT_THRESHOLD
 ) -> None:
     l1, l2 = len(test), len(ref)
-    se = sum((i - j) ** 2 for i, j in zip(test, ref))
+    common = min(l1, l2)
+    extra = abs(l1 - l2)
