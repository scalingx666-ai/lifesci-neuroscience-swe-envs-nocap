+class FaultTest(unittest.TestCase):
+    """/proc changes under the reaper and its own steps fail; it carries on, and the receipt says what happened."""
+
+    LEG = P(4242, 1, marked=True, gpu=True, name="python3 leg.py")
+
+    def setUp(self):
