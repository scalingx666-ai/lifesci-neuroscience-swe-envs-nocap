+class BroadcastingModel(nn.Module):
+    """Mismatched-shape broadcasting: (3,4,5)+(1,4,1)*(5,)."""
+
+    def __init__(self):
+        super().__init__()
+
+    @staticmethod
+    def forward(x):
+        # x: (3, 4, 5)
+        b = torch.ones(1, 4, 1)
+        c = torch.ones(5)
+        return (x + b) * c
