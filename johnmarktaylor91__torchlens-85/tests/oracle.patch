+        # x: (3, 5)
+        idx = torch.tensor([[0, 1, 2, 3, 4], [4, 3, 2, 1, 0], [2, 2, 2, 2, 2]])
+        gathered = torch.gather(x, 1, idx)
+        out = torch.zeros_like(x)
+        out = out.scatter(1, idx, gathered)
