-def _inclusive_frequency_mask(
-    label: str,
-    bounds: Any,
-    frequencies: NDArray[np.floating],
-) -> tuple[NDArray[np.bool_], tuple[float, float]]:
-    """Validate ``(low, high)`` bounds and return the inclusive bin mask.
