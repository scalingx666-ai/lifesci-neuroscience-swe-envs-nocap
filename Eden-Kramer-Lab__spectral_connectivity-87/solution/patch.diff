-    source_extras = {
-        f"source_{name}": ("source", values)
-        for name, values in extra_signal_coordinates.items()
-    }
-    target_extras = {
-        f"target_{name}": ("target", values)
-        for name, values in extra_signal_coordinates.items()
-    }
-    signal_coordinates.update(source_extras)
-    signal_coordinates.update(target_extras)
-    measure_attrs = {
