diff --git a/src/Makefile.var b/src/Makefile.var
index 5f5d21ca8..93d1b038a 100644
--- a/src/Makefile.var
+++ b/src/Makefile.var
@@ -22,6 +22,7 @@ MEXOPTS      = -O -largeArrayDims
 MEXEND       =
 MOSUF        = o # mex output object suffix
 UNAME        = uname
+GET_ARCH     = uname -m
 AR           = ar rcs
 COPY         = cp -f
 DEL          = rm -f
@@ -37,6 +38,11 @@ SONAME       = soname
 
 ifndef PLATFORM
   PLATFORM   = $(shell $(UNAME))
+  ifeq (Darwin,$(PLATFORM))
