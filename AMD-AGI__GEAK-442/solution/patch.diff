+    assert rx._recipe_env_block(str(tmp_path / "missing.yaml")) == {}
+    corrupt = tmp_path / "corrupt.yaml"
+    corrupt.write_bytes(b"envs:\n  BAD: \xff\n")
+    assert rx._recipe_env_block(str(corrupt)) == {}
