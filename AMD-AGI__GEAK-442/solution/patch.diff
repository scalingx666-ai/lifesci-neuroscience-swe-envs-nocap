+def _legacy_positive_number(doc: dict, *keys: str) -> float:
+    """First positive finite number in a legacy, schema-drifting artifact."""
+    for key in keys:
+        value = _positive_finite_float(doc.get(key))
+        if value > 0.0:
+            return value
+    return 0.0
