+def _swm_meta(**kw):
+    swm = {"isl": 16384, "osl": 1024, "conc": 64, "prefill_chunk": 8192,
+           "analytic_calls": {"prefill": 64, "decode": 1024}}
+    swm.update(kw.pop("swm", {}))
