-                found = true;
-            }
-        }
-        else
-        {
-            if (strncmp (peripheral_identified, "BrainAlive", 10) == 0)
-            {
-                found = true;
-            }
-        }
-    }
-
-    safe_logger (spdlog::level::trace, "address {}", peripheral_address);
