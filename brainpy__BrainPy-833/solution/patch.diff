-        x = as_jax(x)
-        z = jnp.where(x < -1 / self.alpha,
-                      0.,
-                      jnp.where(x > 1 / self.alpha,
-                                1.,
-                                (-self.alpha * jnp.abs(x) / 2 + 1) * self.alpha * x + 0.5))
-        return z
