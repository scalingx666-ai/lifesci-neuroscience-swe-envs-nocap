+    color="red",
+)
+ax.view_init(10, 135, 2)
+ax.set_title(
+    "Probability map of target voxels\n"
+    f"being matched with source point {vertex_index}"
+)
+ax.set_axis_off()
+fig.colorbar(plt.cm.ScalarMappable(cmap="twilight"), ax=ax)
+plt.show()
+
+# %%
