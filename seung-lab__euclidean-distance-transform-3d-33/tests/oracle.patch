-
-      - name: Install Numpy
-        run: python -m pip install numpy setuptools wheel
-
-      - name: Compile Wheel
-        run: cd python && python setup.py bdist_wheel
-
-      - uses: actions/upload-artifact@v2
-        with:
-          path: ./python/dist/*.whl
