+        # NumPy <= 1.8 raises a ValueError instead of an IndexError.
         try:
             self.size_in = np.arange(self.obj.size_in)[key].size
         except (IndexError, ValueError):
             self.size_in = None
         try:
             self.size_out = np.arange(self.obj.size_out)[key].size
-        except IndexError:
+        except (IndexError, ValueError):
             self.size_out = None
