+                "execution of three right-hand movements."
+            ),
+            investigators=[
+                "Enrico Mattei",
+                "Daniele Lozzi",
+                "Alessandro Di Matteo",
+                "Alessia Cipriani",
+                "Costanzo Manes",
+                "Giuseppe Placidi",
+            ],
