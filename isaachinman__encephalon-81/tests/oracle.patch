+) => {
+  if (error.code === 'REPOSITORY_CHANGED' && error.details.canonicalCommitted === true) {
+    return new EncephalonError(
+      error.code,
+      error.message,
+      {
+        ...error.details,
+        committedRecordIds: committedRecordIds(records),
+      },
+      { cause: error.cause },
+    )
+  }
