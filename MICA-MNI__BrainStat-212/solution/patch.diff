+            "surfaces": ("fsaverage5", "fsaverage6", "fsaverage", "fslr32k"),
+        },
+        "cammoun": {
+            "n_regions": [33, 60, 125, 250, 500],
+            "surfaces": ("fsaverage5", "fsaverage6", "fsaverage", "fslr32k"),
+        },
+    }
