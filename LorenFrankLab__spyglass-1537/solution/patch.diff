+    def _patched_diff(self, spike_v0, auto_curation_key, new_labels):
+        return {
+            "auto_curation_key": auto_curation_key,
+            "curation_key": {
+                k: auto_curation_key[k]
+                for k in spike_v0.Curation.primary_key
+                if k in auto_curation_key
+            },
+            "old_labels": {0: []},
