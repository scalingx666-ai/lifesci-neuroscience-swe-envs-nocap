 """Functions for supporting statistics."""
+
+import numpy as np
+
+
+def _chk2_asarray(a, b, axis):
+    # Removed from scipy in https://github.com/scipy/scipy/pull/23088
+    if axis is None:
+        a = np.ravel(a)
+        b = np.ravel(b)
+        outaxis = 0
+    else:
+        a = np.asarray(a)
+        b = np.asarray(b)
+        outaxis = axis
+
+    if a.ndim == 0:
+        a = np.atleast_1d(a)
+    if b.ndim == 0:
+        b = np.atleast_1d(b)
+
+    return a, b, outaxis
