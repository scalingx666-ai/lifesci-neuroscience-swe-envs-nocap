+        match="Reconstruction of bounding box datasets",
+    ):
+        napari_layers_to_ds(
+            points_as_napari=np.empty((0, 3)),
+            properties={"individual": np.array([])},
+            properties_with_nans=pd.DataFrame(),
+        )
