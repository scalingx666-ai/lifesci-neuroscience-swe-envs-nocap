+def test_spm_hrf_errors():
+    t_vec = np.arange(0, 32)
+    # All 1s is fine
+    res = spm_hrf_compat(t_vec, 1, 1, 1, 1)
+    # 0 or negative raise error for other args
+    args = [0]
+    for i in range(4):
