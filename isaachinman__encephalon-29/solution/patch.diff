+        return {
+          paths: accumulator.seen.has(collisionKey) ? [...accumulator.paths, `encephalon/${name}`] : accumulator.paths,
+          seen: new Set([...accumulator.seen, collisionKey]),
+        }
+      },
+      { paths: [], seen: new Set<string>() },
