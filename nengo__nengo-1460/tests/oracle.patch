             raise ValidationError("Dimensions must be a positive integer", 'd')
 
diff --git a/nengo/tests/test_processes.py b/nengo/tests/test_processes.py
index 8efc21beea..cc44578ea5 100644
--- a/nengo/tests/test_processes.py
+++ b/nengo/tests/test_processes.py
@@ -21,7 +21,7 @@ def __init__(self, retval):
         self.retval = retval
         self.sample_calls = []
 
-    def sample(self, n, d, rng=np.random):
+    def sample(self, n, d=None, rng=np.random):
         self.sample_calls.append((n, d, rng))
         return np.ones((n, d)) * self.retval
 
