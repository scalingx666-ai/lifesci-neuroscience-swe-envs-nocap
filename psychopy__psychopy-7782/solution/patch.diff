+    soundVideo = mediaDir / 'sound.mp4'
+    _runFFMPEG(
+        ['-f', 'lavfi', '-i', videoSource, '-f', 'lavfi', '-i', audioSource,
+         '-c:v', 'mpeg4', '-pix_fmt', 'yuv420p', '-c:a', 'aac', '-shortest',
