+        if (!this.settingsModal) {
+            let settingsModal = bis_webutil.createmodal('CPM Settings', 'modal-sm');
+            let settingsObj = Object.assign({}, this.settings);
+
+            let listObj = {
+                'kfold' : ['3', '4', '5', '6', '8', '10'],
