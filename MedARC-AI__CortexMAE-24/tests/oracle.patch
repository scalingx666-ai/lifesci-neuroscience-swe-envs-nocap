+    "plt.rcParams[\"figure.dpi\"] = 100"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "## Load Data\n",
+    "\n",
+    "Download and load the first shard from HCP-flat-wds dataset.\n",
+    "\n",
+    "⚠️ You'll need to accept the HCP data use agreement to get gated access to the dataset. You may also need to authenticate with `huggingface-cli login` or run:\n",
+    "\n",
+    "```python\n",
+    "from huggingface_hub import login\n",
+    "login()\n",
+    "```"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 4,
+   "metadata": {},
+   "outputs": [
+    {
+     "name": "stdout",
+     "output_type": "stream",
+     "text": [
+      "Loaded 4 samples\n",
+      "Sample shape: torch.Size([1, 16, 224, 560])\n",
+      "Mask shape: torch.Size([224, 560])\n"
+     ]
+    }
+   ],
+   "source": [
+    "# Download first shard\n",
+    "url = hf_hub_download(\"medarc/hcp-flat-wds\", \"hcp-flat_0000.tar\", repo_type=\"dataset\")\n",
+    "\n",
+    "# Create dataset\n",
+    "dataset = make_flat_wds_dataset(url, clipping=\"sequential\", shuffle=False)\n",
+    "transform = make_flat_transform(normalize=\"frame\")\n",
+    "dataset = dataset.map(transform)\n",
+    "\n",
+    "# Load 4 samples for visualization\n",
+    "samples = []\n",
+    "for i, sample in enumerate(dataset):\n",
+    "    if i >= 4:\n",
+    "        break\n",
+    "    samples.append(sample)\n",
+    "\n",
+    "print(f\"Loaded {len(samples)} samples\")\n",
+    "print(f\"Sample shape: {samples[0]['image'].shape}\")  # [C, T, H, W]\n",
+    "print(f\"Mask shape: {samples[0]['img_mask'].shape}\")  # [H, W]"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "## Define Augmentation Functions"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 29,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "class RandomCropAugmentation:\n",
+    "    \"\"\"Random crop augmentation for fMRI flat maps.\"\"\"\n",
+    "    def __init__(self, scale, ratio, size=(224, 560)):\n",
+    "        self.transform = v2.RandomResizedCrop(\n",
+    "            size=size,\n",
+    "            scale=scale,\n",
+    "            ratio=ratio,\n",
+    "            interpolation=v2.InterpolationMode.BICUBIC,\n",
+    "            antialias=True\n",
+    "        )\n",
+    "    \n",
+    "    def __call__(self, img, mask):\n",
+    "        \"\"\"\n",
+    "        Args:\n",
+    "            img: [C, T, H, W] tensor\n",
+    "            mask: [H, W] tensor\n",
+    "        Returns:\n",
+    "            img_aug: [C, T, H, W] augmented image\n",
+    "            mask_aug: [H, W] augmented mask\n",
+    "        \"\"\"\n",
+    "        C, T, H, W = img.shape\n",
+    "        \n",
+    "        # Combine image and mask for consistent cropping\n",
+    "        # Reshape to [C*T, H, W] for processing\n",
+    "        img_flat = img.reshape(C * T, H, W)\n",
+    "        mask_expanded = mask.unsqueeze(0)  # [1, H, W]\n",
+    "        \n",
+    "        # Stack for joint transformation\n",
+    "        combined = torch.cat([img_flat, mask_expanded], dim=0)  # [C*T+1, H, W]\n",
+    "        \n",
+    "        # Apply transformation\n",
+    "        combined_aug = self.transform(combined)\n",
+    "        \n",
+    "        # Split back\n",
+    "        img_aug = combined_aug[:C*T].reshape(C, T, H, W)\n",
+    "        mask_aug = combined_aug[-1]  # [H, W]\n",
+    "        \n",
+    "        return img_aug, mask_aug\n",
+    "\n",
+    "\n",
+    "class ColorJitterAugmentation:\n",
+    "    \"\"\"Color jitter for single-channel fMRI data (brightness/contrast only).\"\"\"\n",
+    "    def __init__(self, brightness=0.2, contrast=0.2):\n",
+    "        self.brightness = brightness\n",
+    "        self.contrast = contrast\n",
+    "    \n",
+    "    def __call__(self, img, mask):\n",
+    "        \"\"\"\n",
+    "        Args:\n",
+    "            img: [C, T, H, W] tensor\n",
+    "            mask: [H, W] tensor\n",
+    "        Returns:\n",
+    "            img_aug: [C, T, H, W] augmented image\n",
+    "            mask: [H, W] unchanged mask\n",
+    "        \"\"\"\n",
+    "        # Sample random factors\n",
+    "        brightness_factor = torch.empty(1).uniform_(1 - self.brightness, 1 + self.brightness).item()\n",
+    "        contrast_factor = torch.empty(1).uniform_(1 - self.contrast, 1 + self.contrast).item()\n",
+    "        \n",
+    "        # Apply brightness: img * factor\n",
+    "        img_aug = img * brightness_factor\n",
+    "        \n",
+    "        # Apply contrast: (img - mean) * factor + mean\n",
+    "        mean = img_aug.mean()\n",
+    "        img_aug = (img_aug - mean) * contrast_factor + mean\n",
+    "        \n",
+    "        return img_aug, mask\n",
+    "\n",
+    "\n",
+    "class GaussianNoiseAugmentation:\n",
+    "    \"\"\"Additive Gaussian noise augmentation.\"\"\"\n",
+    "    def __init__(self, std=1.0):\n",
+    "        self.std = std\n",
+    "    \n",
+    "    def __call__(self, img, mask):\n",
+    "        \"\"\"\n",
+    "        Args:\n",
+    "            img: [C, T, H, W] tensor\n",
+    "            mask: [H, W] tensor\n",
+    "        Returns:\n",
+    "            img_aug: [C, T, H, W] augmented image\n",
+    "            mask: [H, W] unchanged mask\n",
+    "        \"\"\"\n",
+    "        noise = torch.randn_like(img) * self.std\n",
+    "        img_aug = img + noise\n",
+    "        \n",
+    "        return img_aug, mask\n",
+    "\n",
+    "\n",
+    "# Define augmentations\n",
+    "augmentations = {\n",
+    "    \"Original\": None,\n",
+    "    \"Random Crop (Weak)\": RandomCropAugmentation(\n",
+    "        scale=[0.8, 1.0],\n",
+    "        ratio=[2.5, 2.5]\n",
+    "    ),\n",
+    "    \"Random Crop (Moderate)\": RandomCropAugmentation(\n",
+    "        scale=[0.25, 1.0],\n",
+    "        ratio=[2.0, 3.125]\n",
+    "    ),\n",
+    "    \"Color Jitter\": ColorJitterAugmentation(\n",
+    "        brightness=0.4,\n",
+    "        contrast=0.4\n",
+    "    ),\n",
+    "    \"Gaussian Noise\": GaussianNoiseAugmentation(std=1.0)\n",
+    "}"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "metadata": {},
+   "source": [
+    "## Visualization Helper Function"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 30,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def plot_augmentation_grid(samples, augmentation_fn, aug_name, num_samples=4, num_augs=4, frame_idx=0):\n",
+    "    \"\"\"\n",
+    "    Plot a grid showing original and augmented versions of data samples.\n",
+    "    \n",
+    "    Args:\n",
+    "        samples: list of data samples (each with 'image' and 'img_mask')\n",
+    "        augmentation_fn: augmentation function or None for original\n",
+    "        aug_name: name of the augmentation for the title\n",
+    "        num_samples: number of data samples to show (rows)\n",
+    "        num_augs: number of augmentation samples to generate\n",
+    "        frame_idx: which temporal frame to display\n",
+    "    \"\"\"\n",
+    "    num_cols = num_augs + 1  # original + augmentations\n",
+    "    \n",
+    "    # Calculate figure size based on aspect ratio\n",
+    "    H, W = 224, 560\n",
+    "    ploth = 2.0\n",
+    "    plotw = (W / H) * ploth\n",
+    "    \n",
+    "    fig, axs = plt.subplots(\n",
+    "        num_samples, \n",
+    "        num_cols, \n",
+    "        figsize=(num_cols * plotw, num_samples * ploth),\n",
+    "        squeeze=False\n",
+    "    )\n",
+    "    \n",
+    "    for i in range(num_samples):\n",
+    "        img = samples[i]['image']  # [C, T, H, W]\n",
+    "        mask = samples[i]['img_mask']  # [H, W]\n",
+    "        \n",
+    "        # Column 0: Original\n",
+    "        ax = axs[i, 0]\n",
+    "        plt.sca(ax)\n",
+    "        frame = img[0, frame_idx].cpu().numpy()  # [H, W]\n",
+    "        mask_np = mask.cpu().numpy()\n",
+    "        masked_frame = np.where(mask_np > 0, frame, np.nan)\n",
+    "        plt.imshow(masked_frame, vmin=-3, vmax=3, cmap=FC_CMAP, interpolation='none')\n",
+    "        plt.axis('off')\n",
+    "        if i == 0:\n",
+    "            plt.title('Original', fontsize=12, fontweight='bold')\n",
+    "        \n",
+    "        # Columns 1-4: Augmented versions\n",
+    "        for j in range(num_augs):\n",
+    "            ax = axs[i, j + 1]\n",
+    "            plt.sca(ax)\n",
+    "            \n",
+    "            if augmentation_fn is None:\n",
+    "                # For \"Original\" augmentation, just show the same image\n",
+    "                aug_img, aug_mask = img, mask\n",
+    "            else:\n",
+    "                # Apply augmentation\n",
+    "                aug_img, aug_mask = augmentation_fn(img.clone(), mask.clone())\n",
+    "            \n",
+    "            aug_frame = aug_img[0, frame_idx].cpu().numpy()  # [H, W]\n",
+    "            aug_mask_np = aug_mask.cpu().numpy()\n",
+    "            masked_aug_frame = np.where(aug_mask_np > 0, aug_frame, np.nan)\n",
+    "            plt.imshow(masked_aug_frame, vmin=-3, vmax=3, cmap=FC_CMAP, interpolation='none')\n",
+    "            plt.axis('off')\n",
+    "            if i == 0:\n",
+    "                plt.title(f'Aug {j+1}', fontsize=12, fontweight='bold')\n",
+    "    \n",
+    "    plt.suptitle(f'{aug_name}', fontsize=16, fontweight='bold', y=0.995)\n",
+    "    plt.tight_layout(rect=[0, 0, 1, 0.99])\n",
+    "    plt.show()\n",
+    "    \n",
+    "    return fig"
+   ]
+  },
