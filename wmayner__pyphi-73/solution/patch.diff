+            "__and__", "__iand__", "__rand__",
+            "__lshift__", "__ilshift__", "__irshift__",
+            "__rlshift__", "__rrshift__", "__rshift__",
+            "__ior__", "__or__", "__ror__",
+            "__xor__", "__ixor__", "__rxor__",
+            "__eq__", "__ne__",
+            "__ge__", "__gt__", "__lt__", "__le__",
+            "__deepcopy__",
+            # 3-ary
