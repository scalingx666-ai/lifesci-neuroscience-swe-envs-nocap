-                                                           unsigned int                iend)
-{
-  double w = 0.0;
-
-  // initialize partial parameters to zero
-  for (unsigned int k = istart; k <= iend; k++)
-  {
-    average_parameters[k] = 0.0;
-  }
-
-  typename InternalTransformListType::iterator it = transform_list.begin();
-  unsigned int                                 cnt = 0;
-  for (; it != transform_list.end(); it++)
-  {
