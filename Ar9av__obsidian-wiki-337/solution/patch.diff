+def test_questions_match_loosely() -> None:
+    cases = ae.load_gold(GOLD)
+    answers = {ae._question_key("Which API gateway do we run today"): "Envoy [[gateway-envoy]]"}
+    assert ae.score_run(cases, answers)["results"][0]["passed"] is True
