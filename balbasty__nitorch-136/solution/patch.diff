+    nfull = nchunk * chunk
+    fbatch: List[int] = f.shape[:-2]
+    zbatch: List[int] = z.shape[:-2]
+    nf, nk = f.shape[-1], z.shape[-1]
+    s = torch.matmul(
+        f[..., :nfull, :].reshape(fbatch + [nchunk, chunk, nf]).transpose(-1, -2),
