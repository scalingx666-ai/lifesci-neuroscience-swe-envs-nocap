+        Unlike `bool`, raise a `ValueError` if the input is not a bool."""
+        if x.lower() in ('t', 'true', 'y', 'yes'):
+            return True
+        if x.lower() in ('f', 'false', 'n', 'no'):
+            return False
+        return bool(int(x))
