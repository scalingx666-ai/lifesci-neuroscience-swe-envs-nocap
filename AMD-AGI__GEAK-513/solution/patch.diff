diff --git a/e2e_workflow/scripts/adapters/split_args.py b/e2e_workflow/scripts/adapters/split_args.py
new file mode 100644
index 000000000..57e56a1d5
--- /dev/null
+++ b/e2e_workflow/scripts/adapters/split_args.py
@@ -0,0 +1,101 @@
+#!/usr/bin/env python3
+"""Split a server-argument string into argv, NUL-delimited on stdout.
+
+Adapters used to expand ``$EXTRA_SERVER_ARGS`` unquoted. Word splitting keeps
+shell quotes as literal characters and pathname-expands ``*`` / ``[...]``, so a
+JSON value -- which GEAK renders shell-quoted (``--online_quant_config
+'{"exclude_layer":["*.mlp.gate"]}'``) -- reached the server with its quotes
+still attached, or rewritten by a glob that happened to match. This applies the
+shell's quoting rules without evaluating anything, and keeps a bare JSON value
+(``--x {"a": 1}``, the spelling recipes and hand-written launchers use) as one
+token instead of letting shlex strip its double quotes.
+
+Usage: split_args.py "<args>"  -> each token followed by NUL. Exit 2 on input
+that does not split (unbalanced quotes); the caller falls back loudly.
+"""
+
+import json
+import secrets
+import shlex
+import sys
+
+
+def _protect_bare_json(text):
+    """Swap balanced bare JSON values for markers so shlex leaves them whole.
+
+    The markers carry a nonce that does not occur in ``text``, so restoring them
+    can never rewrite a user-supplied token that happens to look like one.
+    """
+    nonce = secrets.token_hex(8)
+    while nonce in text:
+        nonce = secrets.token_hex(8)
+    protected = {}
+    out = []
+    i = 0
+    while i < len(text):
+        char = text[i]
+        if char not in "[{" or (i and not (text[i - 1].isspace() or text[i - 1] == "=")):
+            out.append(char)
+            i += 1
+            continue
+        closing = "}" if char == "{" else "]"
+        depth, quoted, escaped, end = 0, False, False, i
+        while end < len(text):
+            current = text[end]
+            if quoted:
+                if escaped:
+                    escaped = False
+                elif current == "\\":
+                    escaped = True
+                elif current == '"':
+                    quoted = False
+            elif current == '"':
+                quoted = True
+            elif current == char:
+                depth += 1
+            elif current == closing:
+                depth -= 1
+                if depth == 0:
+                    end += 1
+                    break
+            end += 1
+        candidate = text[i:end]
+        try:
+            if depth:
+                raise ValueError
+            json.loads(candidate)
+        except ValueError:
+            out.append(char)
+            i += 1
+            continue
+        marker = f"__GEAK_JSON_{nonce}_{len(protected)}__"
+        protected[marker] = candidate
+        out.append(marker)
+        i = end
+    return "".join(out), protected
+
+
+def split_args(text):
+    """Return the argv a shell would build from ``text``, bare JSON kept intact."""
+    protected_text, protected = _protect_bare_json(text.strip())
+    tokens = shlex.split(protected_text, posix=True)
+    for marker, value in protected.items():
+        tokens = [token.replace(marker, value) for token in tokens]
+    return tokens
+
+
+def main(argv):
+    if len(argv) != 2:
+        print("usage: split_args.py '<args>'", file=sys.stderr)
+        return 2
+    try:
+        tokens = split_args(argv[1])
+    except ValueError as exc:
+        print(f"split_args: cannot split server args: {exc}", file=sys.stderr)
+        return 2
+    sys.stdout.write("".join(token + "\0" for token in tokens))
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/e2e_workflow/scripts/server_teardown.sh b/e2e_workflow/scripts/server_teardown.sh
index bdc49f331..fc2b5fc0a 100644
--- a/e2e_workflow/scripts/server_teardown.sh
+++ b/e2e_workflow/scripts/server_teardown.sh
@@ -167,7 +167,7 @@ _server_descendants() {
     }'
 }
 
-server_teardown() {
+_server_teardown_launched() {
   [ -n "${SERVER_PID:-}" ] || return 0
   # A server we launched can never BE init, and a non-numeric pid means a pid file /
   # launcher handed us garbage. Refuse before any signal, so the pid-only fallback
@@ -243,3 +243,61 @@ server_teardown() {
   fi
   wait "$SERVER_PID" 2>/dev/null || true
 }
+
+# A Magpie-launched ATOM server leads its OWN process group (the recipe setsid's it),
+# while SERVER_PID above is GEAK's supervisor in a different group. Reaping that group
+# was the supervisor's TERM trap alone -- a trap that never installs when TERM arrives
+# ignored, and never runs when the supervisor is SIGKILLed -- leaving rank workers
+# holding every GPU. So teardown reaps it directly, on every exit path of the above.
+#
+# Only LIVE members count. In a container whose PID 1 never reaps (`sleep infinity`),
+# an exited ATOM leaves zombies in the group: they hold no GPU and ignore signals, and
+# `kill -0` still succeeds on them, so counting them would report a leak that is not
+# there and wait out the whole grace.
+#
+# Identity: the kernel never hands out a pid number while a process group of that id
+# still has members, so a group named MAGPIE_INNER_SERVER_PID with live members is the
+# one this launch created, even after its leader exited. A process that now holds that
+# pid with a different start time means the group emptied and the pid was reused:
+# refuse rather than signal a stranger.
+_live_group_members() {  # _live_group_members PGID -> pids of its non-zombie members
+  ps -eo pid=,pgid=,stat= 2>/dev/null | awk -v g="$1" '$2==g && $3 !~ /^Z/ {print $1}'
+}
+
+_reap_magpie_inner_group() {
+  local _g="${MAGPIE_INNER_SERVER_PID:-}" _ticks="${MAGPIE_INNER_SERVER_START_TICKS:-}"
+  local _p _now _members _i _grace="${SERVER_STOP_GRACE_S:-10}"
+  unset MAGPIE_INNER_SERVER_PID MAGPIE_INNER_SERVER_START_TICKS
+  case "$_g" in ''|*[!0-9]*) return 0 ;; esac
+  [ "$_g" -gt 1 ] || return 0
+  case "$_grace" in ''|*[!0-9]*) _grace=10 ;; esac
+  for _p in $SERVER_PROTECTED_PGIDS; do
+    [ "$_g" = "$_p" ] && { echo "!!! magpie inner group $_g is protected; not signalled." >&2; return 0; }
+  done
+  _members="$(_live_group_members "$_g")"
+  [ -n "$_members" ] || return 0
+  _now="$(_start_ticks_of "$_g" 2>/dev/null || true)"
+  if [ -n "$_ticks" ] && [ -n "$_now" ] && [ "$_now" != "$_ticks" ]; then
+    echo "!!! magpie inner pid $_g start_time changed (was $_ticks, now $_now): the pid was" \
+         "REUSED; group not signalled." >&2
+    return 0
+  fi
+  for _p in $_members; do
+    if [ "$_p" = "1" ] || [ "$_p" = "$BENCH_PID" ]; then
+      echo "!!! magpie inner group $_g contains pid $_p; not signalled." >&2
+      return 0
+    fi
+  done
+  echo ">>> Reaping Magpie inner server group pgid=$_g ($(echo $_members | wc -w) live member(s)) ..."
+  kill -TERM "-$_g" 2>/dev/null || true
+  for _i in $(seq 1 "$_grace"); do
+    [ -n "$(_live_group_members "$_g")" ] || return 0
+    sleep 1
+  done
+  kill -KILL "-$_g" 2>/dev/null || true
+}
+
+server_teardown() {
+  _server_teardown_launched
+  _reap_magpie_inner_group
+}
diff --git a/e2e_workflow/scripts/tests/test_atom_server_argv.py b/e2e_workflow/scripts/tests/test_atom_server_argv.py
new file mode 100644
index 000000000..eef2db462
--- /dev/null
+++ b/e2e_workflow/scripts/tests/test_atom_server_argv.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""GPU-free tests for how the native ATOM adapter turns EXTRA_SERVER_ARGS into server argv.
+
+The adapter used to expand $EXTRA_SERVER_ARGS unquoted: shell quotes stayed on JSON values and
+`*`/`[..]` inside them were pathname-expanded. These pin the argv the server actually receives.
+"""
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+SCRIPTS_DIR = Path(__file__).resolve().parents[1]
+ATOM_ADAPTER = SCRIPTS_DIR / "adapters" / "atom.sh"
+SPLIT_ARGS = SCRIPTS_DIR / "adapters" / "split_args.py"
+BASH = shutil.which("bash")
+
+QUANT = {"exclude_layer": ["lm_head", "*.mlp.gate", "model.layers.[0-9].mlp.*expert*"],
+         "global_quant_config": "ptpc_fp8"}
+
+
+@unittest.skipIf(BASH is None, "bash is required")
+class AtomServerArgvTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix="atom_argv_"))
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        # Files a glob in the quant config would match if the shell expanded it.
+        (self.tmp / "x.mlp.gate").write_text("")
+        (self.tmp / "model.layers.3.mlp.fooexpertbar").write_text("")
+
+    def _run(self, args: str, adapter_dir: Path = ATOM_ADAPTER.parent) -> subprocess.CompletedProcess:
+        driver = (
+            f'source "{adapter_dir / "atom.sh"}"\n'
+            '_atom_server_argv "$ARGS" || exit $?\n'
+            'echo "count=${#_ATOM_EXTRA_ARGV[@]}" >&2\n'
+            '[ "${#_ATOM_EXTRA_ARGV[@]}" -eq 0 ] || printf "%s\\0" "${_ATOM_EXTRA_ARGV[@]}"\n'
+        )
+        return subprocess.run([BASH, "-c", driver], env={**os.environ, "ARGS": args},
+                              cwd=self.tmp, capture_output=True, timeout=30)
+
+    def _argv(self, args: str, adapter_dir: Path = ATOM_ADAPTER.parent) -> tuple[list[str], str]:
+        proc = self._run(args, adapter_dir)
+        self.assertEqual(proc.returncode, 0, proc.stderr.decode())
+        return proc.stdout.decode().split("\0")[:-1], proc.stderr.decode()
+
+    def test_shell_quoted_json_reaches_the_server_unquoted_and_unglobbed(self):
+        args = ("--block-size 64 --online_quant_config "
+                + "'" + json.dumps(QUANT, separators=(",", ":")) + "'"
+                + " --cudagraph-capture-sizes '[1,2,4,8]' --method mtp")
+        argv, _ = self._argv(args)
+        self.assertEqual(argv[:2], ["--block-size", "64"])
+        self.assertEqual(json.loads(argv[argv.index("--online_quant_config") + 1]), QUANT)
+        self.assertEqual(argv[argv.index("--cudagraph-capture-sizes") + 1], "[1,2,4,8]")
+        self.assertEqual(argv[-2:], ["--method", "mtp"])
+
+    def test_bare_json_with_spaces_stays_one_token(self):
+        argv, _ = self._argv('--speculative-config {"method": "mtp", "n": 5} --x 1')
+        self.assertEqual(argv, ["--speculative-config", '{"method": "mtp", "n": 5}', "--x", "1"])
+
+    def test_empty_args_give_empty_argv(self):
+        argv, _ = self._argv("")
+        self.assertEqual(argv, [])
+
+    def test_missing_helper_refuses_to_launch(self):
+        staged = self.tmp / "staged"
+        staged.mkdir()
+        shutil.copy(ATOM_ADAPTER, staged / "atom.sh")  # helper deliberately not staged
+        proc = self._run("--a *.mlp.gate --b 1", adapter_dir=staged)
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("refusing to launch", proc.stderr.decode())
+
+    def test_args_that_do_not_split_refuse_to_launch(self):
+        """No word-splitting fallback: `--name 'two words` would start as <--name> <'two> <words>."""
+        proc = self._run("--name 'two words")
+        self.assertEqual(proc.returncode, 2)
+        self.assertIn("refusing to launch", proc.stderr.decode())
+
+    def test_a_token_shaped_like_a_json_marker_is_left_alone(self):
+        argv, _ = self._argv('--label __GEAK_JSON_0__ --q {"a":1}')
+        self.assertEqual(argv, ["--label", "__GEAK_JSON_0__", "--q", '{"a":1}'])
+
+    def test_unbalanced_quote_is_rejected_by_the_helper(self):
+        proc = subprocess.run([sys.executable, str(SPLIT_ARGS), "--a 'oops"], capture_output=True)
+        self.assertEqual(proc.returncode, 2)
+        self.assertEqual(proc.stdout, b"")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/e2e_workflow/scripts/tests/test_magpie_inner_reap.py b/e2e_workflow/scripts/tests/test_magpie_inner_reap.py
new file mode 100644
index 000000000..0e5ab6f12
--- /dev/null
+++ b/e2e_workflow/scripts/tests/test_magpie_inner_reap.py
@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Real-process test: teardown reaps a Magpie-launched ATOM group without the supervisor.
+
+Under the Magpie launcher the ATOM server leads its own process group and SERVER_PID is
+GEAK's supervisor in another group, so teardown's group kill never reaches ATOM. Reaping it
+used to depend on the supervisor's TERM trap, which bash cannot install when TERM arrives
+already ignored -- reproduced here -- and which never runs when the supervisor is SIGKILLed.
+"""
+import os
+import re
+import shutil
+import signal
+import subprocess
+import tempfile
+import time
+import unittest
+
+SCRIPTS_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+LIB = os.path.join(SCRIPTS_DIR, "server_teardown.sh")
+MAGPIE = os.path.join(SCRIPTS_DIR, "adapters", "launchers", "magpie.sh")
+BASH = shutil.which("bash")
+SETSID = shutil.which("setsid")
+
+
+def _group_members(pgid: int) -> list[int]:
+    """Live members only: a zombie holds nothing and stays listed where PID 1 never reaps."""
+    out = subprocess.run(["ps", "-eo", "pid=,pgid=,stat="], capture_output=True, text=True).stdout
+    return [int(p) for p, g, st in (line.split() for line in out.splitlines())
+            if int(g) == pgid and not st.startswith("Z")]
+
+
+@unittest.skipIf(BASH is None or SETSID is None, "bash and setsid are required")
+class MagpieInnerGroupReapTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp(prefix="magpie_reap_")
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        # The "ATOM server": a leader that exits on TERM plus a rank worker that ignores it.
+        self.atom = subprocess.Popen(
+            [BASH, "-c", '(trap "" TERM; exec sleep 300) & exec sleep 300'],
+            start_new_session=True,
+        )
+        self.addCleanup(self._kill_group, self.atom.pid)
+        time.sleep(0.3)
+        self.assertEqual(len(_group_members(self.atom.pid)), 2)
+        supervisor = re.search(r"_MAGPIE_ATOM_SUPERVISOR='(.*?)\n'\n", open(MAGPIE).read(), re.S).group(1)
+        # The supervisor, started the way magpie.sh does -- but with TERM inherited ignored.
+        self.supervisor = subprocess.Popen(
+            [SETSID, BASH, "-c", supervisor, "atom-magpie-supervisor", str(self.atom.pid), str(self.atom.pid), "1"],
