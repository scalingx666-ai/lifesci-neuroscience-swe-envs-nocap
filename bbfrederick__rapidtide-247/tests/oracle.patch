+            LGR.warning(f"{msg}. Falling back to CPU implementation.")
+            return correlationpass_cpu(
+                fmridata,
+                referencetc,
+                theCorrelator,
+                fmri_x,
+                os_fmri_x,
+                lagmininpts,
+                lagmaxinpts,
+                corrout,
+                meanval,
+                nprocs=nprocs,
+                alwaysmultiproc=alwaysmultiproc,
+                oversampfactor=oversampfactor,
+                interptype=interptype,
+                showprogressbar=showprogressbar,
+                chunksize=chunksize,
