+                     ['E', '+', 'A', 'C', 'E'],
+                     ['B', '+', 'D', 'E', 'B'],
+                     ['C', '+', 'F', 'B', 'C']]
+
+        expected = {'A': 1, 'B': 3, 'C': 1, 'D': 1, 'E': 2, 'F': 2}
+        counts = inquiry_nontarget_counts(inquiries, symbols=symbols)
+        self.assertDictEqual(counts, expected)
